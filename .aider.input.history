+**File: `trikeshed-core/src/linuxMain/kotlin/borg/trikeshed/reactor/ActualLinuxAsyncIoEngine.kt` (New File)**
+```kotlin
+package borg.trikeshed.reactor
+
+import kotlinx.cinterop.*
+import platform.posix.*
+import zlinux_uring.* // Assuming this brings in io_uring specific bindings from your .def file
+import linux_uring.include.* // For your existing helpers and enums
+import borg.trikeshed.lib.ByteBuffer
+import borg.trikeshed.io.network.NetworkAddress
+import borg.trikeshed.nio.NativeArrayByteBuffer // Assuming your ByteBuffer actual
+import kotlin.coroutines.CoroutineContext
+
+@OptIn(ExperimentalForeignApi::class)
+actual class AsyncIoEngine actual constructor() : CoroutineContext.Element {
+    actual companion object Key : CoroutineContext.Key<AsyncIoEngine>
+    override val key: CoroutineContext.Key<*> get() = Key
+
+    private val ring: io_uring = nativeHeap.alloc()
+    private val ringInitialized: Boolean
+
+    // Mapped memory pointers for SQ, CQ, SQEs
+    private var sqPtr: CPointer<io_uring_sq>? = null
+    private var cqPtr: CPointer<io_uring_cq>? = null
+    private var sqesPtr: CPointer<io_uring_sqe>? = null
+
+    // Ring buffer details (head, tail pointers, masks)
+    private var sq_head_ptr: CPointer<UIntVar>? = null
+    private var sq_tail_ptr: CPointer<UIntVar>? = null
+    private var sq_ring_mask: UInt = 0U
+    // ... and similar for CQ ...
+    private var cq_head_ptr: CPointer<UIntVar>? = null
+
+
+    // Store OperationHandle to user_data mappings
+    private val activeOperations = mutableMapOf<ULong, Pair<AsyncOperationHandle, Any?>>()
+    private var nextUserData = 0UL
+
+
+    init {
+        memScoped {
+            val params = alloc<io_uring_params>()
+            // Optionally set flags in params.flags, e.g., UringSetupFlags.uringSetupIopoll.src
+            // params.flags = UringSetupFlags.uringSetupSqpoll.src or UringSetupFlags.uringSetupSq_aff.src // Example
+
+            val ret = io_uring_queue_init_params(CATQUEUE_DEPTH_ACTUAL, ring.ptr, params.ptr)
+            if (ret < 0) {
+                nativeHeap.free(ring.rawPtr)
+                throw RuntimeException("io_uring_queue_init_params failed: ${strerror(-ret)?.toKString()}")
+            }
+            ringInitialized = true
+
+            // Map the rings (simplified, adapt from your KioUring example)
+            val p = params.pointed
+            val sring_sz = p.sq_off.array + p.sq_entries * sizeOf<UIntVar>().toUInt()
+            sqPtr = mmap(null, sring_sz.convert(), PROT_READ or PROT_WRITE, MAP_SHARED or MAP_POPULATE, ring.ring_fd, IORING_OFF_SQ_RING.toLong())
+                ?.reinterpret() ?: throw RuntimeException("mmap SQ ring failed")
+
+            sq_head_ptr = (sqPtr!!.rawValue.toLong() + p.sq_off.head.toLong()).toCPointer()
+            sq_tail_ptr = (sqPtr!!.rawValue.toLong() + p.sq_off.tail.toLong()).toCPointer()
+            sq_ring_mask = p.sq_off.ring_mask
+
+            // CQ ring
+            val cring_sz = p.cq_off.cqes + p.cq_entries * sizeOf<io_uring_cqe>().toUInt()
+            val singleMmap = (p.features and IORING_FEAT_SINGLE_MMAP.toUInt()) != 0u
+            cqPtr = if(singleMmap) sqPtr!!.reinterpret() // If single mmap, CQ is part of SQ mapping
+                     else mmap(null, cring_sz.convert(), PROT_READ or PROT_WRITE, MAP_SHARED or MAP_POPULATE, ring.ring_fd, IORING_OFF_CQ_RING.toLong())
+                        ?.reinterpret() ?: throw RuntimeException("mmap CQ ring failed")
+
+            cq_head_ptr = (cqPtr!!.rawValue.toLong() + p.cq_off.head.toLong()).toCPointer()
+
+            // SQEs array
+            sqesPtr = mmap(null, (p.sq_entries * sizeOf<io_uring_sqe>().toUInt()).convert(), PROT_READ or PROT_WRITE, MAP_SHARED or MAP_POPULATE, ring.ring_fd, IORING_OFF_SQES.toLong())
+                ?.reinterpret() ?: throw RuntimeException("mmap SQEs failed")
+        }
+    }
+
+    private fun get_sqe(): CPointer<io_uring_sqe>? {
+        val sqe = io_uring_get_sqe(ring.ptr)
+        // If sqe is null, SQ is full. Need to submit and potentially wait.
+        // For simplicity now, assume SQ always has space or user handles full queue externally.
+        // A robust version would call io_uring_submit() if sqe is null and retry, or handle full queue.
+        return sqe
+    }
+
+    private fun submit(): Int {
+        return io_uring_submit(ring.ptr)
+    }
+
+    actual override fun registerDescriptor(fd: Int) {
+        // For io_uring, FDs can be registered for more efficient access with IOSQE_FIXED_FILE.
+        // This function could call io_uring_register(ring.ptr, IORING_REGISTER_FILES, &fd, 1).
+        // For now, direct FD use is simpler and common.
+        println("Native AsyncIoEngine: registerDescriptor($fd) - No-op in this basic version, direct FD used.")
+    }
+
+    actual override fun unregisterDescriptor(fd: Int) {
+        println("Native AsyncIoEngine: unregisterDescriptor($fd) - No-op in this basic version.")
+    }
+
+    actual override fun submitRead(fd: Int, buffer: ByteBuffer, fileOffset: Long, attachment: Any?): AsyncOperationHandle {
+        val sqe = get_sqe() ?: throw IllegalStateException("io_uring submission queue full")
+        val handle = NativeAsyncOperationHandle(nextUserData++)
+        activeOperations[handle.id] = Pair(handle, attachment)
+
+        // Assuming buffer is NativeArrayByteBuffer or provides direct access
+        val nioBuffer = (buffer as NativeArrayByteBuffer).getInternalNativeArray()
+        val length = buffer.remaining().toUInt()
+
+        nioBuffer.usePinned { pinned ->
+            io_uring_prep_read(sqe, fd, pinned.addressOf(buffer.position()), length, fileOffset.convert())
+        }
+        io_uring_sqe_set_data(sqe, interpretCPointer<COpaquePointerVar>(handle.id.toLong())) // Pass handle ID as user_data
+
+        submit() // Consider batching submissions for performance
+        return handle
+    }
+
+    actual override fun submitWrite(fd: Int, buffer: ByteBuffer, fileOffset: Long, attachment: Any?): AsyncOperationHandle {
+        val sqe = get_sqe() ?: throw IllegalStateException("io_uring submission queue full")
+        val handle = NativeAsyncOperationHandle(nextUserData++)
+        activeOperations[handle.id] = Pair(handle, attachment)
+
+        val nioBuffer = (buffer as NativeArrayByteBuffer).getInternalNativeArray()
+        val length = buffer.remaining().toUInt()
+
+        nioBuffer.usePinned { pinned ->
+            io_uring_prep_write(sqe, fd, pinned.addressOf(buffer.position()), length, fileOffset.convert())
+        }
+        io_uring_sqe_set_data(sqe, interpretCPointer<COpaquePointerVar>(handle.id.toLong()))
+        submit()
+        return handle
+    }
+
+    actual override fun submitAccept(serverFd: Int, attachment: Any?): AsyncOperationHandle {
+        val sqe = get_sqe() ?: throw IllegalStateException("io_uring submission queue full")
+        val handle = NativeAsyncOperationHandle(nextUserData++)
+        activeOperations[handle.id] = Pair(handle, attachment)
+        memScoped {
+             val clientAddr = alloc<sockaddr_storage>()
+             val clientAddrLen = alloc<socklen_tVar>()
+             clientAddrLen.value = sizeOf<sockaddr_storage>().convert()
+             io_uring_prep_accept(sqe, serverFd, clientAddr.ptr.reinterpret(), clientAddrLen.ptr, 0)
+        }
+        io_uring_sqe_set_data(sqe, interpretCPointer<COpaquePointerVar>(handle.id.toLong()))
+        submit()
+        return handle
+    }
+
+    actual override fun submitConnect(clientFd: Int, remoteAddress: NetworkAddress, attachment: Any?): AsyncOperationHandle {
+        TODO("io_uring connect not implemented in this sketch")
+    }
+
+    actual override fun submitCancel(handleToCancel: AsyncOperationHandle, attachment: Any?): AsyncOperationHandle {
+        val sqe = get_sqe() ?: throw IllegalStateException("io_uring submission queue full")
+        val cancelHandle = NativeAsyncOperationHandle(nextUserData++)
+        activeOperations[cancelHandle.id] = Pair(cancelHandle, attachment)
+
+        val userDataToCancel = (handleToCancel as NativeAsyncOperationHandle).id
+        io_uring_prep_cancel(sqe, interpretCPointer<COpaquePointerVar>(userDataToCancel.toLong()), 0)
+        io_uring_sqe_set_data(sqe, interpretCPointer<COpaquePointerVar>(cancelHandle.id.toLong()))
+        submit()
+        return cancelHandle
+    }
+
+    actual override suspend fun pollCompletions(maxEvents: Int, timeoutMillis: Long): List<AsyncCompletionEvent> {
+        val completions = mutableListOf<AsyncCompletionEvent>()
+        memScoped {
+            val cqePtr = alloc<CPointerVar<io_uring_cqe>>() // For io_uring_wait_cqe or peek
+            val ts: CPointer<__kernel_timespec>? = if (timeoutMillis > 0) {
+                alloc<__kernel_timespec> {
+                    tv_sec = timeoutMillis / 1000
+                    tv_nsec = (timeoutMillis % 1000) * 1_000_000
+                }.ptr
+            } else null
+
+            // If timeoutMillis is 0, use io_uring_peek_cqe.
+            // If timeoutMillis is >0, use io_uring_wait_cqe_timeout.
+            // If timeoutMillis is -1, use io_uring_wait_cqe.
+            // Simplified: Use submit_and_wait for positive timeout or indefinite wait.
+            // Peek for non-blocking.
+            var toWaitCount = if (timeoutMillis == 0L) 0U else 1U // Wait for at least 1 if blocking/timeout
+                                                                   // For peek (timeout 0), just check current.
+
+            if (timeoutMillis != 0L) {
+                // This requires submitting any pending SQEs first. A more robust loop might call io_uring_submit first.
+                // For blocking call, wait for at least one event.
+                val ret = io_uring_submit_and_wait_timeout(ring.ptr, cqePtr.ptr, 1U /* wait_nr*/ , ts, null /* sigmask */)
+                if (ret < 0 && ret != -ETIME && ret != -EINTR) { // ETIME is timeout, EINTR is interrupt
+                     throw RuntimeException("io_uring_submit_and_wait_timeout failed: ${strerror(-ret)?.toKString()}")
+                }
+            }
+            
+            var cqe: CPointer<io_uring_cqe>?
+            var count = 0
+            while (count < maxEvents) {
+                 // Alternative loop for peeking:
+                 // var head = cq_head_ptr!!.pointed.value
+                 // if (head == io_uring_cq_tail(ring.ptr)) break // CQ is empty
+
+                val retPeek = io_uring_peek_cqe(ring.ptr, cqePtr.ptr)
+                if (retPeek < 0) { // No more events immediately available or error
+                    if(retPeek == -EAGAIN) break // Empty queue
+                    throw RuntimeException("io_uring_peek_cqe failed: ${strerror(-retPeek)?.toKString()}")
+                }
+                cqe = cqePtr.value ?: break // No CQE available (shouldn't happen if retPeek was 0)
+
+                val userData = cqe.pointed.user_data.toLong().toULong() // retrieve user_data (handle id)
+                val opInfo = activeOperations.remove(userData)
+                if (opInfo != null) {
+                    val (originalHandle, originalAttachment) = opInfo
+                    val result = cqe.pointed.res
+                    val error = if (result < 0) -result else null
+                    completions.add(AsyncCompletionEvent(originalHandle, originalAttachment, result, error))
+                } else {
+                    // Spurious completion or user_data mismatch
+                }
+                io_uring_cqe_seen(ring.ptr, cqe) // Mark as consumed
+                count++
+            }
+        }
+        return completions
+    }
+
+    actual override fun close() {
+        if (ringInitialized) {
+            // Unmap memory
+            if (sqPtr != null) {
+                munmap(sqPtr, (p.sq_off.array + p.sq_entries * sizeOf<UIntVar>().toUInt()).convert())
+            }
+            if (cqPtr != null && cqPtr != sqPtr) { // If not single mmap
+                 munmap(cqPtr, (p.cq_off.cqes + p.cq_entries * sizeOf<io_uring_cqe>().toUInt()).convert())
+            }
+            if (sqesPtr != null) {
+                munmap(sqesPtr, (p.sq_entries * sizeOf<io_uring_sqe>().toUInt()).convert())
+            }
+            io_uring_queue_exit(ring.ptr)
+            // No nativeHeap.free for `ring` as it was stack allocated in a block, or needs to be managed with init{}
+            // If `ring` was from nativeHeap.alloc() at class level, then nativeHeap.free(ring.rawPtr)
+            println("Native AsyncIoEngine (io_uring) closed.")
+        }
+    }
+}
+
+// Wrapper for ULong handle IDs
+@JvmInline
+actual value class NativeAsyncOperationHandle(val id: ULong) : AsyncOperationHandle
+
+// Needed by the above `init {}` block because `p` (io_uring_params) is defined there
+// Placeholder definition until the proper context is clarified.
+private val p = nativeHeap.alloc<io_uring_params>().pointed //This would normally be part of init
+private const val CATQUEUE_DEPTH_ACTUAL = 32U // Or your chosen depth
+```
+*Important Notes for `io_uring` implementation:*
+    *   Error handling using `strerror(errno)` for POSIX calls is crucial.
+    *   Memory management for buffers passed to `io_uring_prep_*` needs care. `usePinned` is good for temporary pinning. For long-lived registered buffers, you'd use `io_uring_register_buffers`.
+    *   The mapping of memory for SQ, CQ, and SQEs needs to be done correctly as shown (similar to your `KioUring` example).
+    *   This is a simplified sketch. A production-ready `io_uring` engine requires careful management of submission queue (SQ) full conditions, batching submissions, handling linked operations, and more advanced features like `IOSQE_IO_LINK`.
+    *   `submitCancel` implementation uses `io_uring_prep_cancel` which has specific kernel version requirements (5.5+).
+
+**B. macOS/BSD (`darwinMain` or `posixMain` with conditional logic - using `kqueue`)**
+
+**File: `trikeshed-core/src/nativeMain/kotlin/borg/trikeshed/reactor/ActualNativeKqueueAsyncIoEngine.kt` (New File, adjust target dir based on your KMP setup)**
+```kotlin
+package borg.trikeshed.reactor
+
+import kotlinx.cinterop.*
+import platform.posix.* // Provides kqueue, kevent, EV_SET, EVFILT_READ/WRITE etc.
+import borg.trikeshed.lib.ByteBuffer
+import borg.trikeshed.io.network.NetworkAddress
+import borg.trikeshed.nio.NativeArrayByteBuffer
+import kotlin.coroutines.CoroutineContext
+
+@OptIn(ExperimentalForeignApi::class)
+actual class AsyncIoEngine actual constructor() : CoroutineContext.Element {
+    actual companion object Key : CoroutineContext.Key<AsyncIoEngine>
+    override val key: CoroutineContext.Key<*> get() = Key
+
+    private val kq: Int = kqueue()
+    private val activeOps = mutableMapOf<AsyncOperationHandle, KeventOp>() // Store pending ops
+
+    private var nextId: ULong = 0UL
+    private fun newHandle() = NativeAsyncOperationHandle(nextId++)
+
+    private data class KeventOp(val handle: AsyncOperationHandle, val fd: Int, val filter: Short, val attachment: Any?, val buffer: ByteBuffer?, var fileOffset: Long = -1L)
+
+
+    init {
+        if (kq == -1) {
+            throw RuntimeException("kqueue() creation failed: ${strerror(errno)?.toKString()}")
+        }
+    }
+
+    actual override fun registerDescriptor(fd: Int) {
+        // kqueue usually auto-registers FDs when an event filter is added for them.
+        // No explicit separate registration step like io_uring might need for fixed files.
+        println("Kqueue AsyncIoEngine: registerDescriptor($fd) - implicit via submit.")
+    }
+
+    actual override fun unregisterDescriptor(fd: Int) {
+        // To unregister, remove all event filters associated with fd.
+        // EV_DELETE on existing kevent structs.
+        // For this sketch, not fully implemented cleanup on unregister.
+        println("Kqueue AsyncIoEngine: unregisterDescriptor($fd) - would remove kevent filters.")
+    }
+
+
+    private fun submitOperation(
+        fd: Int,
+        filter: Short, // EVFILT_READ or EVFILT_WRITE
+        buffer: ByteBuffer?, // Null for accept/connect that don't transfer data in submission
+        fileOffset: Long,
+        attachment: Any?
+    ): AsyncOperationHandle = memScoped {
+        val handle = newHandle()
+        val operation = KeventOp(handle, fd, filter, attachment, buffer, fileOffset)
+        activeOps[handle] = operation
+
+        val ke = alloc<kevent>()
+        EV_SET(ke.ptr, fd.convert(), filter, (EV_ADD or EV_ONESHOT).toUShort(), 0u, 0, interpretCPointer<COpaquePointerVar>(handle.id.toLong())) // Store handle ID in udata
+        // EV_ONESHOT: event is reported once and then automatically deleted.
+        
+        if (kevent(kq, ke.ptr, 1, null, 0, null) == -1) {
+            activeOps.remove(handle) // Rollback
+            throw RuntimeException("kevent add failed for fd $fd, filter $filter: ${strerror(errno)?.toKString()}")
+        }
+        return handle
+    }
+
+
+    actual override fun submitRead(fd: Int, buffer: ByteBuffer, fileOffset: Long, attachment: Any?): AsyncOperationHandle {
+        return submitOperation(fd, EVFILT_READ, buffer, fileOffset, attachment)
+    }
+
+    actual override fun submitWrite(fd: Int, buffer: ByteBuffer, fileOffset: Long, attachment: Any?): AsyncOperationHandle {
+       return submitOperation(fd, EVFILT_WRITE, buffer, fileOffset, attachment)
+    }
+
+    actual override fun submitAccept(serverFd: Int, attachment: Any?): AsyncOperationHandle {
+        // For accept, we register EVFILT_READ on the server socket.
+        // The completion will indicate readability, then we call accept().
+        return submitOperation(serverFd, EVFILT_READ, null, -1, attachment)
+    }
+    
+    actual override fun submitConnect(clientFd: Int, remoteAddress: NetworkAddress, attachment: Any?): AsyncOperationHandle {
+        // For non-blocking connect, call connect() which might return EINPROGRESS.
+        // Then monitor fd for writability (EVFILT_WRITE) for connect completion.
+        // Store remoteAddress with attachment for use in pollCompletions.
+        val connectOpData = Pair(remoteAddress, attachment) // Bundle address for processing connect
+        val result = UdpSocketServiceUtilsNative.socketAddressToNative(remoteAddress)!!.usePinned {pinnedAddr->
+          platform.posix.connect(clientFd, pinnedAddr.get().ptr.reinterpret(), sizeOf<sockaddr_in>().convert())
+        }
+
+        if (result == 0) { // Connected immediately
+            // Create a synthetic handle and immediately signal completion
+            val handle = newHandle()
+            // TODO: This immediate completion needs to be fed back into the poll loop model.
+            // This is a simplification. A real implementation would queue this for pollCompletions.
+            // For now, assume connect is always async pending.
+            // throw NotImplementedError("Immediate connect success handling not fully sketched for kqueue engine")
+             return submitOperation(clientFd, EVFILT_WRITE /* or synthetic completed event */, null, -1L, connectOpData)
+        } else if (errno != EINPROGRESS) {
+            throw RuntimeException("connect() failed: ${strerror(errno)?.toKString()}")
+        }
+        // If EINPROGRESS, monitor for writability
+        return submitOperation(clientFd, EVFILT_WRITE, null, -1L, connectOpData)
+    }
+    
+    actual override fun submitCancel(handleToCancel: AsyncOperationHandle, attachment: Any?): AsyncOperationHandle {
+        val opToCancel = activeOps[handleToCancel]
+        if (opToCancel != null) {
+            memScoped {
+                val ke = alloc<kevent>()
+                EV_SET(ke.ptr, opToCancel.fd.convert(), opToCancel.filter, EV_DELETE.toUShort(), 0u, 0, null)
+                if (kevent(kq, ke.ptr, 1, null, 0, null) == -1) {
+                    // Error deleting, but proceed. May complete normally or error.
+                    println("Kqueue: Error trying to delete event for fd ${opToCancel.fd}")
+                }
+            }
+            activeOps.remove(handleToCancel) // Assume cancellation means it won't complete "normally"
+            // A real cancel SQE would yield a completion event for the cancel itself.
+            // For kqueue EV_DELETE, there isn't a direct "cancel completion".
+            // The original operation might still complete if already processed by kernel.
+            // This is simplified. We remove it from activeOps; it won't be processed.
+            val cancelHandle = newHandle() // Dummy handle for the cancel op itself
+            // Caller might want to know if cancel *attempt* succeeded.
+            // Kqueue EV_DELETE just removes it; no specific completion.
+            // We can immediately complete the cancellation handle as "successful attempt".
+             return cancelHandle
+        }
+         throw IllegalArgumentException("Handle not found for cancellation")
+    }
+
+    actual override suspend fun pollCompletions(maxEvents: Int, timeoutMillis: Long): List<AsyncCompletionEvent> = memScoped {
+        val events = allocArray<kevent>(maxEvents)
+        val ts: CPointer<timespec>? = if (timeoutMillis >= 0) {
+            alloc<timespec> {
+                tv_sec = timeoutMillis / 1000
+                tv_nsec = (timeoutMillis % 1000) * 1_000_000
+            }.ptr
+        } else null // Infinite timeout if null
+
+        val nev = kevent(kq, null, 0, events, maxEvents, ts)
+
+        if (nev == -1) {
+            throw RuntimeException("kevent poll failed: ${strerror(errno)?.toKString()}")
+        }
+
+        val completions = mutableListOf<AsyncCompletionEvent>()
+        for (i in 0 until nev) {
+            val currentEvent = events[i]
+            val handleId = currentEvent.udata.toLong().toULong()
+            val operationData = activeOps.remove(NativeAsyncOperationHandle(handleId)) // Operation completes, remove
+
+            if (operationData == null) continue // Already cancelled or spurious
+
+            val (originalHandle, fd, filter, attachment, buffer, fileOffset) = operationData
+            
+            var result = 0
+            var errorCode: Int? = null
+
+            if ((currentEvent.flags.toInt() and EV_ERROR) != 0) {
+                errorCode = currentEvent.data.toInt() // data field contains errno on EV_ERROR
+                result = -1 // Indicate operation error
+            } else {
+                when (filter) {
+                    EVFILT_READ -> {
+                        if (attachment is Pair<*,*>) { // Indicates it was a submitAccept call
+                            val newClientFd = platform.posix.accept(fd, null, null)
+                            if (newClientFd == -1) { result = -1; errorCode = errno }
+                            else result = newClientFd
+                        } else { // Regular read
+                            val nioBuffer = (buffer as NativeArrayByteBuffer).getInternalNativeArray() // Assuming access
+                            result = if (fileOffset != -1L) {
+                                pread(fd, nioBuffer.refTo(0), buffer.remaining().convert(), fileOffset).toInt()
+                            } else {
+                                platform.posix.read(fd, nioBuffer.refTo(0), buffer.remaining().convert()).toInt()
+                            }
+                            if (result == -1) errorCode = errno else buffer.position(buffer.position() + result)
+                        }
+                    }
+                    EVFILT_WRITE -> {
+                        if (attachment is Pair<*, *>) { // Indicates it was a connect operation
+                             val errorOptVal = alloc<IntVar>()
+                             val errorOptLen = alloc<socklen_tVar>()
+                             errorOptLen.value = sizeOf<IntVar>().convert()
+                             if (getsockopt(fd, SOL_SOCKET, SO_ERROR, errorOptVal.ptr, errorOptLen.ptr) == -1) {
+                                 result = -1; errorCode = errno
+                             } else if (errorOptVal.value != 0) {
+                                 result = -1; errorCode = errorOptVal.value
+                             } else {
+                                 result = 0 // Connect success
+                             }
+                        } else { // Regular write
+                            val nioBuffer = (buffer as NativeArrayByteBuffer).getInternalNativeArray()
+                            result = if (fileOffset != -1L) {
+                                pwrite(fd, nioBuffer.refTo(buffer.position()), buffer.remaining().convert(), fileOffset).toInt()
+                            } else {
+                                platform.posix.write(fd, nioBuffer.refTo(buffer.position()), buffer.remaining().convert()).toInt()
+                            }
+                             if (result == -1) errorCode = errno else buffer.position(buffer.position() + result)
+                        }
+                    }
+                }
+            }
+            completions.add(AsyncCompletionEvent(originalHandle, attachment, result, errorCode))
+        }
+        return completions
+    }
+
+    actual override fun close() {
+        if (kq != -1) {
+            platform.posix.close(kq)
+        }
+        // TODO: Cancel any pending operations/clear activeOps?
+        // The scope managing this engine would typically cancel ongoing suspend calls to pollCompletions.
+    }
+}
+
+// Simple handle for kqueue; may be a ULong internally.
+@JvmInline
+actual value class NativeAsyncOperationHandle(val id: ULong) : AsyncOperationHandle
+
+```
+*Important Notes for `kqueue` implementation:*
+    *   It uses `EV_ONESHOT` which means events need to be re-armed if persistent monitoring is needed for a descriptor. For one-shot async operations like submitRead/submitWrite that expect one completion, this is suitable.
+    *   Non-blocking `connect()` for sockets is complex: after `connect()` returns `EINPROGRESS`, you monitor the socket for writability (`EVFILT_WRITE`). When it becomes writable, you check `SO_ERROR` socket option to confirm if connect succeeded or failed.
+    *   The `fileOffset` for `pread`/`pwrite` is used if `fileOffset` is not -1. Otherwise, standard `read`/`write` are used. This is a common pattern.
+    *   This sketch is simplified. Error handling, edge cases, and resource management would need to be more robust in production. For example, properly handling partial reads/writes if the filter isn't `EV_ONESHOT` or if not all data could be processed.
+    *   `submitCancel` is simplified. Actual cancellation in `kqueue` is achieved by removing the event filter (EV_DELETE).
+
+
+**C. JVM (`jvmMain` - using NIO `Selector` and `AsynchronousFileChannel/AsynchronousSocketChannel`)**
+
+The JVM already has mature asynchronous I/O capabilities.
+*   **For Network I/O:** `java.nio.channels.AsynchronousServerSocketChannel` and `java.nio.channels.AsynchronousSocketChannel` provide callback-based or `Future`-based async operations. These could be wrapped. The existing `Selector` mechanism also provides non-blocking I/O that can be integrated into an async pattern using a dedicated thread or coroutines.
+*   **For File I/O:** `java.nio.channels.AsynchronousFileChannel` provides true async file operations.
+
+**File: `trikeshed-core/src/jvmMain/kotlin/borg/trikeshed/reactor/ActualJvmAsyncIoEngine.kt` (New File)**
