+### **File: `architect/main.py`**
+```python
+import typer
+import asyncio
+import os
+from dotenv import load_dotenv
+from typing import List
+from .auditor import ArchitectureAuditor
+
+# Load environment variables from .env file
+load_dotenv()
+
+app = typer.Typer(help="An LLM-driven architectural delta auditor for Git.")
+
+@app.command()
+def audit(
+    repo_path: str = typer.Option(
+        ".",
+        "--repo-path",
+        "-p",
+        help="Path to the Git repository to analyze.",
+    ),
+    golden_branch: str = typer.Option(
+        "main",
+        "--golden-branch",
+        "-g",
+        help="The stable, golden-state branch.",
+    ),
+    feature_branches: List[str] = typer.Argument(
+        ...,
+        help="One or more feature branches to analyze against the golden branch."
+    )
+):
+    """
+    Run the interactive LLM architecture auditor.
+    """
+    try:
+        auditor = ArchitectureAuditor(
+            repo_path=repo_path,
+            golden_branch=golden_branch,
+            feature_branches=feature_branches
+        )
+        asyncio.run(auditor.run())
+    except (ValueError, RuntimeError) as e:
+        typer.echo(f"Error: {e}", err=True)
+        raise typer.Exit(code=1)
+
+if __name__ == "__main__":
+    app()
+```
