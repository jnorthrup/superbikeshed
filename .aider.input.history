+/***
+ * IntHeap is a heap of integers
+ */
+class IntHeap(series: Series<Int>) {
+    private var heap: IntArray = IntArray(series.size)
+    private var size = 0
+
+    init {
+        for (i in series) add(i)
+    }
+
+    fun add(i: Int) {
+        if (size == heap.size) {
+            val newHeap = IntArray(heap.size * 2)
+            for (j in heap.indices)
+                newHeap[j] = heap[j]
+            heap = newHeap
+        }
+        heap[size] = i
+        size++
+        var j = size - 1
+        while (j > 0) {
+            val parent = (j - 1) ushr 1
+            if (heap[parent] <= heap[j]) {
+                break
+            }
+            val temp = heap[parent]
+            heap[parent] = heap[j]
+            heap[j] = temp
+            j = parent
+        }
+    }
+
+    fun remove(): Int {
+        val result = heap[0]
+        size--
+        heap[0] = heap[size]
+        var j = 0
+        while (true) {
+            val left = (j shl 1) + 1
+            val right = left + 1
+            if (left >= size) {
+                break
+            }
+            val min = if (right >= size || heap[left] <= heap[right]) left else right
+            if (heap[j] <= heap[min]) {
+                break
+            }
+            val temp = heap[j]
+            heap[j] = heap[min]
+            heap[min] = temp
+            j = min
+        }
+        return result
+    }
+
+    fun isEmpty(): Boolean = size == 0
+}
