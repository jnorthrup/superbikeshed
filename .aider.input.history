+internal actual value class LinuxAsyncOperationHandle(val id: ULong) : AsyncOperationHandle
+
+// Helper function from your other code snippet (UdpSocketServiceUtilsNative), adapted.
+// THIS SHOULD BE A SHARED UTILITY or defined within a common native networking utils file.
+@OptIn(ExperimentalForeignApi::class)
+private object UdpSocketServiceUtilsNative {
+    fun socketAddressToNative(socketAddress: borg.trikeshed.net.common.UdpSocketService.SocketAddress): CValue<sockaddr_in>? {
+        return memScoped {
+            val addrInfo = allocPointerTo<addrinfo>()
+            val hints = alloc<addrinfo>()
+            platform.posix.memset(hints.ptr, 0, sizeOf<addrinfo>().convert())
+            hints.ai_family = AF_INET
+            hints.ai_socktype = SOCK_DGRAM
+            hints.ai_flags = AI_PASSIVE or AI_NUMERICSERV
+
+            val result = getaddrinfo(socketAddress.host, socketAddress.port.toString(), hints.ptr, addrInfo)
+            if (result != 0) {
+                println("getaddrinfo failed for ${socketAddress.host}: ${gai_strerror(result)?.toKString()}")
+                return@memScoped null
+            }
+            val resolvedAddrInfo = addrInfo.pointed ?: return@memScoped null
+            val sockaddrPtr = resolvedAddrInfo.ai_addr?.reinterpret<sockaddr_in>() ?: return@memScoped null
+
+            val nativeAddr = alloc<sockaddr_in>()
+            nativeAddr.sin_family = sockaddrPtr.pointed.sin_family
+            nativeAddr.sin_port = sockaddrPtr.pointed.sin_port
+            nativeAddr.sin_addr.s_addr = sockaddrPtr.pointed.sin_addr.s_addr
+            freeaddrinfo(addrInfo.value)
+            return@memScoped nativeAddr.readValue()
+        }
+    }
+}
+```
+**B. macOS/BSD (`appleMain` or other native target - using `kqueue`)**
+An `actual class AsyncIoEngine` implementation for these platforms would use `kqueue` system calls.
+   *   **Initialization:** `kqueue()` creates the kqueue descriptor.
+   *   **Submitting Operations:** For read/write readiness, `kevent()` is used to add `EVFILT_READ` or `EVFILT_WRITE` filters for a file descriptor. User data (`udata` field in `kevent` struct) can store the `AsyncOperationHandle`. Operations like `accept` also monitor `EVFILT_READ` on the server socket. `connect` on a non-blocking socket involves monitoring `EVFILT_WRITE`. Actual I/O (read, write, accept) happens when `kevent()` signals readiness.
+   *   **Polling Completions:** `kevent()` is called to retrieve events. The `result` for read/write is the bytes transferred, and for accept is the new client FD. `connect` completion status needs `getsockopt(SO_ERROR)`.
+   *   **Cancellation:** `EV_DELETE` flag with `kevent()` removes an event filter.
+   *   **Closing:** `close()` the kqueue descriptor.
+
+**C. JVM (`jvmMain`)**
+
+This is trickier due to the `fd: Int` API if trying to map directly to Java NIO `AsynchronousChannel`s, which don't use integer FDs.
+
+**Option 1: Adapt `fd:Int` API (Complex)**
+   *   Maintain an internal map `Map<Int, AsynchronousChannel>` (file or socket). `registerDescriptor` could add to this map using a synthetic FD.
+   *   `submitRead/Write` would look up the channel, then use its async methods (`read()`, `write()`) which take `java.nio.ByteBuffer` and `CompletionHandler`.
+   *   `pollCompletions` would need to poll a queue populated by these `CompletionHandler`s. This turns the callback model into a polling model.
+
+**Option 2: Different `expect` API for JVM (Potentially cleaner but breaks commonality)**
+   *   The `expect AsyncIoEngine` for JVM could have a different signature, e.g., taking `AsynchronousChannel` objects directly. This diverges from the `fd:Int` used for POSIX.
+
+**Option 3: Layer on existing `SelectorInterface` (Less direct async)**
+   *   The existing `Selector` in JVM handles readiness. Async operations could be faked by using a `Selector` with non-blocking channels and dispatching operations to a thread pool when ready. This isn't true OS-level async completion queues like `io_uring`.
+
+**Given the directive "mostly none" for NIO async, and the `fd:Int` API, Option 1 is the most direct mapping of the `expect` but also the most cumbersome for JVM.** A minimal functional placeholder for JVM might throw `UnsupportedOperationException` for many methods, or implement a very basic version on top of a single-threaded executor + `Selector`.
+
+**File: `trikeshed-core/src/jvmMain/kotlin/borg/trikeshed/reactor/ActualJvmAsyncIoEngine.kt` (Simplified Sketch)**
+```kotlin
+package borg.trikeshed.reactor
+
+import kotlinx.coroutines.*
+import java.nio.channels.AsynchronousChannelGroup
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicLong
+import borg.trikeshed.nio.ByteBuffer // Your common expect ByteBuffer
+import borg.trikeshed.io.network.NetworkAddress // Your common expect NetworkAddress
+// Assuming JvmByteBuffer is the actual class for borg.trikeshed.nio.ByteBuffer on JVM
+import borg.trikeshed.nio.JvmByteBuffer
+import java.net.InetSocketAddress
+import java.nio.channels.AsynchronousServerSocketChannel
+import java.nio.channels.AsynchronousSocketChannel
+import java.nio.channels.CompletionHandler
+import kotlin.coroutines.CoroutineContext
+import kotlin.coroutines.resume
+import kotlin.coroutines.resumeWithException
+
+@OptIn(ExperimentalCoroutinesApi::class) // For suspendCancellableCoroutine
+actual class AsyncIoEngine actual constructor() : CoroutineContext.Element {
+    actual companion object Key : CoroutineContext.Key<AsyncIoEngine>
+    override val key: CoroutineContext.Key<*> get() = Key
+
+    private val group: AsynchronousChannelGroup = AsynchronousChannelGroup.withThreadPool(
+        Executors.newCachedThreadPool() // Or a fixed thread pool
+    )
+
+    private val nextOpId = AtomicLong(0)
+    private val channelMap = ConcurrentHashMap<Int, Channel>() // Map FD (synthetic) to Java NIO Channel
+    private val completionQueue = kotlinx.coroutines.channels.Channel<AsyncCompletionEvent>(kotlinx.coroutines.channels.Channel.UNLIMITED)
+
+    actual override fun registerDescriptor(fd: Int) {
+        // For JVM, this implies that 'fd' must correspond to a channel object we already know about or can create.
+        // This method could be used to associate a raw fd (if obtained externally, unlikely) with a NIO channel.
+        // Or, it's a no-op if channels are passed directly to submit methods (which is more Java-idiomatic).
+        // Given the current API, this mapping is problematic on JVM without more context on where 'fd' comes from.
+        println("JVM AsyncIoEngine: registerDescriptor($fd) - not directly used unless mapping to NIO channels.")
+    }
+    actual override fun unregisterDescriptor(fd: Int) {
+        channelMap.remove(fd)?.close() // Close the associated NIO channel
+    }
+
+
+    // Helper to bridge CompletionHandler to suspendCoroutine or offer to completionQueue
+    private inner class OperationCompletionHandler<V>(
+        private val handle: AsyncOperationHandle,
+        private val attachment: Any?,
+        private val continuation: CancellableContinuation<AsyncCompletionEvent>? = null // For direct suspension model
+    ) : CompletionHandler<V, Any?> {
+
+        override fun completed(resultValue: V, att: Any?) { // `att` is what was passed to async op as attachment
+            val numericResult: Int = when (resultValue) {
+                is Number -> resultValue.toInt()
+                is AsynchronousSocketChannel -> 0 // Connect success
+                else -> 0 // Or -1 for unexpected types if not specific to operation
+            }
+            val event = AsyncCompletionEvent(handle, attachment, numericResult, null)
+            continuation?.resume(event) ?: runBlocking { completionQueue.send(event) }
+        }
+
+        override fun failed(exc: Throwable, att: Any?) {
+            // Map Java IOExceptions to some form of errno or just pass -1 and message
+            val errorCode = (exc as? java.io.IOException)?.hashCode() ?: -1 // Simplistic error code
+            val event = AsyncCompletionEvent(handle, attachment, -1, errorCode)
+            continuation?.resumeWithException(exc) ?: runBlocking { completionQueue.send(event) }
+        }
+    }
+
+    private fun <T: Channel> getChannel(fd: Int, type: Class<T>): T? {
+         val channel = channelMap[fd]
+         return if (type.isInstance(channel)) type.cast(channel) else null
+    }
+    
+    // Simplified submit for READ, assumes fd maps to an AsynchronousSocketChannel or AsynchronousFileChannel
+    // THIS IS VERY CONCEPTUAL and requires a robust fd -> Channel mapping.
+    actual override fun submitRead(fd: Int, buffer: ByteBuffer, fileOffset: Long, attachment: Any?): AsyncOperationHandle {
+        val handle = JvmAsyncOperationHandle(nextOpId.incrementAndGet())
+        val nioChannel = channelMap[fd] // Needs population when FDs are "opened" and mapped.
+        val jvmBuffer = (buffer as JvmByteBuffer).delegate // Get java.nio.ByteBuffer
+
+        when (nioChannel) {
+            is AsynchronousSocketChannel -> {
+                nioChannel.read(jvmBuffer, attachment, OperationCompletionHandler(handle, attachment))
+            }
+            is AsynchronousFileChannel -> {
+                nioChannel.read(jvmBuffer, fileOffset, attachment, OperationCompletionHandler(handle, attachment))
+            }
+            else -> throw IllegalArgumentException("Unsupported channel type for fd $fd for read, or fd not mapped.")
+        }
+        return handle
+    }
+    
+    // Similar conceptual implementations for submitWrite, submitAccept, submitConnect needed.
+    // They would map `fd` to the appropriate AsynchronousChannel type and call its async methods
+    // with a new OperationCompletionHandler that offers to `completionQueue`.
+    actual override fun submitWrite(fd: Int, buffer: ByteBuffer, fileOffset: Long, attachment: Any?): AsyncOperationHandle {
+        TODO("JVM write not implemented in this sketch, needs channel mapping and NIO async calls.")
+    }
+    actual override fun submitAccept(serverFd: Int, attachment: Any?): AsyncOperationHandle {
+        val handle = JvmAsyncOperationHandle(nextOpId.incrementAndGet())
+        val serverChannel = getChannel(serverFd, AsynchronousServerSocketChannel::class.java)
+            ?: throw IllegalArgumentException("No AsynchronousServerSocketChannel mapped for fd $serverFd")
+
+        serverChannel.accept(attachment, object : CompletionHandler<AsynchronousSocketChannel, Any?> {
+            override fun completed(clientChannel: AsynchronousSocketChannel, att: Any?) {
+                val newClientFd = clientChannel.hashCode() // Create a synthetic FD for the new client channel
+                channelMap[newClientFd] = clientChannel // Store it for future ops
+                // TODO: clientChannel.setOption for non-blocking/configs if needed for further interaction through this engine
+                runBlocking { completionQueue.send(AsyncCompletionEvent(handle, attachment, newClientFd, null)) }
+            }
+            override fun failed(exc: Throwable, att: Any?) {
+                 runBlocking { completionQueue.send(AsyncCompletionEvent(handle, attachment, -1, exc.hashCode())) }
+            }
+        })
+        return handle
+    }
+    actual override fun submitConnect(clientFd: Int, remoteAddress: NetworkAddress, attachment: Any?): AsyncOperationHandle { TODO("Implement") }
+    actual override fun submitCancel(handleToCancel: AsyncOperationHandle, attachment: Any?): AsyncOperationHandle { TODO("Implement, possibly via Future from submit if not using queue") }
+
+
+    actual override suspend fun pollCompletions(maxEvents: Int, timeoutMillis: Long): List<AsyncCompletionEvent> {
+        val events = mutableListOf<AsyncCompletionEvent>()
+        // Non-blocking immediate check
+        if (timeoutMillis == 0L) {
+            for (i in 0 until maxEvents) {
+                events.add(completionQueue.tryReceive().getOrNull() ?: break)
+            }
+            return events
+        }
+        
+        // Blocking or timed wait for the first event
+        val firstEvent = try {
+            if (timeoutMillis < 0) completionQueue.receive()
+            else withTimeout(timeoutMillis) { completionQueue.receive() }
+        } catch (e: TimeoutCancellationException) {
+            return emptyList() // Timeout occurred
+        }
+        events.add(firstEvent)
+
+        // Poll for more events without blocking, up to maxEvents
+        for (i in 1 until maxEvents) {
+             events.add(completionQueue.tryReceive().getOrNull() ?: break)
+        }
+        return events
+    }
+
+    actual override fun close() {
+        if (!group.isShutdown) {
+            try {
+                completionQueue.close()
+                group.shutdownNow() // Attempt to cancel ongoing tasks
+                if (!group.awaitTermination(5, TimeUnit.SECONDS)) {
+                    System.err.println("AsyncChannelGroup did not terminate in time.")
+                }
+            } catch (e: InterruptedException) {
+                Thread.currentThread().interrupt()
+            }
+        }
+        channelMap.values.forEach { try { it.close() } catch(e: Exception) { /*ignore*/ } }
+        channelMap.clear()
+        println("JVM AsyncIoEngine closed.")
+    }
+}
