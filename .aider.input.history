+
+            val ret = io_uring_queue_init_params(QUEUE_DEPTH.toUInt(), ring.ptr, params.ptr)
+            if (ret < 0) {
+                nativeHeap.free(ring.rawPtr)
+                throw RuntimeException("io_uring_queue_init_params failed: ${strerror(-ret)?.toKString()}")
+            }
+            // Setup SQ/CQ ring pointers from `params.pointed` after successful init
+            // This is similar to your KioUring example:
+            val p = params.pointed
+            val sringSz = p.sq_off.array + p.sq_entries * sizeOf<UIntVar>().toUInt()
+            sqRingPtr = mmap(
+                null, sringSz.convert(), PROT_READ or PROT_WRITE,
+                MAP_SHARED or MAP_POPULATE, ring.ring_fd, IORING_OFF_SQ_RING.toLong()
+            )!!.reinterpret()
+
+            // Initialize sq_head, sq_tail, etc. from sqRingPtr and p.sq_off
+            sq_head = (sqRingPtr.rawValue.toLong() + p.sq_off.head).toCPointer()!!
+            sq_tail = (sqRingPtr.rawValue.toLong() + p.sq_off.tail).toCPointer()!!
+            sq_ring_mask = p.sq_off.ring_mask.toUInt()
+            sq_ring_entries = p.sq_off.ring_entries.toUInt()
+            sq_flags = (sqRingPtr.rawValue.toLong() + p.sq_off.flags).toCPointer()!!
+
+            // Similarly for CQ ring mapping from p.cq_off...
+            val cringSz = p.cq_off.cqes + p.cq_entries * sizeOf<io_uring_cqe>().toUInt()
+            cqRingPtr = if ((p.features and IORING_FEAT_SINGLE_MMAP.toUInt()) != 0U) {
+                sqRingPtr.reinterpret() // Single mmap feature
+            } else {
+                mmap(
+                    null, cringSz.convert(), PROT_READ or PROT_WRITE,
+                    MAP_SHARED or MAP_POPULATE, ring.ring_fd, IORING_OFF_CQ_RING.toLong()
