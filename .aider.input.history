+fun Series<Char>.parseLong(): Long {
+//handles +-
+    var sign = 1L
+    var x = 0
+    when (this[0]) {
+        '-' -> {
+            sign = -1L; x++
+        }
+
+        '+' -> x++
+    }
+    var r = 0L
+    while (x < size) {
+        r = r * 10 + (this[x] - '0')
+        x++
+    }
+    return r * sign
+}
