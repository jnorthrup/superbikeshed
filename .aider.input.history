+### **File: `architect/auditor.py`**
+```python
+import asyncio
+from rich.console import Console
+from rich.panel import Panel
+
+from .git_manager import GitManager
+from .llm_council import LLMCouncil
+from .prompts import generate_analysis_prompt
+
+class ArchitectureAuditor:
+    def __init__(self, repo_path: str, golden_branch: str, feature_branches: list[str]):
+        self.console = Console()
+        self.git = GitManager(repo_path)
+        self.council = LLMCouncil()
+        self.golden_branch = golden_branch
+        self.feature_branches = feature_branches
+        # This taxonomy would ideally be loaded from a project-specific file
+        self.taxonomy = "1. All data structures must be immutable.\n2. Business logic must be pure and separated from I/O.\n3. Avoid deeply nested control structures."
+
+    async def analyze_changes(self):
+        self.console.print(Panel(f"[bold cyan]Starting Analysis: Comparing [yellow]{self.golden_branch}[/yellow] against {len(self.feature_branches)} feature branch(es)[/bold cyan]"))
+        
+        for branch in self.feature_branches:
+            changed_files = self.git.get_changed_files(self.golden_branch, branch)
+            if not changed_files:
+                self.console.print(f"\n[bold yellow]No changes found between {self.golden_branch} and {branch}. Skipping.[/bold yellow]")
+                continue
+
+            self.console.print(f"\n[bold green]Analyzing branch: {branch} ({len(changed_files)} changed files)[/bold green]")
+            
+            for file_path in changed_files:
+                golden_v = self.git.get_file_content_at_branch(self.golden_branch, file_path)
+                feature_v = self.git.get_file_content_at_branch(branch, file_path)
+                stats = self.git.get_diff_stats(self.golden_branch, branch, file_path)
+                
+                prompt = generate_analysis_prompt(file_path, golden_v, feature_v, stats, self.taxonomy)
+                
+                self.console.print(Panel(f"File: [bold]{file_path}[/bold] | Delta: [green]+{stats[0]}[/green] [red]-{stats[1]}[/red]", title="[magenta]Dispatching to LLM Council[/magenta]", expand=False))
+                
+                analyses = await self.council.get_quorum_analysis(prompt)
+                
+                for model, analysis in analyses.items():
+                    self.console.print(Panel(analysis, title=f"[bold yellow]Analysis from {model}[/bold yellow]", border_style="yellow"))
+
+                if self.console.input("Summarize the debate? (y/n): ").lower() == 'y':
+                    summary = await self.council.summarize_debate(analyses)
+                    self.console.print(Panel(summary, title="[bold green]Debate Summary[/bold green]", border_style="green"))
+
+    async def execute_merge_strategy(self):
+        self.console.print(Panel("[bold yellow]Automated merge strategy is a work in progress and not yet implemented.[/bold yellow]"))
+
+    async def run(self):
+        while True:
+            self.console.print("\n[bold]Architect Auditor Menu[/bold]")
+            self.console.print("1. Analyze all feature branch deltas")
+            self.console.print("2. Execute automated merge strategy (WIP)")
+            self.console.print("3. Exit")
+            choice = self.console.input("[bold]Select an option: [/bold]")
+
+            if choice == "1":
+                await self.analyze_changes()
+            elif choice == "2":
+                await self.execute_merge_strategy()
+            elif choice == "3":
+                break
+            else:
+                self.console.print("[red]Invalid option.[/red]")
+```

