+**File: `trikeshed-core/src/commonMain/kotlin/borg/trikeshed/reactor/AsyncIo.kt`**
+```kotlin
+package borg.trikeshed.reactor
+
+// Ensure these are the correct common types for your project.
+// If NetworkAddress or ByteBuffer are specific to a sub-module, adjust imports.
+import borg.trikeshed.io.network.NetworkAddress
+import borg.trikeshed.nio.ByteBuffer // Expect from borg.trikeshed.nio
+
+import kotlin.coroutines.CoroutineContext
+
+/**
+ * An opaque handle representing a submitted asynchronous I/O operation.
+ * Used to correlate completion events back to their original requests.
+ * The actual representation is platform-specific.
+ */
+expect class AsyncOperationHandle
+
+/**
+ * Represents a completed asynchronous I/O operation.
+ *
+ * @property handle The handle of the operation that completed.
+ * @property attachment The user-defined data associated with the operation when it was submitted.
+ * @property result For read/write operations, the number of bytes transferred.
+ *                  For accept, this could be a new client file descriptor (as Int).
+ *                  For connect, typically 0 on success.
+ *                  Negative values often indicate an error related to the operation itself before OS errors.
+ * @property errorCode A platform-specific error code (e.g., POSIX errno) if the operation failed at the OS level. Null on success.
+ */
+data class AsyncCompletionEvent(
+    val handle: AsyncOperationHandle,
+    val attachment: Any?,
+    val result: Int,
+    val errorCode: Int? // POSIX errno or equivalent platform error code
+)
+
+/**
+ * Defines the contract for a platform-agnostic asynchronous I/O engine,
+ * inspired by completion-queue models like io_uring and kqueue.
+ * This engine allows submitting various I/O operations and polling for their completions.
+ * It implements CoroutineContext.Element to be potentially part of a CoroutineContext (CCEK).
+ */
+expect class AsyncIoEngine() : CoroutineContext.Element {
+
+    /**
+     * The key for [AsyncIoEngine] in a [CoroutineContext].
+     */
+    companion object Key : CoroutineContext.Key<AsyncIoEngine>
+
+    override val key: CoroutineContext.Key<*>
+
+    /**
+     * Prepares a file descriptor (or equivalent platform handle) for use with this engine.
+     * For some backends like io_uring, this might involve registering the FD for more efficient operations.
+     *
+     * @param fd The platform-specific file descriptor (typically an Int for POSIX-based systems).
+     */
+    fun registerDescriptor(fd: Int)
+
+    /**
+     * Removes a file descriptor from the engine's management if it was previously registered.
+     *
+     * @param fd The platform-specific file descriptor.
+     */
+    fun unregisterDescriptor(fd: Int)
+
+    /**
+     * Submits an asynchronous read operation.
+     *
+     * @param fd The file descriptor to read from.
+     * @param buffer The ByteBuffer where read data will be placed. The buffer's `position` and `limit`
+     *               define the target area and maximum bytes to read. Implementations should update
+     *               the buffer's position upon completion.
+     * @param fileOffset For seekable files (e.g., regular files), the offset at which to start reading.
+     *                   Use -1 or 0 for current file position if applicable to the platform,
+     *                   or for non-seekable descriptors like sockets.
+     * @param attachment Optional user-defined data to associate with this operation, returned in the [AsyncCompletionEvent].
+     * @return An [AsyncOperationHandle] to track this specific operation.
+     * @throws IllegalStateException if the engine is closed or if submission fails due to an internal error.
+     * @throws IllegalArgumentException if parameters are invalid.
+     */
+    fun submitRead(
+        fd: Int,
+        buffer: ByteBuffer,
+        fileOffset: Long = -1L,
+        attachment: Any? = null
+    ): AsyncOperationHandle
+
+    /**
+     * Submits an asynchronous write operation.
+     *
+     * @param fd The file descriptor to write to.
+     * @param buffer The ByteBuffer containing data to be written. The buffer's `position` and `limit`
+     *               define the data to be written. Implementations should update the buffer's position
+     *               upon completion based on bytes written.
+     * @param fileOffset For seekable files, the offset at which to start writing.
+     *                   Use -1 or 0 for current file position or for non-seekable descriptors.
+     * @param attachment Optional user-defined data associated with this operation.
+     * @return An [AsyncOperationHandle] for tracking.
+     */
+    fun submitWrite(
+        fd: Int,
+        buffer: ByteBuffer,
+        fileOffset: Long = -1L,
+        attachment: Any? = null
+    ): AsyncOperationHandle
+
+    /**
+     * Submits an asynchronous accept operation for a listening server socket.
+     *
+     * @param serverFd The file descriptor of the listening server socket.
+     * @param attachment Optional user-defined data. The [AsyncCompletionEvent.result] will contain the new client FD.
+     * @return An [AsyncOperationHandle] for tracking.
+     */
+    fun submitAccept(serverFd: Int, attachment: Any? = null): AsyncOperationHandle
+
+    /**
+     * Submits an asynchronous connect operation for a client socket.
+     *
+     * @param clientFd The file descriptor of the client socket (usually created in non-blocking mode).
+     * @param remoteAddress The [NetworkAddress] (host/port pair) to connect to.
+     * @param attachment Optional user-defined data.
+     * @return An [AsyncOperationHandle] for tracking.
+     */
+    fun submitConnect(clientFd: Int, remoteAddress: NetworkAddress, attachment: Any? = null): AsyncOperationHandle
+
+    /**
+     * Submits a request to cancel a previously submitted asynchronous operation.
+     * Cancellation is best-effort and may not always succeed if the operation is already in progress or completed.
+     *
+     * @param handleToCancel The [AsyncOperationHandle] of the operation to attempt to cancel.
+     * @param attachment Optional user-defined data for this cancellation request (can be different from the original op's attachment).
+     * @return An [AsyncOperationHandle] for the cancellation operation itself. The completion of this new handle indicates
+     *         that the cancellation attempt has finished. The result in its [AsyncCompletionEvent] can indicate
+     *         if the cancellation was successful or if the original operation had already completed.
+     */
+    fun submitCancel(handleToCancel: AsyncOperationHandle, attachment: Any? = null): AsyncOperationHandle
+
+    /**
+     * Polls for completed I/O operations. This function may suspend if `timeoutMillis` is positive
+     * and no events are immediately available, or if `timeoutMillis` is -1 (infinite wait).
+     *
+     * @param maxEvents The maximum number of completion events to retrieve in this call.
+     * @param timeoutMillis The maximum time in milliseconds to wait for completions:
+     *                      - 0: Non-blocking. Returns immediately with any available completions.
+     *                      - >0: Waits up to this many milliseconds for at least one completion.
+     *                      - -1 (or any negative value): Waits indefinitely until at least one event completes or an error occurs.
+     * @return A list of [AsyncCompletionEvent]s that have completed. The list might be empty if a timeout occurs
+     *         before any events complete or if `timeoutMillis` was 0 and no events were ready.
+     * @throws IllegalStateException if the engine is closed.
+     * @throws InterruptedException if the waiting thread/coroutine is interrupted (platform-dependent behavior).
+     */
+    suspend fun pollCompletions(maxEvents: Int, timeoutMillis: Long): List<AsyncCompletionEvent>
+
+    /**
+     * Closes the asynchronous I/O engine, releasing any associated system resources.
+     * This method should attempt to cancel any pending operations.
+     * Further calls to submit operations after closing should result in an [IllegalStateException].
+     * This method should be idempotent (safe to call multiple times).
+     */
+    fun close()
+}
