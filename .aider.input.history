+    actual override suspend fun pollCompletions(maxEvents: Int, timeoutMillis: Long): List<AsyncCompletionEvent> = withContext(Dispatchers.Default) {
+        val completions = mutableListOf<AsyncCompletionEvent>()
+        val numSubmitted = io_uring_submit(ring.ptr) // Submit any pending SQEs
+        if (numSubmitted < 0 && numSubmitted != -EBUSY) { // EBUSY might mean kernel is busy, not necessarily fatal for completions
+            // Skip waiting for completions if submit itself failed critically
+             println("Warning: io_uring_submit failed with ${-numSubmitted} before polling completions. Err: ${strerror(-numSubmitted)?.toKString()}")
+             return@withContext completions
+        }
+
+
+        memScoped {
+            val cqePtr = alloc<CPointerVar<io_uring_cqe>>()
+            
+            // For timeouts with io_uring_wait_cqe_timeout or similar blocking calls:
+            // The `io_uring_enter` syscall with IORING_ENTER_GETEVENTS can also be used with a timeout.
+            // However, the loop below with `io_uring_peek_cqe` is for non-blocking drain or after a wait.
+            // For now, using a loop with io_uring_peek_cqe to process up to maxEvents non-blockingly.
+            // A true timed poll needs `io_uring_wait_cqe_timeout` or `io_uring_enter` with a timeout.
+            // This simplification is a non-blocking drain after an assumed timed wait has already occurred.
+            // TODO: Implement proper timed wait logic if timeoutMillis > 0 using io_uring_wait_cqe_timeout.
+            // If timeoutMillis == 0, this non-blocking loop is fine.
+            // If timeoutMillis < 0, would need io_uring_wait_cqe.
+            
+            // Let's implement a basic io_uring_wait_cqe_timeout loop.
+            var eventsProcessed = 0
+            var loopTimeout = timeoutMillis // Use up the timeout
+
+            while(eventsProcessed < maxEvents && isActive) { // `isActive` from CoroutineScope
+                val ts: __kernel_timespec? = if (loopTimeout >= 0) {
+                    alloc<__kernel_timespec> {
+                        tv_sec = loopTimeout / 1000
+                        tv_nsec = (loopTimeout % 1000) * 1_000_000
+                    }.ptr.pointed // Pass CValue
+                } else null // Infinite timeout
+
+                val ret = if (loopTimeout >= 0) {
+                    // Need to pass CValuesRef<__kernel_timespec> (pointer)
+                    // Note: __kernel_timespec definition may differ from POSIX timespec. Check your interop.
+                    val timespecForWait = ts?.readValue() // Pass pointer to allocated struct
+                    io_uring_wait_cqe_timeout(ring.ptr, cqePtr.ptr, timespecForWait?.ptr)
+                } else { // Infinite timeout
+                    io_uring_wait_cqe(ring.ptr, cqePtr.ptr)
+                }
+                
+                if (ret < 0) {
+                    if (ret == -ETIME && loopTimeout >= 0) break // Timeout expired
+                    if (ret == -EINTR) continue // Interrupted, retry
+                    throw RuntimeException("io_uring_wait_cqe_timeout failed: ${strerror(-ret)?.toKString()}")
+                }
+
+                // If wait succeeded, process available CQEs without further blocking
+                var cqeInPeekLoop: CPointer<io_uring_cqe>?
+                while (eventsProcessed < maxEvents) {
+                     val peekRet = io_uring_peek_cqe(ring.ptr, cqePtr.ptr)
+                     if (peekRet < 0) { // No more CQEs available in this peek
+                        if (peekRet == -EAGAIN) break // Queue empty
+                        throw RuntimeException("io_uring_peek_cqe failed: ${strerror(-peekRet)?.toKString()}")
+                     }
+                     cqeInPeekLoop = cqePtr.value ?: break // Should not happen if peekRet == 0
+
+                    val userData = cqeInPeekLoop.pointed.user_data.toLong().toULong()
+                    val opInfo = activeOperations.remove(userData)
+
+                    if (opInfo != null) {
+                        val (handle, attachment) = opInfo
+                        val result = cqeInPeekLoop.pointed.res
+                        val error = if (result < 0) -result else null // POSIX errno style
+                        // Adjust result for read/write: if result < 0, it's an error code. Bytes transferred is 0 or positive.
+                        val actualResult = if (result < 0) result else result 
+                        completions.add(AsyncCompletionEvent(handle, attachment, actualResult, error))
+                        eventsProcessed++
+                    }
+                    io_uring_cqe_seen(ring.ptr, cqeInPeekLoop)
+                }
+                if (loopTimeout >= 0) break // If timed, one pass of wait + peek loop is enough.
+            }
+        }
+        return completions
+    }
+
