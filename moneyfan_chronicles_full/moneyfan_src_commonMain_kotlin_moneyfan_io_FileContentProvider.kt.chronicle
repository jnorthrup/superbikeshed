-package moneyfan.io
-
-/**
- * An interface for providing file content.
- * This allows abstracting the actual file reading mechanism,
- * facilitating testing and different storage backends.
- */
-interface FileContentProvider {
-    /**
-     * Reads all lines from a file specified by the given file path.
-     *
-     * @param filePath The path to the file.
-     * @return A list of strings, where each string is a line from the file.
-     * @throws Exception if the file cannot be read (e.g., does not exist, permission issues).
-     */
-    suspend fun readFileLines(filePath: String): List<String>
-
-    /**
-     * Checks if a file exists at the given file path.
-     *
-     * @param filePath The path to the file.
-     * @return `true` if the file exists, `false` otherwise.
-     */
-    suspend fun fileExists(filePath: String): Boolean
-}
