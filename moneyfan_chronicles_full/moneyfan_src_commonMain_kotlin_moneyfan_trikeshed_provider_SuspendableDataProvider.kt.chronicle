diff --git a/moneyfan/src/commonMain/kotlin/moneyfan/trikeshed/provider/SuspendableDataProvider.kt b/moneyfan/src/commonMain/kotlin/moneyfan/trikeshed/provider/SuspendableDataProvider.kt
