--- Commit: 2869bf0c70c963a5abace6690b551c36d43dcd26 | 2025-06-23 19:15:00 -0400 ---
diff --git a/moneyfan/src/commonMain/kotlin/moneyfan/entities/Corporation.kt b/moneyfan/src/commonMain/kotlin/moneyfan/entities/Corporation.kt
deleted file mode 100644
index bc78c482..00000000
--- a/moneyfan/src/commonMain/kotlin/moneyfan/entities/Corporation.kt
+++ /dev/null
@@ -1,672 +0,0 @@
-package moneyfan.entities
-
-import borg.trikeshed.lib.*
-import kotlinx.datetime.Instant
-import kotlinx.serialization.Serializable
-import moneyfan.core.Price
-import moneyfan.core.Decimal
-
-/**
- * ## Corporation Implementation (C-Corp, S-Corp, Sole Corp)
- * 
- * Corporations are separate legal entities with shareholders, directors, and officers.
- * They provide the strongest liability protection but have more complex tax and
- * governance requirements.
- */
-
-/**
- * Corporation-specific data and operations
- */
-@Serializable
-data class Corporation(
-    override val id: EntityId,
-    override val name: String,
-    override val status: EntityStatus,
-    override val jurisdiction: JurisdictionCode,
-    override val taxId: TaxId?,
-    override val formationDate: Instant,
-    override val dissolutionDate: Instant?,
-    val corporationType: CorporationType,
-    val shareholders: Indexed<Shareholder>,
-    val shareClasses: Indexed<ShareClass>,
-    val directors: Indexed<Director>,
-    val officers: Indexed<Officer>,
-    val bylaws: CorporateBylaws,
-    val articlesOfIncorporation: ArticlesOfIncorporation,
-    val registeredAgent: RegisteredAgent,
-    val principalAddress: BusinessAddress,
-    val authorizedShares: Long,
-    val issuedShares: Long,
-    val outstandingShares: Long,
-    val parValue: Price?,
-    val dividendPolicy: DividendPolicy,
-    val bankAccounts: Indexed<BankAccount>
-) : LegalEntity {
-    
-    override val type: EntityType = when (corporationType) {
-        CorporationType.C_CORP -> EntityType.C_CORP
-        CorporationType.S_CORP -> EntityType.S_CORP
-        CorporationType.SOLE_CORP -> EntityType.SOLE_CORP
-    }
-    
-    override fun computeNetWorth(): Price {
-        val shareValue = if (outstandingShares > 0) {
-            (0 until shareholders.a).sumOf { i ->
-                val shareholder = shareholders.b(i)
-                shareholder.shareValue.value * shareholder.sharesOwned 
-            }
-        } else 0.0
-        return Price(shareValue)
-    }
-    
-    override fun getBeneficiaries(): Indexed<Beneficiary> {
-        return shareholders.a j { i: Int ->
-            val shareholder = shareholders.b(i)
-            Beneficiary(
-                id = BeneficiaryId(shareholder.id.value),
-                name = shareholder.name,
-                entityId = id,
-                beneficialInterest = (shareholder.sharesOwned.toDouble() / outstandingShares.toDouble()) * 100.0,
-                distributionRights = shareholder.distributionRights,
-                votingRights = shareholder.votingRights,
-                restrictions = shareholder.restrictions
-            )
-        }
-    }
-    
-    override fun canPerformAction(action: EntityAction): Boolean {
-        return when (action) {
-            is EntityAction.Distribution -> canMakeDividend(action)
-            is EntityAction.OwnershipTransfer -> canTransferShares(action)
-            is EntityAction.StatusChange -> canChangeStatus(action)
-            is EntityAction.TaxElection -> canMakeTaxElection(action)
-            else -> false
-        }
-    }
-    
-    override fun getTaxTreatment(): TaxStatus {
-        return when (corporationType) {
-            CorporationType.C_CORP -> TaxStatus.C_CORP_TAXATION
-            CorporationType.S_CORP -> TaxStatus.PASS_THROUGH
-            CorporationType.SOLE_CORP -> TaxStatus.C_CORP_TAXATION
-        }
-    }
-    
-    private fun canMakeDividend(action: EntityAction.Distribution): Boolean {
-        // Check if there are sufficient retained earnings
-        val retainedEarnings = computeRetainedEarnings()
-        if (action.amount > retainedEarnings) return false
-        
-        // Check dividend policy
-        return dividendPolicy.allowsDividend(action.amount, this)
-    }
-    
-    private fun canTransferShares(action: EntityAction.OwnershipTransfer): Boolean {
-        // Check share transfer restrictions in bylaws
-        return (0 until bylaws.shareTransferRestrictions.a).all { i ->
-            val restriction = bylaws.shareTransferRestrictions.b(i)
-            when (restriction) {
-                is ShareTransferRestriction.RightOfFirstRefusal -> {
-                    // Check if ROFR process followed
-                    true
-                }
-                is ShareTransferRestriction.BoardApproval -> {
-                    // Check if board approved
-                    true
-                }
-                is ShareTransferRestriction.LockupPeriod -> {
-                    action.timestamp > restriction.until
-                }
-                else -> true
-            }
-        }
-    }
-    
-    private fun canChangeStatus(action: EntityAction.StatusChange): Boolean {
-        return when (action.toStatus) {
-            EntityStatus.DISSOLVING -> {
-                // Check if shareholder approval obtained
-                bylaws.dissolutionRequirements.votingThreshold <= getShareholderApprovalPercentage()
-            }
-            EntityStatus.ACTIVE -> status == EntityStatus.FORMING
-            else -> false
-        }
-    }
-    
-    private fun canMakeTaxElection(action: EntityAction.TaxElection): Boolean {
-        return when (corporationType) {
-            CorporationType.C_CORP -> {
-                // Can elect S-Corp status if eligible
-                action.electionType == "S_CORP" && isEligibleForSCorp()
-            }
-            CorporationType.S_CORP -> {
-                // Can revoke S-Corp election
-                action.electionType == "REVOKE_S_CORP"
-            }
-            CorporationType.SOLE_CORP -> false // No tax elections
-        }
-    }
-    
-    private fun computeRetainedEarnings(): Price {
-        // Simplified calculation - would pull from financial statements
-        return Price(100000.0) // Placeholder
-    }
-    
-    private fun getShareholderApprovalPercentage(): Decimal {
-        // Would calculate based on actual votes
-        return 60.0 // Placeholder
-    }
-    
-    private fun isEligibleForSCorp(): Boolean {
-        // Check S-Corp eligibility requirements
-        return shareholders.a <= 100 && 
-               (0 until shareholders.a).all { i ->
-                   shareholders.b(i).shareholderType.isEligibleForSCorp()
-               }
-    }
-}
-
-/**
- * Types of corporations
- */
-enum class CorporationType {
-    C_CORP,       // Regular corporation
-    S_CORP,       // S-Corp tax election
-    SOLE_CORP     // Single shareholder corporation
-}
-
-/**
- * Shareholder representation
- */
-@Serializable
-data class Shareholder(
-    val id: StakeholderId,
-    val name: String,
-    val shareholderType: ShareholderType,
-    val sharesOwned: Long,
-    val shareClass: String,
-    val shareValue: Price,
-    val acquisitionDate: Instant,
-    val acquisitionPrice: Price,
-    val votingRights: VotingRights,
-    val distributionRights: DistributionRights,
-    val restrictions: Indexed<BeneficiaryRestriction>?,
-    val isFounder: Boolean = false
-)
-
-/**
- * Types of shareholders for S-Corp eligibility
- */
-enum class ShareholderType {
-    INDIVIDUAL_US_CITIZEN,
-    INDIVIDUAL_US_RESIDENT,
-    QUALIFYING_TRUST,
-    ESTATE,
-    EXEMPT_ORGANIZATION,
-    CORPORATION; // Not eligible for S-Corp
-    
-    fun isEligibleForSCorp(): Boolean {
-        return this != CORPORATION
-    }
-}
-
-/**
- * Share class definitions
- */
-@Serializable
-data class ShareClass(
-    val className: String,
-    val description: String,
-    val authorizedShares: Long,
-    val issuedShares: Long,
-    val parValue: Price?,
-    val votingRights: ShareVotingRights,
-    val dividendRights: DividendRights,
-    val liquidationPreference: LiquidationPreference?,
-    val conversionRights: ConversionRights?,
-    val redemptionRights: RedemptionRights?
-)
-
-/**
- * Voting rights for shares
- */
-@Serializable
-data class ShareVotingRights(
-    val votesPerShare: Int,
-    val votingMatters: Set<VotingMatter>,
-    val vetoRights: Set<VetoRight>
-)
-
-enum class VotingMatter {
-    ELECT_DIRECTORS,
-    MAJOR_TRANSACTIONS,
-    BYLAW_AMENDMENTS,
-    DISSOLUTION,
-    MERGER_ACQUISITION
-}
-
-enum class VetoRight {
-    SALE_OF_ASSETS,
-    ISSUANCE_OF_SHARES,
-    BORROWING,
-    DIVIDEND_DECLARATION
-}
-
-/**
- * Dividend rights
- */
-@Serializable
-data class DividendRights(
-    val priority: Int, // 1 = highest priority
-    val rate: DividendRate?,
-    val cumulative: Boolean,
-    val participating: Boolean
-)
-
-sealed interface DividendRate {
-    data class Fixed(val rate: Decimal) : DividendRate
-    data class Floating(val baseRate: Decimal, val spread: Decimal) : DividendRate
-    data object AtDiscretion : DividendRate
-}
-
-/**
- * Liquidation preference
- */
-@Serializable
-data class LiquidationPreference(
-    val priority: Int,
-    val multiple: Decimal, // e.g., 1.0x, 2.0x
-    val participating: Boolean,
-    val cap: Price?
-)
-
-/**
- * Conversion rights (for preferred shares)
- */
-@Serializable
-data class ConversionRights(
-    val convertibleTo: String, // Target share class
-    val conversionRatio: Decimal,
-    val conversionPrice: Price?,
-    val automaticTriggers: Indexed<ConversionTrigger>
-)
-
-sealed interface ConversionTrigger {
-    data class IPO(val minimumValuation: Price) : ConversionTrigger
-    data class Sale(val minimumPrice: Price) : ConversionTrigger
-    data class Date(val date: Instant) : ConversionTrigger
-}
-
-/**
- * Redemption rights
- */
-@Serializable
-data class RedemptionRights(
-    val redeemableBy: RedemptionParty,
-    val redemptionPrice: RedemptionPrice,
-    val noticePeriod: Int, // Days
-    val exerciseWindow: Int // Days
-)
-
-enum class RedemptionParty {
-    CORPORATION,
-    SHAREHOLDER,
-    EITHER
-}
-
-sealed interface RedemptionPrice {
-    data class Fixed(val price: Price) : RedemptionPrice
-    data class FairMarketValue(val method: String) : RedemptionPrice
-    data class Formula(val formula: String) : RedemptionPrice
-}
-
-/**
- * Director representation
- */
-@Serializable
-data class Director(
-    val id: StakeholderId,
-    val name: String,
-    val appointedDate: Instant,
-    val termExpiration: Instant?,
-    val independent: Boolean,
-    val committees: Set<BoardCommittee>,
-    val compensation: DirectorCompensation?
-)
-
-enum class BoardCommittee {
-    AUDIT,
-    COMPENSATION,
-    NOMINATING,
-    GOVERNANCE,
-    EXECUTIVE
-}
-
-@Serializable
-data class DirectorCompensation(
-    val annualRetainer: Price?,
-    val meetingFees: Price?,
-    val stockOptions: Long?,
-    val otherCompensation: String?
-)
-
-/**
- * Officer representation
- */
-@Serializable
-data class Officer(
-    val id: StakeholderId,
-    val name: String,
-    val title: OfficerTitle,
-    val appointedDate: Instant,
-    val signingAuthority: SigningAuthority,
-    val spendingLimit: Price?,
-    val compensation: OfficerCompensation?
-)
-
-enum class OfficerTitle {
-    CEO,
-    CFO,
-    COO,
-    CTO,
-    PRESIDENT,
-    VICE_PRESIDENT,
-    SECRETARY,
-    TREASURER,
-    ASSISTANT_SECRETARY,
-    ASSISTANT_TREASURER
-}
-
-@Serializable
-data class OfficerCompensation(
-    val baseSalary: Price,
-    val bonus: Price?,
-    val stockOptions: Long?,
-    val benefits: String?
-)
-
-/**
- * Corporate bylaws
- */
-@Serializable
-data class CorporateBylaws(
-    val adoptionDate: Instant,
-    val lastAmended: Instant?,
-    val shareholderMeetings: ShareholderMeetingRules,
-    val boardMeetings: BoardMeetingRules,
-    val shareTransferRestrictions: Indexed<ShareTransferRestriction>,
-    val dissolutionRequirements: DissolutionRequirements,
-    val indemnificationProvisions: IndemnificationTerms,
-    val conflictOfInterestPolicy: ConflictOfInterestPolicy
-)
-
-/**
- * Shareholder meeting rules
- */
-@Serializable
-data class ShareholderMeetingRules(
-    val annualMeetingRequired: Boolean,
-    val noticePeriod: Int, // Days
-    val quorumThreshold: Decimal, // Percentage
-    val votingThreshold: Decimal, // Percentage for ordinary matters
-    val specialMatterThreshold: Decimal // Percentage for special matters
-)
-
-/**
- * Board meeting rules
- */
-@Serializable
-data class BoardMeetingRules(
-    val minimumMeetingsPerYear: Int,
-    val noticePeriod: Int, // Days
-    val quorumThreshold: Int, // Number of directors
-    val votingThreshold: Decimal // Percentage for approval
-)
-
-/**
- * Share transfer restrictions
- */
-sealed interface ShareTransferRestriction {
-    data object RightOfFirstRefusal : ShareTransferRestriction
-    data object BoardApproval : ShareTransferRestriction
-    data class LockupPeriod(val until: Instant) : ShareTransferRestriction
-    data class TagAlongRights(val threshold: Decimal) : ShareTransferRestriction
-    data class DragAlongRights(val threshold: Decimal) : ShareTransferRestriction
-}
-
-/**
- * Conflict of interest policy
- */
-@Serializable
-data class ConflictOfInterestPolicy(
-    val disclosureRequired: Boolean,
-    val approvalRequired: Boolean,
-    val recusalRequired: Boolean,
-    val annualQuestionnaire: Boolean
-)
-
-/**
- * Articles of incorporation
- */
-@Serializable
-data class ArticlesOfIncorporation(
-    val filingDate: Instant,
-    val corporateName: String,
-    val businessPurpose: String,
-    val duration: CorporationDuration,
-    val authorizedShares: Indexed<AuthorizedShareClass>,
-    val incorporators: Indexed<Incorporator>,
-    val registeredAgent: RegisteredAgent,
-    val registeredOffice: BusinessAddress
-)
-
-sealed interface CorporationDuration {
-    data object Perpetual : CorporationDuration
-    data class FixedTerm(val expirationDate: Instant) : CorporationDuration
-}
-
-@Serializable
-data class AuthorizedShareClass(
-    val className: String,
-    val authorizedShares: Long,
-    val parValue: Price?,
-    val description: String
-)
-
-@Serializable
-data class Incorporator(
-    val name: String,
-    val address: BusinessAddress
-)
-
-/**
- * Dividend policy
- */
-@Serializable
-data class DividendPolicy(
-    val policyType: DividendPolicyType,
-    val targetPayoutRatio: Decimal?,
-    val minimumCashReserve: Price?,
-    val declarationFrequency: DividendFrequency
-) {
-    fun allowsDividend(amount: Price, corp: Corporation): Boolean {
-        return when (policyType) {
-            DividendPolicyType.NO_DIVIDENDS -> false
-            DividendPolicyType.DISCRETIONARY -> true
-            DividendPolicyType.FIXED_AMOUNT -> true
-            DividendPolicyType.PERCENTAGE_OF_EARNINGS -> {
-                val earnings = corp.computeRetainedEarnings()
-                val maxDividend = earnings * (targetPayoutRatio ?: 50.0) / 100.0
-                amount <= maxDividend
-            }
-        }
-    }
-}
-
-enum class DividendPolicyType {
-    NO_DIVIDENDS,
-    DISCRETIONARY,
-    FIXED_AMOUNT,
-    PERCENTAGE_OF_EARNINGS
-}
-
-enum class DividendFrequency {
-    ANNUAL,
-    SEMI_ANNUAL,
-    QUARTERLY,
-    MONTHLY,
-    IRREGULAR
-}
-
-/**
- * Corporation-specific helper functions
- */
-object CorporationOperations {
-    
-    /**
-     * Create a C-Corporation
-     */
-    fun createCCorp(
-        name: String,
-        jurisdiction: JurisdictionCode,
-        founders: Indexed<Incorporator>,
-        authorizedShares: Long,
-        registeredAgent: RegisteredAgent
-    ): Corporation {
-        val entityId = EntityOperations.generateEntityId(EntityType.C_CORP, jurisdiction)
-        
-        return Corporation(
-            id = entityId,
-            name = name,
-            status = EntityStatus.FORMING,
-            jurisdiction = jurisdiction,
-            taxId = null,
-            formationDate = kotlinx.datetime.Clock.System.now(),
-            dissolutionDate = null,
-            corporationType = CorporationType.C_CORP,
-            shareholders = emptyIndex(),
-            shareClasses = createDefaultShareClasses(),
-            directors = emptyIndex(),
-            officers = emptyIndex(),
-            bylaws = createDefaultBylaws(),
-            articlesOfIncorporation = createDefaultArticles(name, founders, registeredAgent),
-            registeredAgent = registeredAgent,
-            principalAddress = registeredAgent.address,
-            authorizedShares = authorizedShares,
-            issuedShares = 0,
-            outstandingShares = 0,
-            parValue = Price(0.001),
-            dividendPolicy = createDefaultDividendPolicy(),
-            bankAccounts = emptyIndex()
-        )
-    }
-    
-    /**
-     * Create default share classes
-     */
-    private fun createDefaultShareClasses(): Indexed<ShareClass> {
-        val commonShares = ShareClass(
-            className = "Common",
-            description = "Common stock with voting rights",
-            authorizedShares = 10000000,
-            issuedShares = 0,
-            parValue = Price(0.001),
-            votingRights = ShareVotingRights(
-                votesPerShare = 1,
-                votingMatters = setOf(VotingMatter.ELECT_DIRECTORS),
-                vetoRights = emptySet()
-            ),
-            dividendRights = DividendRights(
-                priority = 2,
-                rate = DividendRate.AtDiscretion,
-                cumulative = false,
-                participating = true
-            ),
-            liquidationPreference = null,
-            conversionRights = null,
-            redemptionRights = null
-        )
-        
-        return 1 j { _: Int -> commonShares }
-    }
-    
-    /**
-     * Create default bylaws
-     */
-    private fun createDefaultBylaws(): CorporateBylaws {
-        return CorporateBylaws(
-            adoptionDate = kotlinx.datetime.Clock.System.now(),
-            lastAmended = null,
-            shareholderMeetings = ShareholderMeetingRules(
-                annualMeetingRequired = true,
-                noticePeriod = 20,
-                quorumThreshold = 50.0,
-                votingThreshold = 50.0,
-                specialMatterThreshold = 66.7
-            ),
-            boardMeetings = BoardMeetingRules(
-                minimumMeetingsPerYear = 4,
-                noticePeriod = 5,
-                quorumThreshold = 3,
-                votingThreshold = 50.0
-            ),
-            shareTransferRestrictions = emptyIndex(),
-            dissolutionRequirements = DissolutionRequirements(
-                votingThreshold = 66.7,
-                unanimousRequired = false,
-                specificTriggers = emptyIndex()
-            ),
-            indemnificationProvisions = IndemnificationTerms(
-                coveredPersons = emptyIndex(),
-                scope = IndemnificationScope.STANDARD,
-                exceptions = emptyIndex(),
-                advancementOfExpenses = true
-            ),
-            conflictOfInterestPolicy = ConflictOfInterestPolicy(
-                disclosureRequired = true,
-                approvalRequired = true,
-                recusalRequired = true,
-                annualQuestionnaire = true
-            )
-        )
-    }
-    
-    /**
-     * Create default articles of incorporation
-     */
-    private fun createDefaultArticles(
-        name: String,
-        incorporators: Indexed<Incorporator>,
-        registeredAgent: RegisteredAgent
-    ): ArticlesOfIncorporation {
-        return ArticlesOfIncorporation(
-            filingDate = kotlinx.datetime.Clock.System.now(),
-            corporateName = name,
-            businessPurpose = "To engage in any lawful business purpose",
-            duration = CorporationDuration.Perpetual,
-            authorizedShares = 1 j { _: Int -> 
-                AuthorizedShareClass(
-                    className = "Common",
-                    authorizedShares = 10000000,
-                    parValue = Price(0.001),
-                    description = "Common stock"
-                )
-            },
-            incorporators = incorporators,
-            registeredAgent = registeredAgent,
-            registeredOffice = registeredAgent.address
-        )
-    }
-    
-    /**
-     * Create default dividend policy
-     */
-    private fun createDefaultDividendPolicy(): DividendPolicy {
-        return DividendPolicy(
-            policyType = DividendPolicyType.DISCRETIONARY,
-            targetPayoutRatio = null,
-            minimumCashReserve = Price(10000.0),
-            declarationFrequency = DividendFrequency.QUARTERLY
-        )
-    }
-}
