-package moneyfan.entities
-
-import borg.trikeshed.lib.*
-import kotlinx.datetime.Instant
-import kotlinx.serialization.Serializable
-import moneyfan.core.Price
-import moneyfan.core.Decimal
-
-/**
- * ## Corporation Sole Implementation
- * 
- * A Corporation Sole is a special type of corporation designed for religious
- * and charitable purposes. It has a single office holder (usually a religious
- * leader) who serves as the sole shareholder and director. This structure
- * provides perpetual existence for religious institutions.
- * 
- * Common uses:
- * - Catholic dioceses (Bishop as Corporation Sole)
- * - Protestant denominations
- * - Other religious organizations
- * - Some charitable organizations
- */
-
-/**
- * Corporation Sole entity
- */
-@Serializable
-data class CorpSole(
-    override val id: EntityId,
-    override val name: String,
-    override val status: EntityStatus,
-    override val jurisdiction: JurisdictionCode,
-    override val taxId: TaxId?,
-    override val formationDate: Instant,
-    override val dissolutionDate: Instant?,
-    val purpose: ReligiousPurpose,
-    val officeHolder: OfficeHolder,
-    val successors: Indexed<SuccessorOfficeHolder>,
-    val religiousOrganization: ReligiousOrganization,
-    val exemptStatus: ExemptStatus?,
-    val charitableActivities: Indexed<CharitableActivity>,
-    val propertyHoldings: Indexed<ReligiousProperty>,
-    val governance: CorpSoleGovernance,
-    val financialOversight: FinancialOversight,
-    val registeredAgent: RegisteredAgent,
-    val principalAddress: BusinessAddress
-) : LegalEntity {
-    
-    override val type: EntityType = EntityType.CORP_SOLE
-    
-    override fun computeNetWorth(): Price {
-        val totalPropertyValue = propertyHoldings.play.sumOf { it.currentValue.value }
-        return Price(totalPropertyValue)
-    }
-    
-    override fun getBeneficiaries(): Indexed<Beneficiary> {
-        // In a Corporation Sole, the religious organization/community are the beneficiaries
-        return 1 j {
-            Beneficiary(
-                id = BeneficiaryId(religiousOrganization.id.value),
-                name = religiousOrganization.name,
-                entityId = id,
-                beneficialInterest = 100.0,
-                distributionRights = DistributionRights(
-                    priority = 1,
-                    percentage = 100.0,
-                    minimumDistribution = null,
-                    maximumDistribution = null,
-                    distributionSchedule = DistributionSchedule.Discretionary
-                ),
-                votingRights = null, // No voting rights for beneficiaries
-                restrictions = null
-            )
-        }
-    }
-    
-    override fun canPerformAction(action: EntityAction): Boolean {
-        return when (action) {
-            is EntityAction.Distribution -> canMakeDistribution(action)
-            is EntityAction.OwnershipTransfer -> false // No ownership transfers
-            is EntityAction.StatusChange -> canChangeStatus(action)
-            is EntityAction.TaxElection -> false // Tax status determined by exempt status
-            else -> false
-        }
-    }
-    
-    override fun getTaxTreatment(): TaxStatus {
-        return if (exemptStatus?.isExempt == true) {
-            TaxStatus.EXEMPT
-        } else {
-            TaxStatus.C_CORP_TAXATION
-        }
-    }
-    
-    private fun canMakeDistribution(action: EntityAction.Distribution): Boolean {
-        // Check if distribution aligns with religious/charitable purpose
-        val activity = charitableActivities.play.find { 
-            it.beneficiary == action.beneficiaryId.value 
-        }
-        return activity != null && isCharitablePurpose(activity)
-    }
-    
-    private fun canChangeStatus(action: EntityAction.StatusChange): Boolean {
-        return when (action.toStatus) {
-            EntityStatus.DISSOLVING -> {
-                // Special dissolution requirements for religious entities
-                governance.dissolutionRequirements.isMet(this)
-            }
-            EntityStatus.ACTIVE -> status == EntityStatus.FORMING
-            else -> false
-        }
-    }
-    
-    private fun isCharitablePurpose(activity: CharitableActivity): Boolean {
-        return activity.activityType in setOf(
-            CharitableActivityType.RELIGIOUS_WORSHIP,
-            CharitableActivityType.CHARITABLE_DISTRIBUTION,
-            CharitableActivityType.EDUCATIONAL,
-            CharitableActivityType.COMMUNITY_SERVICE
-        )
-    }
-}
-
-/**
- * Religious purpose definition
- */
-@Serializable
-data class ReligiousPurpose(
-    val primaryPurpose: String,
-    val denomination: String?,
-    val specificMission: String,
-    val charitableAspects: Indexed<String>,
-    val excludedActivities: Indexed<String>
-)
-
-/**
- * Office holder (typically a religious leader)
- */
-@Serializable
-data class OfficeHolder(
-    val id: StakeholderId,
-    val name: String,
-    val title: ReligiousTitle,
-    val appointmentDate: Instant,
-    val appointedBy: String?, // Who appointed them
-    val termLength: OfficeTerm,
-    val powers: Indexed<OfficeHolderPower>,
-    val restrictions: Indexed<OfficeHolderRestriction>,
-    val compensation: ReligiousCompensation?
-)
-
-enum class ReligiousTitle {
-    BISHOP,
-    ARCHBISHOP,
-    CARDINAL,
-    PASTOR,
-    MINISTER,
-    RABBI,
-    IMAM,
-    PRIEST,
-    DEACON,
-    ELDER,
-    SUPERINTENDENT,
-    PRESIDENT,
-    DIRECTOR,
-    OTHER
-}
-
-sealed interface OfficeTerm {
-    data object LifeTerm : OfficeTerm
-    data class FixedTerm(val years: Int) : OfficeTerm
-    data class ConditionalTerm(val condition: String) : OfficeTerm
-    data object AtWill : OfficeTerm
-}
-
-/**
- * Powers of the office holder
- */
-enum class OfficeHolderPower {
-    ACQUIRE_PROPERTY,
-    SELL_PROPERTY,
-    ENTER_CONTRACTS,
-    HIRE_EMPLOYEES,
-    MAKE_DONATIONS,
-    INVEST_FUNDS,
-    BORROW_MONEY,
-    ESTABLISH_POLICIES,
-    APPOINT_SUCCESSOR,
-    DELEGATE_AUTHORITY
-}
-
-/**
- * Restrictions on office holder
- */
-sealed interface OfficeHolderRestriction {
-    data class SpendingLimit(val amount: Price) : OfficeHolderRestriction
-    data class PropertySaleApproval(val threshold: Price) : OfficeHolderRestriction
-    data class BoardApproval(val actions: Set<OfficeHolderPower>) : OfficeHolderRestriction
-    data class CharitablePurposeOnly(val details: String) : OfficeHolderRestriction
-}
-
-/**
- * Compensation for religious leaders
- */
-@Serializable
-data class ReligiousCompensation(
-    val salary: Price?,
-    val housing: Price?,
-    val benefits: Price?,
-    val retirementContribution: Price?,
-    val otherCompensation: String?,
-    val compensationCommitteeApproval: Boolean
-)
-
-/**
- * Successor office holder
