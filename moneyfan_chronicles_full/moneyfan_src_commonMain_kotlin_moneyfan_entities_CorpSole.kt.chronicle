-@Serializable
-data class SuccessorOfficeHolder(
-    val id: StakeholderId,
-    val name: String,
-    val title: ReligiousTitle,
-    val successionOrder: Int,
-    val qualifications: Indexed<String>,
-    val automaticSuccession: Boolean,
-    val confirmationRequired: Boolean
-)
-
-/**
- * Religious organization details
- */
-@Serializable
-data class ReligiousOrganization(
-    val id: StakeholderId,
-    val name: String,
-    val denomination: String,
-    val parentOrganization: String?,
-    val membership: Int?,
-    val congregations: Indexed<Congregation>,
-    val beliefs: ReligiousBeliefs
-)
-
-@Serializable
-data class Congregation(
-    val name: String,
-    val address: BusinessAddress,
-    val membershipCount: Int?,
-    val pastor: String?
-)
-
-@Serializable
-data class ReligiousBeliefs(
-    val creed: String?,
-    val doctrinalStatements: Indexed<String>,
-    val practicesAndRituals: Indexed<String>
-)
-
-/**
- * Tax exempt status
- */
-@Serializable
-data class ExemptStatus(
-    val exemptionType: ExemptionType,
-    val irs501cStatus: String?, // e.g., "501(c)(3)"
-    val exemptionDate: Instant,
-    val exemptionLetter: String?, // Document reference
-    val isExempt: Boolean,
-    val publicCharity: Boolean,
-    val privateFoundation: Boolean,
-    val annualFilingRequired: Boolean
-)
-
-enum class ExemptionType {
-    RELIGIOUS_501C3,
-    CHARITABLE_501C3,
-    EDUCATIONAL_501C3,
-    CHURCH_EXEMPTION,
-    STATE_EXEMPTION_ONLY,
-    NOT_EXEMPT
-}
-
-/**
- * Charitable activities
- */
-@Serializable
-data class CharitableActivity(
-    val activityType: CharitableActivityType,
-    val description: String,
-    val beneficiary: String,
-    val annualBudget: Price?,
-    val percentageOfTotalActivities: Decimal
-)
-
-enum class CharitableActivityType {
-    RELIGIOUS_WORSHIP,
-    CHARITABLE_DISTRIBUTION,
-    EDUCATIONAL,
-    COMMUNITY_SERVICE,
-    HEALTHCARE,
-    DISASTER_RELIEF,
-    POVERTY_ASSISTANCE,
-    YOUTH_PROGRAMS,
-    ELDERLY_CARE,
-    MISSIONARY_WORK
-}
-
-/**
- * Religious property holdings
- */
-@Serializable
-data class ReligiousProperty(
-    val propertyType: ReligiousPropertyType,
-    val address: BusinessAddress,
-    val acquisitionDate: Instant,
-    val acquisitionPrice: Price,
-    val currentValue: Price,
-    val useType: PropertyUseType,
-    val restrictions: Indexed<PropertyRestriction>
-)
-
-enum class ReligiousPropertyType {
-    CHURCH_BUILDING,
-    PARSONAGE,
-    CEMETERY,
-    RELIGIOUS_SCHOOL,
-    RETREAT_CENTER,
-    ADMINISTRATIVE_BUILDING,
-    PARKING_LOT,
-    VACANT_LAND,
-    RENTAL_PROPERTY,
-    INVESTMENT_PROPERTY
-}
-
-enum class PropertyUseType {
-    RELIGIOUS_WORSHIP,
-    RELIGIOUS_EDUCATION,
-    CHARITABLE_ACTIVITIES,
-    ADMINISTRATIVE,
-    RESIDENTIAL,
-    COMMERCIAL_RENTAL,
-    INVESTMENT
-}
-
-sealed interface PropertyRestriction {
-    data object ReligiousUseOnly : PropertyRestriction
-    data object NoSaleWithoutApproval : PropertyRestriction
-    data class HistoricalDesignation(val details: String) : PropertyRestriction
-    data class ZoningRestriction(val zoning: String) : PropertyRestriction
-}
-
-/**
- * Corporation Sole governance
- */
-@Serializable
-data class CorpSoleGovernance(
-    val advisoryBoard: Indexed<AdvisoryBoardMember>?,
-    val oversightCommittee: Indexed<OversightCommitteeMember>?,
-    val dissolutionRequirements: CorpSoleDissolutionRequirements,
-    val conflictOfInterestPolicy: ConflictOfInterestPolicy,
-    val whistleblowerPolicy: WhistleblowerPolicy?
-) {
-    fun isMajorDecision(action: EntityAction): Boolean {
-        return when (action) {
-            is EntityAction.Distribution -> action.amount.value > 10000.0
-            is EntityAction.StatusChange -> true
-            else -> false
-        }
-    }
-}
-
-@Serializable
-data class AdvisoryBoardMember(
-    val id: StakeholderId,
-    val name: String,
-    val title: String,
-    val expertise: String,
-    val appointedDate: Instant,
-    val termExpiration: Instant?
-)
-
-@Serializable
-data class OversightCommitteeMember(
-    val id: StakeholderId,
-    val name: String,
-    val role: OversightRole,
-    val appointedDate: Instant
-)
-
-enum class OversightRole {
-    FINANCIAL_OVERSIGHT,
-    COMPLIANCE_OVERSIGHT,
-    GOVERNANCE_OVERSIGHT,
-    AUDIT_OVERSIGHT
-}
-
-@Serializable
-data class CorpSoleDissolutionRequirements(
-    val religiousAuthorityApproval: Boolean,
-    val courtApproval: Boolean,
-    val assetDistribution: AssetDistributionPlan
-) {
-    fun isMet(corpSole: CorpSole): Boolean {
-        // Would check actual approvals
-        return true // Placeholder
-    }
-}
-
-@Serializable
-data class AssetDistributionPlan(
-    val primaryBeneficiary: String,
-    val alternativeBeneficiaries: Indexed<String>,
-    val cyPresDistribution: Boolean
-)
-
-@Serializable
-data class WhistleblowerPolicy(
-    val reportingProcedures: String,
-    val protectionProvisions: String,
-    val investigationProcess: String
-)
-
-/**
- * Financial oversight specific to religious entities
- */
-@Serializable
-data class FinancialOversight(
-    val auditRequired: Boolean,
-    val auditorType: AuditorType?,
-    val financialReportingFrequency: ReportingFrequency,
-    val donorPrivacy: DonorPrivacyPolicy,
-    val investmentPolicy: ReligiousInvestmentPolicy,
-    val expenditureApproval: ExpenditureApprovalProcess
-)
-
-enum class AuditorType {
-    INDEPENDENT_CPA,
-    DENOMINATIONAL_AUDITOR,
-    INTERNAL_AUDIT,
-    NO_AUDIT_REQUIRED
-}
-
-enum class ReportingFrequency {
-    MONTHLY,
-    QUARTERLY,
-    ANNUALLY,
-    NONE_REQUIRED
-}
-
-@Serializable
-data class DonorPrivacyPolicy(
-    val anonymousDonationsAllowed: Boolean,
-    val donorListConfidentiality: Boolean,
-    val reportingThreshold: Price?
-)
-
-@Serializable
-data class ReligiousInvestmentPolicy(
-    val sociallyResponsibleInvestingRequired: Boolean,
-    val prohibitedInvestments: Indexed<String>,
-    val investmentCommitteeRequired: Boolean,
-    val riskTolerance: InvestmentRiskLevel
-)
-
-enum class InvestmentRiskLevel {
-    CONSERVATIVE,
-    MODERATE,
-    AGGRESSIVE
-}
-
-@Serializable
-data class ExpenditureApprovalProcess(
-    val singleSignatureLimit: Price,
-    val boardApprovalThreshold: Price,
-    val religiousAuthorityApprovalThreshold: Price?
-)
-
-/**
- * Corporation Sole operations
- */
-object CorpSoleOperations {
-    
-    /**
-     * Create a Corporation Sole
-     */
-    fun createCorpSole(
-        name: String,
-        jurisdiction: JurisdictionCode,
-        officeHolder: OfficeHolder,
-        religiousOrganization: ReligiousOrganization,
-        purpose: ReligiousPurpose,
-        registeredAgent: RegisteredAgent
-    ): CorpSole {
-        val entityId = EntityOperations.generateEntityId(EntityType.CORP_SOLE, jurisdiction)
-        
-        return CorpSole(
-            id = entityId,
-            name = name,
-            status = EntityStatus.FORMING,
-            jurisdiction = jurisdiction,
-            taxId = null,
-            formationDate = kotlinx.datetime.Clock.System.now(),
-            dissolutionDate = null,
-            purpose = purpose,
-            officeHolder = officeHolder,
-            successors = emptyIndex(),
-            religiousOrganization = religiousOrganization,
-            exemptStatus = null, // To be obtained after formation
-            charitableActivities = emptyIndex(),
-            propertyHoldings = emptyIndex(),
-            governance = createDefaultGovernance(),
-            financialOversight = createDefaultFinancialOversight(),
-            registeredAgent = registeredAgent,
-            principalAddress = registeredAgent.address
-        )
-    }
-    
-    /**
-     * Create default governance structure
-     */
-    private fun createDefaultGovernance(): CorpSoleGovernance {
-        return CorpSoleGovernance(
-            advisoryBoard = null,
-            oversightCommittee = null,
-            dissolutionRequirements = CorpSoleDissolutionRequirements(
-                religiousAuthorityApproval = true,
-                courtApproval = true,
-                assetDistribution = AssetDistributionPlan(
-                    primaryBeneficiary = "Similar religious organization",
-                    alternativeBeneficiaries = emptyIndex(),
-                    cyPresDistribution = true
-                )
-            ),
-            conflictOfInterestPolicy = ConflictOfInterestPolicy(
-                disclosureRequired = true,
-                approvalRequired = true,
-                recusalRequired = true,
-                annualQuestionnaire = true
-            ),
-            whistleblowerPolicy = null
-        )
-    }
-    
-    /**
-     * Create default financial oversight
-     */
-    private fun createDefaultFinancialOversight(): FinancialOversight {
-        return FinancialOversight(
-            auditRequired = false,
-            auditorType = null,
-            financialReportingFrequency = ReportingFrequency.ANNUALLY,
-            donorPrivacy = DonorPrivacyPolicy(
-                anonymousDonationsAllowed = true,
-                donorListConfidentiality = true,
-                reportingThreshold = Price(5000.0)
-            ),
-            investmentPolicy = ReligiousInvestmentPolicy(
-                sociallyResponsibleInvestingRequired = true,
-                prohibitedInvestments = 3 j { i ->
-                    when (i) {
-                        0 -> "Tobacco companies"
-                        1 -> "Gambling enterprises"
-                        else -> "Alcohol manufacturers"
-                    }
-                },
-                investmentCommitteeRequired = false,
-                riskTolerance = InvestmentRiskLevel.CONSERVATIVE
-            ),
-            expenditureApproval = ExpenditureApprovalProcess(
-                singleSignatureLimit = Price(1000.0),
-                boardApprovalThreshold = Price(10000.0),
-                religiousAuthorityApprovalThreshold = Price(50000.0)
-            )
-        )
-    }
-    
-    /**
-     * Check if Corporation Sole qualifies for tax exemption
-     */
-    fun qualifiesForTaxExemption(corpSole: CorpSole): Boolean {
-        return corpSole.charitableActivities.play.sumOf { 
-            it.percentageOfTotalActivities 
-        } >= 50.0 // At least 50% charitable activities
-    }
-    
-    /**
-     * Calculate charitable activity percentage
-     */
-    fun calculateCharitablePercentage(activities: Indexed<CharitableActivity>): Decimal {
-        val charitableActivities = activities.play.filter { it.activityType != CharitableActivityType.RELIGIOUS_WORSHIP }
-        return charitableActivities.sumOf { it.percentageOfTotalActivities }
-    }
-}
