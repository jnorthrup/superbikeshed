--- Commit: 2869bf0c70c963a5abace6690b551c36d43dcd26 | 2025-06-23 19:15:00 -0400 ---
diff --git a/ta4k/src/commonMain/kotlin/com/ta4k/acapulco/attention/HistoricalAttentionSystem.kt b/ta4k/src/commonMain/kotlin/com/ta4k/acapulco/attention/HistoricalAttentionSystem.kt
