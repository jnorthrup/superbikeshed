-package data
-
-import kotlin.test.*
-import com.google.trike.series.* // Star import for Series, Cursor, RowVec, Join, ColumnMeta etc.
-import com.google.trike.series.storage.IsamDataFile // Specific import if needed, though covered by series.*
-import kotlin.io.File // For file deletion, assuming common or JVM context
-
-class KlinesLoaderTest {
-
-    private val klinesLoader = KlinesLoader()
-    // Define temporary file paths for ISAM testing. These files will be created and deleted.
-    private val testIsamDataPath = "test_klines_loader.isam"
-    private val testIsamMetaPath = "test_klines_loader.isam.meta"
-
-    @AfterTest
-    fun tearDown() {
-        // Clean up: Attempt to delete the temporary ISAM and meta files after each test.
-        // This relies on standard file system access available in the test environment (e.g., JVM).
-        // Wrapped in try-catch to prevent test failures if deletion fails for external reasons.
-        try {
-            File(testIsamDataPath).delete()
-            File(testIsamMetaPath).delete()
-        } catch (e: Exception) {
-            // Log a warning if deletion fails, but don't fail the test itself.
-            println("Warning: Could not delete test files '$testIsamDataPath' or '$testIsamMetaPath': ${e.message}")
-        }
-    }
-
-    @Test
-    fun testStoreAndReadKlinesIsam() {
-        // 1. Load mock kline data using the KlinesLoader.
-        // The specific path "mock_path..." is unused by the current mock implementation of loadKlinesCsv.
-        val mockKlinesSeries = klinesLoader.loadKlinesCsv("mock_path_for_loader")
-        assertNotNull(mockKlinesSeries, "Mock klines series should not be null.")
-        assertTrue(mockKlinesSeries.size > 0, "Mock klines series should contain data.")
-
-        // Convert Indexed<RowVec> to List<RowVec> for easier comparison later.
-        val originalKlinesList = mockKlinesSeries.toList()
-
-        // 2. Store the mock klines data to an ISAM file.
-        klinesLoader.storeKlinesToIsam(mockKlinesSeries, testIsamDataPath)
-
-        // 3. Read the klines data back from the ISAM file.
-        // Using a 'use' block to ensure the cursor is closed automatically, if IsamDataFile is Closeable.
-        // Or handle closing in a finally block if not. For simplicity, direct call with try-catch.
-        var readCursor: Cursor? = null
-        try {
-            readCursor = klinesLoader.readKlinesFromIsam(testIsamDataPath, testIsamMetaPath)
-            assertNotNull(readCursor, "Cursor from readKlinesFromIsam should not be null.")
-
-            // 4. Perform assertions on the read data.
-            // Convert the cursor to a list of RowVecs for comparison. This also tests cursor iteration.
-            val readKlinesList = readCursor.toList()
-
-            assertEquals(originalKlinesList.size, readKlinesList.size, "Number of rows read should match original.")
-
-            // Iterate through original and read RowVecs to compare content.
-            for (i in originalKlinesList.indices) {
-                val originalRowVec = originalKlinesList[i]
-                val readRowVec = readKlinesList[i]
-
-                assertEquals(originalRowVec.size, readRowVec.size, "Number of columns in row $i should match.")
-
-                // Compare each cell value within the RowVec.
-                // Assumes klinesRecordMeta order: timestamp, open, high, low, close, volume.
-                for (j in 0 until originalRowVec.size) {
-                    // Values are accessed from Join.a; Join.b provides ColumnMeta lambda.
-                    val originalValue = (originalRowVec.values[j] as? Join<Any?, *>)?.a
-                    val readValue = (readRowVec.values[j] as? Join<Any?, *>)?.a
-
-                    assertNotNull(originalValue, "Original value at [$i][$j] should not be null join component")
-                    assertNotNull(readValue, "Read value at [$i][$j] should not be null join component")
-
-                    if (originalValue is Double && readValue is Double) {
-                        assertEquals(originalValue, readValue, 0.00001, "Double value in row $i, col $j should match.")
-                    } else {
-                        assertEquals(originalValue, readValue, "Value in row $i, col $j should match.")
-                    }
-                }
-            }
-        } catch (e: Exception) {
-            fail("Error during ISAM read or assertion: ${e.message}")
-        } finally {
-            // 5. Ensure the cursor is closed.
