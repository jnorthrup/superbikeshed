-@JvmInline
-value class Volume(val value: Double)
-
-@JvmInline
-value class UnixTimestamp(val millis: Long)
-
-data class OHLC(
-    val open: Price,
-    val high: Price,
-    val low: Price,
-    val close: Price
-) {
-    // Example: How one might convert to/from a Join if that's the Trikeshed pattern.
