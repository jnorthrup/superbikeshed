-    PROOF_OF_STAKE_CONSENSUS,
-    DELEGATED_PROOF_OF_STAKE,
-    FEDERATED_BYZANTINE_AGREEMENT
-}
-
-enum class VotingMechanism {
-    SIMPLE_MAJORITY,
-    SUPERMAJORITY,
-    WEIGHTED_VOTING,
-    STAKE_WEIGHTED,
