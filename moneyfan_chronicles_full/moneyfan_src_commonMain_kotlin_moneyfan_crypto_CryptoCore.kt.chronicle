-    TWO_FACTOR,
-    MULTI_FACTOR,
-    BIOMETRIC,
-    HARDWARE_TOKEN
-}
-
-enum class CryptographicOperation {
-    SIGN,
-    DECRYPT,
-    KEY_DERIVATION,
-    CERTIFICATE_ISSUANCE,
-    REVOCATION
-}
-
-@Serializable
-data class TimeRestriction(
-    val allowedHours: Indexed<Int>?, // Hours of day (0-23)
-    val allowedDays: Indexed<Int>?, // Days of week (1-7)
-    val blackoutPeriods: Indexed<Join<Instant, Instant>>?
-)
-
-@Serializable
-data class MultiPartyApproval(
