-    val verificationDate: Instant,
-    val verifiedBy: StakeholderId,
-    val verificationDetails: VerificationDetails,
-    val trustScore: Decimal, // 0-100
-    val validityPeriod: ValidityPeriod?
-)
-
-sealed interface VerificationTarget {
-    data class SignatureVerification(val signatureId: SignatureId) : VerificationTarget
-    data class EncryptionVerification(val encryptionId: String) : VerificationTarget
-    data class ZKProofVerification(val proofId: String) : VerificationTarget
-    data class CertificateVerification(val certificateId: String) : VerificationTarget
-    data class TrustlessProtocolVerification(val protocolId: String) : VerificationTarget
-}
-
-@Serializable
-data class VerificationDetails(
