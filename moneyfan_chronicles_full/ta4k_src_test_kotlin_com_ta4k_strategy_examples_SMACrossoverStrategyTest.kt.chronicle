-package com.ta4k.strategy.examples
-
-import com.ta4k.core.model.Kline
-import borg.trikeshed.lib.Series // Corrected import
-import com.ta4k.trikeshedutils.toSeries // Planned new location
-import borg.trikeshed.lib.get
-// import com.ta4k.indicators.SMAIndicator // Still not directly used in test logic
-import com.ta4k.trading.entities.OrderType
-import com.ta4k.trading.entities.Position
-import com.ta4k.trading.entities.Order
-import com.ta4k.trading.entities.OrderStatus
-import org.junit.jupiter.api.Test
-import org.junit.jupiter.api.Assertions.*
-import java.math.BigDecimal
-
-class SMACrossoverStrategyTest {
-
-    private fun kline(close: String, idx: Int = 0, high: String = close, low: String = close, open: String = close) = Kline(
-        idx.toLong() * 1000, BigDecimal(open), BigDecimal(high), BigDecimal(low), BigDecimal(close),
-        BigDecimal.ONE, idx.toLong()*1000 + 999, BigDecimal.TEN, 1, BigDecimal.ONE, BigDecimal.ONE
-    )
-
-    @Test
-    fun `BUY signal on golden cross`() {
-        // Prices: 12, 8, 11. Short(1), Long(2). Warmup=2 (up to index 1). Signal check starts at index 2.
-        // Idx 0: k(12)
-        // Idx 1: k(8).   SMA1[0]=12 (not used by strat), SMA2[0]=null.
-        //                SMA1[1]=8, SMA2[1]=(12+8)/2=10.
-        // Idx 2: k(11).  SMA1[2]=11, SMA2[2]=(8+11)/2=9.5.
-        // Signal logic at index 2:
-        // shortSmaPrev (SMA1[1])=8.   longSmaPrev (SMA2[1])=10.  (Prev: 8 < 10 is true)
-        // shortSmaCurr (SMA1[2])=11.  longSmaCurr (SMA2[2])=9.5. (Curr: 11 > 9.5 is true)
-        // Golden Cross: (shortPrev < longPrev && shortCurr > longCurr) -> BUY
-        val testKlines = listOf(
-            kline("12", 0),
-            kline("8", 1),
-            kline("11", 2)
-        ).toIndexed()
-        val strategy = SMACrossoverStrategy(testKlines, 1, 2) // ShortPeriod=1, LongPeriod=2. WarmupPeriod=2.
-
-        val signal = strategy.generateSignal(2, null) // index 2, no current position
-        assertNotNull(signal)
-        assertEquals(OrderType.BUY, signal?.type)
-        assertEquals(testKlines[2].closePrice, signal?.price)
-    }
-
-    @Test
-    fun `SELL signal on death cross when position is open`() {
-        // Prices: 8, 12, 10. Short(1), Long(2). Warmup=2. Signal check starts at index 2.
-        // Idx 0: k(8)
-        // Idx 1: k(12).  SMA1[0]=8, SMA2[0]=null.
-        //                SMA1[1]=12, SMA2[1]=(8+12)/2=10.
-        // Idx 2: k(10).  SMA1[2]=10, SMA2[2]=(12+10)/2=11.
-        // Signal logic at index 2:
-        // shortSmaPrev (SMA1[1])=12.  longSmaPrev (SMA2[1])=10. (Prev: 12 > 10 is true)
-        // shortSmaCurr (SMA1[2])=10.  longSmaCurr (SMA2[2])=11. (Curr: 10 < 11 is true)
-        // Death Cross: (shortPrev > longPrev && shortCurr < longCurr) -> SELL
-        val testKlines = listOf(
-            kline("8",0),
-            kline("12",1),
-            kline("10",2)
-        ).toIndexed()
-        val strategy = SMACrossoverStrategy(testKlines, 1, 2)
-
-        val dummyEntryOrder = Order(1, OrderType.BUY, BigDecimal("100"), BigDecimal("1.0"), status = OrderStatus.FILLED, filledAmount = BigDecimal("1.0"), filledPrice = BigDecimal("12"))
-        val openPosition = Position(dummyEntryOrder, 1, BigDecimal("12"))
-
-        val signal = strategy.generateSignal(2, openPosition) // index 2, position is BUY
-        assertNotNull(signal)
-        assertEquals(OrderType.SELL, signal?.type)
-        assertEquals(testKlines[2].closePrice, signal?.price)
-        assertEquals(openPosition.amount, signal?.amount) // Sell full position
-    }
-
-    @Test
-    fun `no signal if SMAs do not cross`() {
-        // Prices: 10, 11, 12. Short(1), Long(2). Warmup=2. Check at index 2.
-        // Idx 0: k(10)
-        // Idx 1: k(11). SMA1[1]=11, SMA2[1]=10.5
-        // Idx 2: k(12). SMA1[2]=12, SMA2[2]=11.5
-        // Signal at index 2:
-        // shortPrev=11, longPrev=10.5 (11 > 10.5)
-        // shortCurr=12, longCurr=11.5 (12 > 11.5)
-        // No cross. Both are S > L.
-        val testKlines = listOf(kline("10"), kline("11"), kline("12")).toIndexed()
-        val strategy = SMACrossoverStrategy(testKlines, 1, 2)
-        val signal = strategy.generateSignal(2, null)
-        assertNull(signal)
-    }
-
-    @Test
-    fun `no signal if index is less than warmupPeriod`() {
-        val testKlines = listOf(kline("12"), kline("8"), kline("11")).toIndexed()
-        val strategy = SMACrossoverStrategy(testKlines, 1, 2) // Warmup = 2. Indices 0, 1 are warmup.
-        val signal = strategy.generateSignal(1, null) // Index 1 is < warmupPeriod (signals start from index 2)
-        assertNull(signal)
-    }
-
-    @Test
-    fun `no signal if SMAs are null (within warmup or insufficient history for SMA)`() {
-        // Short(2), Long(3). Warmup = 3. Signals start at index 3.
-        // Kline prices for SMAs at index 2 (to check signal at index 2):
-        // SMA(2) needs klines[1], klines[2]
-        // SMA(3) needs klines[0], klines[1], klines[2]
-        // If we check at index 2 (which is < warmupPeriod=3), SMAs might be null.
-        val testKlines = listOf(kline("10",0), kline("11",1), kline("12",2)).toIndexed()
-        val strategy = SMACrossoverStrategy(testKlines, 2, 3)
-
-        // Test signal at index 2 (which is period-1 for the LongSMA, so LongSMA will be null)
-        // longSma.getValue(2) will be null because period is 3, needs 3 values, has only index 0,1,2
-        // longSma.getValue(1) will be null.
-        // shortSma.getValue(2) might be non-null. shortSma.getValue(1) might be non-null.
-        val signal = strategy.generateSignal(2, null)
-        assertNull(signal, "Signal should be null if any SMA value is null")
-    }
-}
