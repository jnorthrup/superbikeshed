--- Commit: 2869bf0c70c963a5abace6690b551c36d43dcd26 | 2025-06-23 19:15:00 -0400 ---
diff --git a/moneyfan/src/commonMain/kotlin/moneyfan/trikeshed/scope/NlpScopes.kt b/moneyfan/src/commonMain/kotlin/moneyfan/trikeshed/scope/NlpScopes.kt
deleted file mode 100644
index 31aa655f..00000000
--- a/moneyfan/src/commonMain/kotlin/moneyfan/trikeshed/scope/NlpScopes.kt
+++ /dev/null
@@ -1,242 +0,0 @@
-package moneyfan.trikeshed.scope
-
-import moneyfan.trikeshed.Series
-import moneyfan.trikeshed.j // For Series construction
-import moneyfan.trikeshed.emptySeries
-import moneyfan.trikeshed.toSeries
-// Imports for the NlpAgent and RQL model from the correct 'nlp' package
-import moneyfan.trikeshed.nlp.NlpAgent
-import moneyfan.trikeshed.nlp.HybridNlpAgentPoc // Default agent for HumanLanguageAgentScope
-import moneyfan.trikeshed.nlp.rql.*
-
-// The NlpAgent interface and MockNlpAgent that were here previously are removed,
-// as HumanLanguageAgentScope now uses the NlpAgent from the moneyfan.trikeshed.nlp package.
-
-// --- RQL Filtering Logic (Internal Helpers for HumanLanguageAgentScope) ---
-
-/**
- * Evaluates if a single item's fields satisfy a given [RqlCondition].
- *
- * This is a simplified RQL condition interpreter, primarily for the Proof-of-Concept
- * [HumanLanguageAgentScope]. It supports basic comparisons, null checks, string containment,
- * numeric range checks (BETWEEN), and list membership (IN).
- *
- * @param condition The [RqlCondition] to evaluate.
- * @param itemFields A map representing the item, where keys are attribute names and values are
- *                   the corresponding attribute values.
- * @return `true` if the item's fields satisfy the condition; `false` otherwise.
- *         Returns `false` for unhandled operators or type mismatches that prevent comparison.
- */
-private fun evaluateCondition(condition: RqlCondition, itemFields: Map<String, Any?>): Boolean {
-    val fieldValue = itemFields[condition.attribute.name]
-
-    // Handle IS_NULL and IS_NOT_NULL first as they don't require fieldValue to be non-null.
-    if (condition.operator == RqlOperator.IS_NULL) return fieldValue == null
-    if (condition.operator == RqlOperator.IS_NOT_NULL) return fieldValue != null
-
-    // For most other operators, if fieldValue is null, it typically cannot satisfy the condition,
-    // unless the condition itself is checking for equality/inequality with a literal null.
-    if (fieldValue == null && !(condition.value == null && (condition.operator == RqlOperator.EQUALS || condition.operator == RqlOperator.NOT_EQUALS))) {
-        return false // Field is null, but condition isn't explicitly checking for null equality/inequality.
-    }
-
-    val conditionValue = condition.value
-
-    return when (condition.operator) {
-        RqlOperator.EQUALS -> fieldValue == conditionValue
-        RqlOperator.NOT_EQUALS -> fieldValue != conditionValue
-        // For comparisons, attempt to treat as Double if possible.
-        RqlOperator.GREATER_THAN -> compareValues(fieldValue, conditionValue) > 0
-        RqlOperator.LESS_THAN -> compareValues(fieldValue, conditionValue) < 0
-        RqlOperator.GREATER_THAN_OR_EQUALS -> compareValues(fieldValue, conditionValue) >= 0
-        RqlOperator.LESS_THAN_OR_EQUALS -> compareValues(fieldValue, conditionValue) <= 0
-        RqlOperator.CONTAINS ->
-            (fieldValue is String && conditionValue is String && fieldValue.contains(conditionValue, ignoreCase = true))
-        RqlOperator.NOT_CONTAINS ->
-            (fieldValue is String && conditionValue is String && !fieldValue.contains(conditionValue, ignoreCase = true))
-        RqlOperator.BETWEEN -> {
-            // Expects conditionValue to be Pair<Number, Number> or List<Number>[2] from parser.
-            val rangePair = when (conditionValue) {
-                is Pair<*, *> -> if (conditionValue.first is Number && conditionValue.second is Number)
-                                    Pair(conditionValue.first as Number, conditionValue.second as Number) else null
-                is List<*> -> if (conditionValue.size == 2 && conditionValue[0] is Number && conditionValue[1] is Number)
-                                    Pair(conditionValue[0] as Number, conditionValue[1] as Number) else null
-                else -> null
-            }
-            if (rangePair != null && fieldValue is Number) {
-                fieldValue.toDouble() >= rangePair.first.toDouble() && fieldValue.toDouble() <= rangePair.second.toDouble()
-            } else false
-        }
-        RqlOperator.IN -> (conditionValue as? List<*>)?.contains(fieldValue) ?: false
-        RqlOperator.NOT_IN -> !((conditionValue as? List<*>)?.contains(fieldValue) ?: false)
-        // IS_NULL and IS_NOT_NULL are handled above.
-        // Default for unhandled or mismatched types for specific operators.
-        else -> false
-    }
-}
-
-/**
- * Compares two values, `v1` and `v2`.
- * Primarily designed for numeric (Double) and string comparisons.
- * For PoC, if types are mixed beyond Number/String, it attempts toString comparison or relies on basic equality.
- *
- * @return An integer less than, equal to, or greater than zero if `v1` is less than, equal to, or greater than `v2`.
- */
-private fun compareValues(v1: Any?, v2: Any?): Int {
-    if (v1 is Number && v2 is Number) {
-        return v1.toDouble().compareTo(v2.toDouble())
-    }
-    if (v1 is String && v2 is String) {
-        return v1.compareTo(v2, ignoreCase = true) // Case-insensitive for string comparison in RQL
-    }
-    // Fallback for other types or mixed types (simplified for PoC)
-    if (v1 == v2) return 0
-    return when {
-        v1 == null -> -1 // Consistent ordering: nulls first
-        v2 == null -> 1
-        else -> v1.toString().compareTo(v2.toString(), ignoreCase = true) // Last resort: string representation
-    }
-}
-
-/**
- * Recursively evaluates an [RqlQueryNode] (either simple or compound) against an item's fields.
- * This forms the core of the RQL interpreter for this PoC.
- *
- * @param node The [RqlQueryNode] to evaluate.
- * @param itemFields A map (`String` to `Any?`) representing the fields of the item being evaluated.
- * @return `true` if the item satisfies the query node's conditions, `false` otherwise.
- */
-private fun evaluateNode(node: RqlQueryNode, itemFields: Map<String, Any?>): Boolean {
-    return when (node) {
-        is RqlSimpleQuery -> evaluateCondition(node.condition, itemFields)
-        is RqlCompoundQuery -> {
-            when (node.operator) {
-                RqlLogicalOperator.AND -> node.subQueries.all { subQuery -> evaluateNode(subQuery, itemFields) }
-                RqlLogicalOperator.OR -> node.subQueries.any { subQuery -> evaluateNode(subQuery, itemFields) }
-            }
-        }
-    }
-}
-
-/**
- * An [AttentionScope] that leverages an [NlpAgent] to perform hybrid filtering.
- * It combines structured query evaluation (RQL) with semantic relevance scoring.
- *
- * **Process Flow:**
- * 1.  The provided `nlpQuery` (natural language) is sent to the `agent`.
- * 2.  The `agent` returns an [NlpAgentResult], which includes:
- *     a.  An optional `structuredQuery` ([RqlRootQuery]) parsed from `nlpQuery`.
- *     b.  `relevanceScores` ([Indexed<Double>]) for all items in the source series,
- *         derived from `nlpQuery` and `itemToStringConverter`.
- * 3.  If `structuredQuery` is present, the initial `source` series is filtered based on this RQL query
- *     using `itemToFieldsExtractor` to access item properties.
- * 4.  The items that passed the RQL filter (or all items if no RQL query was parsed) are then
- *     further filtered based on their `relevanceScores`. Only items with a score greater than
- *     or equal to `semanticScoreThreshold` are retained.
- *
- * This is a **Proof-of-Concept (PoC)** implementation.
- *
- * @param T The type of elements in the source [Series].
- * @property nlpQuery The natural language query string that drives both RQL parsing and semantic scoring.
- * @property itemToStringConverter A lambda `(T) -> String` that converts items of type `T` into their
- *                                 string representation. This is used by the [NlpAgent] for semantic scoring.
- * @property itemToFieldsExtractor A lambda `(T) -> Map<String, Any?>` that converts items of type `T`
- *                                 into a map of their field names to values. This is used for evaluating
- *                                 conditions in the parsed RQL query.
- * @property semanticScoreThreshold A [Double] between 0.0 and 1.0. Items that pass the RQL filter (if any)
- *                                  must also have a semantic relevance score greater than or equal to this
- *                                  threshold to be included in the final focused series. Defaults to `0.5`.
- * @property agent The [NlpAgent] instance used for processing `nlpQuery`. Defaults to [HybridNlpAgentPoc],
- *                 which uses [SimpleRqlParser][moneyfan.trikeshed.nlp.parser.SimpleRqlParser] and a basic keyword scorer.
- * @throws IllegalArgumentException if `semanticScoreThreshold` is not between 0.0 and 1.0.
- */
-data class HumanLanguageAgentScope<T>(
-    val nlpQuery: String,
-    val itemToStringConverter: (T) -> String,
-    val itemToFieldsExtractor: (T) -> Map<String, Any?>,
-    val semanticScoreThreshold: Double = 0.5,
-    private val agent: NlpAgent = HybridNlpAgentPoc()
-) : AttentionScope<T> {
-
-    init {
-        require(semanticScoreThreshold >= 0.0 && semanticScoreThreshold <= 1.0) {
-            "semanticScoreThreshold must be between 0.0 and 1.0 (inclusive), got $semanticScoreThreshold."
-        }
-    }
-
-    /**
-     * Applies the hybrid (RQL + semantic) filtering logic to the `source` [Series].
-     *
-     * @param source The input [Indexed<T>] to be filtered.
-     * @return A new [Indexed<T>] containing items that satisfy both the parsed RQL query (if any)
-     *         and the semantic score threshold. Returns an empty series if no items match or if the source is empty.
-     */
-    override fun apply(source: Indexed<T>): Indexed<T> {
-        if (source.isEmpty()) return emptySeries()
-
-        // 1. Convert source Indexed<T> to Indexed<String> for the NLP agent's semantic scoring part.
-        val stringSeries = source.a j { idx:Int -> itemToStringConverter(source.b(idx)) }
-
-        // This check is mostly defensive, assuming itemToStringConverter is well-behaved.
-        if (stringSeries.isEmpty() && source.isNotEmpty()) return emptySeries()
-
-        // 2. Process the query using the NlpAgent to get RQL and semantic scores.
-        // For this PoC, NlpAgent.processQuery is non-suspend.
-        val nlpResult = agent.processQuery(nlpQuery, stringSeries)
-
-        // Ensure scores series aligns with the source series for reliable lookup.
-        if (nlpResult.relevanceScores.a != source.a) {
-            println("Warning: Relevance score series size (${nlpResult.relevanceScores.a}) from NlpAgent " +
-                    "does not match source series size (${source.a}). Aborting HumanLanguageAgentScope application.")
-            return emptySeries()
-        }
-
-        // 3. Prepare a list of items along with their original index and semantic score.
-        // This allows us to apply RQL filtering and then use the pre-calculated semantic scores.
-        val itemsWithContext = mutableListOf<Triple<T, Int, Double>>()
-        for (i in 0 until source.a) {
-            itemsWithContext.add(Triple(source.b(i), i, nlpResult.relevanceScores.b(i)))
-        }
-
-        // 4. Apply RQL filter (if a structured query was parsed by the agent).
-        val rqlFilteredItemsWithContext: List<Triple<T, Int, Double>> =
-            if (nlpResult.structuredQuery != null) {
-                itemsWithContext.filter { (item, /* originalIndex */ _, /* semanticScore */ _) ->
-                    val itemFields = itemToFieldsExtractor(item)
-                    evaluateNode(nlpResult.structuredQuery.queryNode, itemFields)
-                }
-            } else {
-                itemsWithContext // No RQL query, so all items pass this stage.
-            }
-
-        // 5. Apply semantic score threshold filter to the (potentially RQL-filtered) items.
-        val finalFilteredItems = rqlFilteredItemsWithContext
-            .filter { (_, _, score) -> score >= semanticScoreThreshold }
-            .map { (item, _, _) -> item } // Extract only the item of type T for the result.
-
-        // 6. Construct the result Indexed<T>.
-        if (finalFilteredItems.isEmpty()) return emptySeries()
-        return finalFilteredItems.toIndexed()
-    }
-
-    /**
-     * Returns a [Indexed<Int>] of indices selected by this scope.
-     * **Proof-of-Concept Limitation:** This method is a placeholder for `HumanLanguageAgentScope`.
-     * A full implementation would require access to the source data (or its string representations
-     * and field maps) to perform both RQL evaluation and NLP scoring, which are not available
-     * when only `sourceSize` is provided.
-     * Thus, for this PoC, it prints a warning and returns an empty series.
-     * The primary way to use this scope in its PoC form is via the [apply] method.
-     *
-     * @param sourceSize The size of the conceptual source series.
-     * @return An [emptySeries] for this PoC implementation.
-     */
-    override fun getScopedIndices(sourceSize: Int): Indexed<Int> {
-        if (sourceSize == 0) return emptySeries()
-
-        println("Warning: HumanLanguageAgentScope.getScopedIndices is a PoC placeholder and does not produce " +
-                "meaningful indices without source data for NLP scoring and RQL evaluation. " +
-                "Use apply() instead. Returning empty series.")
-        return emptySeries()
-    }
-}
