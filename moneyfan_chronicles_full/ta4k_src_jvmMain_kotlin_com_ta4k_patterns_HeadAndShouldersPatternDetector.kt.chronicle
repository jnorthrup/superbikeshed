diff --git a/ta4k/src/jvmMain/kotlin/com/ta4k/patterns/HeadAndShouldersPatternDetector.kt b/ta4k/src/jvmMain/kotlin/com/ta4k/patterns/HeadAndShouldersPatternDetector.kt
