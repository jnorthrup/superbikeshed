-                }
-                
-                avgGains[i] = sumGains.divide(periodBigDecimal, calculationScale, RoundingMode.HALF_UP)
-                avgLosses[i] = sumLosses.divide(periodBigDecimal, calculationScale, RoundingMode.HALF_UP)
-                
-                // Calculate first RSI
