-
-            val gain = if (priceChange > BigDecimal.ZERO) priceChange else BigDecimal.ZERO
-            val loss = if (priceChange < BigDecimal.ZERO) priceChange.abs() else BigDecimal.ZERO
-
-            if (i < period) {
-                // First period: store raw gains/losses
-                avgGains[i] = gain
-                avgLosses[i] = loss
-                results[i] = null
-            } else if (i == period) {
