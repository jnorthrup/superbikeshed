-/**
- * Trust operations
- */
-object TrustOperations {
-    
-    /**
-     * Create a revocable trust
-     */
-    fun createRevocableTrust(
-        name: String,
-        settlor: Settlor,
-        trustees: Indexed<Trustee>,
-        beneficiaries: Indexed<TrustBeneficiary>,
-        jurisdiction: JurisdictionCode
-    ): Trust {
-        val entityId = EntityOperations.generateEntityId(EntityType.REVOCABLE_TRUST, jurisdiction)
-        
-        return Trust(
-            id = entityId,
-            name = name,
-            status = EntityStatus.FORMING,
-            jurisdiction = jurisdiction,
-            taxId = null,
-            formationDate = kotlinx.datetime.Clock.System.now(),
-            dissolutionDate = null,
-            trustType = TrustType.Revocable(
-                revocableBySettlor = true,
-                amendableBySettlor = true
-            ),
-            settlor = settlor,
-            trustees = trustees,
-            beneficiaries = beneficiaries,
-            trustDocument = createDefaultTrustDocument(),
-            assets = emptyIndex(),
-            distributions = emptyIndex(),
-            taxTreatment = TrustTaxTreatment(
-                treatmentType = TrustTaxTreatmentType.GRANTOR_TRUST,
-                taxYear = "calendar",
-                distributionDeductionElection = false,
-                fiscal_year_election = false
-            ),
-            administrativeInfo = TrustAdministrativeInfo(
-                administrativeAddress = BusinessAddress("", "", "", "", ""),
-                trustAccountNumber = null,
-                investmentAdvisor = null,
-                legalCounsel = null,
-                accountant = null
-            ),
-            fiduciaryDuties = createDefaultFiduciaryDuties(),
-            investmentPolicy = null,
-            charitablePurpose = null
-        )
-    }
-    
-    /**
-     * Create default trust document
-     */
-    private fun createDefaultTrustDocument(): TrustDocument {
-        return TrustDocument(
-            executionDate = kotlinx.datetime.Clock.System.now(),
-            amendmentDates = null,
-            purpose = TrustPurpose(
-                primaryPurpose = "Family wealth management and distribution",
-                specificObjectives = 2 j { i ->
-                    if (i == 0) "Provide for beneficiary support" else "Preserve family wealth"
-                },
-                charitablePurpose = null
-            ),
-            term = TrustTerm.Perpetual,
-            distributionProvisions = DistributionProvisions(
-                incomeDistribution = IncomeDistributionRule.TRUSTEE_DISCRETION,
-                principalDistribution = PrincipalDistributionRule.TRUSTEE_DISCRETION,
-                mandatoryDistributions = null,
-                distributionFrequency = DistributionFrequency.AT_DISCRETION
-            ),
-            investmentProvisions = InvestmentProvisions(
-                investmentObjective = InvestmentObjective.BALANCED,
-                allowedInvestments = 3 j { i ->
-                    when (i) {
-                        0 -> "Stocks and bonds"
-                        1 -> "Real estate"
-                        else -> "Cash equivalents"
-                    }
-                },
-                prohibitedInvestments = null,
-                riskTolerance = InvestmentRiskLevel.MODERATE,
-                socialInvestingGuidelines = null
-            ),
-            administrativeProvisions = AdministrativeProvisions(
-                accountingStandard = AccountingStandard.TRUST_ACCOUNTING_INCOME,
-                reportingRequirements = ReportingRequirements(
-                    beneficiaryReports = true,
-                    frequency = ReportingFrequency.ANNUALLY,
-                    courtReportsRequired = false
-                ),
-                recordKeepingRequirements = "Maintain detailed records of all transactions",
-                professionalServicesAuthorization = true
-            ),
-            terminationProvisions = TerminationProvisions(
-                terminationEvents = 1 j {
-                    TerminationEvent(
-                        eventType = TerminationEventType.CONSENT_OF_PARTIES,
-                        description = "Termination by consent of settlor and beneficiaries",
-                        date = null
-                    )
-                },
-                distributionUponTermination = TerminationDistribution(
-                    distributionMethod = TerminationDistributionMethod.PRO_RATA,
-                    remainderBeneficiaries = emptyIndex(),
-                    charitableBeneficiary = null
-                )
-            ),
-            spendthriftProvisions = SpendthriftProvisions(
