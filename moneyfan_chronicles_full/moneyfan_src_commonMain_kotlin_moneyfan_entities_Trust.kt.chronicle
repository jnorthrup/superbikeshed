-package moneyfan.entities
-
-import borg.trikeshed.lib.*
-import kotlinx.datetime.Instant
-import kotlinx.serialization.Serializable
-import moneyfan.core.Price
-import moneyfan.core.Decimal
-
-/**
- * ## Trust Implementation
- * 
- * A Trust is a fiduciary arrangement where a trustee holds legal title to assets
- * for the benefit of beneficiaries. Trusts can be revocable or irrevocable,
- * and serve various purposes including estate planning, tax optimization,
- * asset protection, and charitable giving.
- */
-
-/**
- * Trust entity
- */
-@Serializable
-data class Trust(
-    override val id: EntityId,
-    override val name: String,
-    override val status: EntityStatus,
-    override val jurisdiction: JurisdictionCode,
-    override val taxId: TaxId?,
-    override val formationDate: Instant,
-    override val dissolutionDate: Instant?,
-    val trustType: TrustType,
-    val settlor: Settlor,
-    val trustees: Indexed<Trustee>,
-    val beneficiaries: Indexed<TrustBeneficiary>,
-    val trustDocument: TrustDocument,
-    val assets: Indexed<TrustAsset>,
-    val distributions: Indexed<TrustDistribution>,
-    val taxTreatment: TrustTaxTreatment,
-    val administrativeInfo: TrustAdministrativeInfo,
-    val fiduciaryDuties: Indexed<TrustFiduciaryDuty>,
-    val investmentPolicy: TrustInvestmentPolicy?,
-    val charitablePurpose: CharitablePurpose?
-) : LegalEntity {
-    
-    override val type: EntityType = when (trustType) {
-        is TrustType.Revocable -> EntityType.REVOCABLE_TRUST
-        is TrustType.Irrevocable -> EntityType.IRREVOCABLE_TRUST
-        is TrustType.Charitable -> EntityType.CHARITABLE_TRUST
-    }
-    
-    override fun computeNetWorth(): Price {
-        val totalAssets = assets.play.sumOf { it.currentValue.value }
-        return Price(totalAssets)
-    }
-    
-    override fun getBeneficiaries(): Indexed<Beneficiary> {
-        return beneficiaries.size j { i ->
-            val trustBeneficiary = beneficiaries[i]
-            Beneficiary(
-                id = trustBeneficiary.id,
-                name = trustBeneficiary.name,
-                entityId = id,
-                beneficialInterest = trustBeneficiary.interestPercentage,
-                distributionRights = trustBeneficiary.distributionRights,
-                votingRights = null, // Typically no voting rights
-                restrictions = trustBeneficiary.restrictions
-            )
-        }
-    }
-    
-    override fun canPerformAction(action: EntityAction): Boolean {
-        return when (action) {
-            is EntityAction.Distribution -> canMakeDistribution(action)
-            is EntityAction.OwnershipTransfer -> false // Trust assets are held by trustee
-            is EntityAction.StatusChange -> canChangeStatus(action)
-            is EntityAction.TaxElection -> canMakeTaxElection(action)
-            else -> false
-        }
-    }
-    
-    override fun getTaxTreatment(): TaxStatus {
-        return when (taxTreatment.treatmentType) {
-            TrustTaxTreatmentType.GRANTOR_TRUST -> TaxStatus.PASS_THROUGH
-            TrustTaxTreatmentType.SIMPLE_TRUST -> TaxStatus.SPECIAL
-            TrustTaxTreatmentType.COMPLEX_TRUST -> TaxStatus.SPECIAL
-            TrustTaxTreatmentType.CHARITABLE_TRUST -> TaxStatus.EXEMPT
-        }
-    }
-    
-    private fun canMakeDistribution(action: EntityAction.Distribution): Boolean {
-        val beneficiary = beneficiaries.play.find { it.id == action.beneficiaryId }
-            ?: return false
-        
-        // Check trust document provisions
-        if (!trustDocument.distributionProvisions.allowsDistribution(action.amount, beneficiary)) {
-            return false
-        }
-        
-        // Check trustee discretion
-        return when (beneficiary.distributionStandard) {
-            DistributionStandard.MANDATORY -> true
-            DistributionStandard.SUPPORT -> isForSupport(action)
-            DistributionStandard.DISCRETIONARY -> hasProperDiscretion(action)
-            DistributionStandard.HEMS -> isForHEMS(action)
-        }
-    }
-    
-    private fun canChangeStatus(action: EntityAction.StatusChange): Boolean {
-        return when (action.toStatus) {
-            EntityStatus.DISSOLVED -> {
-                trustDocument.terminationProvisions.canTerminate(this)
-            }
-            EntityStatus.ACTIVE -> status == EntityStatus.FORMING
-            else -> false
-        }
-    }
-    
-    private fun canMakeTaxElection(action: EntityAction.TaxElection): Boolean {
-        return when (trustType) {
-            is TrustType.Revocable -> true // Can elect various tax treatments
-            is TrustType.Irrevocable -> action.electionType in trustType.allowedElections
-            is TrustType.Charitable -> false // Tax treatment fixed
-        }
-    }
-    
-    private fun isForSupport(action: EntityAction.Distribution): Boolean {
-        // Check if distribution is for beneficiary's support, health, education, maintenance
-        return true // Placeholder - would analyze purpose
-    }
-    
-    private fun hasProperDiscretion(action: EntityAction.Distribution): Boolean {
-        // Check if trustee has properly exercised discretion
-        return true // Placeholder - would check trustee documentation
-    }
-    
-    private fun isForHEMS(action: EntityAction.Distribution): Boolean {
-        // Check if distribution is for Health, Education, Maintenance, Support
-        return true // Placeholder - would analyze purpose
-    }
-}
-
-/**
- * Trust types
- */
-sealed interface TrustType {
-    data class Revocable(
-        val revocableBySettlor: Boolean,
-        val amendableBySettlor: Boolean
-    ) : TrustType
-    
-    data class Irrevocable(
-        val allowedElections: Set<String>,
-        val assetProtectionFeatures: Boolean
-    ) : TrustType
-    
-    data class Charitable(
-        val charitableType: CharitableTrustType,
-        val exemptStatus: ExemptStatus?
-    ) : TrustType
-}
-
-enum class CharitableTrustType {
-    CHARITABLE_REMAINDER_TRUST,
-    CHARITABLE_LEAD_TRUST,
-    POOLED_INCOME_FUND,
-    CHARITABLE_GIFT_ANNUITY,
-    PRIVATE_FOUNDATION
-}
-
-/**
- * Settlor (creator of the trust)
- */
-@Serializable
-data class Settlor(
-    val id: StakeholderId,
-    val name: String,
-    val livingStatus: Boolean,
-    val reservedPowers: Indexed<SettlorPower>?,
-    val relationship: SettlorRelationship
-)
-
-enum class SettlorPower {
-    REVOKE_TRUST,
-    AMEND_TRUST,
-    REPLACE_TRUSTEE,
-    CHANGE_BENEFICIARIES,
-    REVERT_ASSETS,
-    CONTROL_DISTRIBUTIONS
-}
-
-enum class SettlorRelationship {
-    INDIVIDUAL,
-    MARRIED_COUPLE,
-    ENTITY_SETTLOR
-}
-
-/**
- * Trustee
- */
-@Serializable
-data class Trustee(
-    val id: StakeholderId,
-    val name: String,
-    val trusteeType: TrusteeType,
-    val appointmentDate: Instant,
-    val terminationDate: Instant?,
-    val powers: Indexed<TrusteePower>,
-    val limitations: Indexed<TrusteeLimitation>?,
-    val compensation: TrusteeCompensation?,
-    val bond: AdministratorBond?,
-    val successor: SuccessorTrustee?
-)
-
-enum class TrusteeType {
-    INDIVIDUAL,
-    CORPORATE_TRUSTEE,
-    CO_TRUSTEES,
-    SUCCESSOR_TRUSTEE,
-    CONTINGENT_TRUSTEE
-}
-
-enum class TrusteePower {
-    INVEST_ASSETS,
-    SELL_ASSETS,
-    DISTRIBUTE_INCOME,
-    DISTRIBUTE_PRINCIPAL,
-    BORROW_MONEY,
-    HIRE_PROFESSIONALS,
-    MAKE_TAX_ELECTIONS,
-    SETTLE_CLAIMS,
-    CONTINUE_BUSINESS,
-    DELEGATE_AUTHORITY
-}
-
-sealed interface TrusteeLimitation {
-    data class InvestmentRestrictions(val restrictions: Indexed<String>) : TrusteeLimitation
-    data class DistributionLimitations(val limitations: String) : TrusteeLimitation
-    data class RequiredConsent(val consentRequired: Set<StakeholderId>) : TrusteeLimitation
-    data class CoTrusteeApproval(val requiredActions: Set<TrusteePower>) : TrusteeLimitation
-}
-
-@Serializable
-data class TrusteeCompensation(
-    val compensationType: TrusteeCompensationType,
-    val amount: Price?,
-    val percentage: Decimal?,
-    val frequency: CompensationFrequency
-)
-
-enum class TrusteeCompensationType {
-    FIXED_FEE,
-    PERCENTAGE_OF_ASSETS,
-    PERCENTAGE_OF_INCOME,
-    HOURLY_RATE,
-    COURT_DETERMINED,
-    WAIVED
-}
-
-enum class CompensationFrequency {
-    MONTHLY,
-    QUARTERLY,
-    ANNUALLY,
-    UPON_TERMINATION
-}
-
-@Serializable
-data class SuccessorTrustee(
-    val id: StakeholderId,
-    val name: String,
-    val successionTrigger: SuccessionTrigger,
-    val automaticSuccession: Boolean
-)
-
-enum class SuccessionTrigger {
-    DEATH,
-    INCAPACITY,
-    RESIGNATION,
-    REMOVAL,
-    CORPORATE_DISSOLUTION
-}
-
-/**
- * Trust beneficiary
- */
-@Serializable
-data class TrustBeneficiary(
-    val id: BeneficiaryId,
-    val name: String,
-    val beneficiaryClass: BeneficiaryClass,
-    val distributionStandard: DistributionStandard,
-    val interestType: InterestType,
-    val interestPercentage: Decimal,
-    val distributionRights: DistributionRights,
-    val restrictions: Indexed<BeneficiaryRestriction>?,
-    val vestingSchedule: VestingSchedule?,
-    val powerOfAppointment: PowerOfAppointment?
-)
-
-enum class BeneficiaryClass {
-    INCOME_BENEFICIARY,
-    REMAINDER_BENEFICIARY,
-    CURRENT_BENEFICIARY,
-    CONTINGENT_BENEFICIARY,
-    PERMISSIBLE_DISTRIBUTEE
-}
-
-enum class DistributionStandard {
-    MANDATORY,        // Must distribute
-    SUPPORT,          // For support only
-    DISCRETIONARY,    // Full discretion
-    HEMS             // Health, Education, Maintenance, Support
-}
-
-enum class InterestType {
-    INCOME_INTEREST,
-    REMAINDER_INTEREST,
-    PARTIAL_INTEREST,
-    CONTINGENT_INTEREST,
-    CHARITABLE_INTEREST
-}
-
-@Serializable
-data class VestingSchedule(
-    val vestingType: VestingType,
-    val vestingEvents: Indexed<VestingEvent>
-)
-
-enum class VestingType {
-    IMMEDIATE,
-    AGE_BASED,
-    TIME_BASED,
-    EVENT_BASED,
-    PERFORMANCE_BASED
-}
-
-@Serializable
-data class VestingEvent(
-    val eventType: String,
-    val percentage: Decimal,
-    val date: Instant?
-)
-
-@Serializable
-data class PowerOfAppointment(
-    val appointmentType: AppointmentType,
-    val appointableProperty: Decimal, // Percentage
-    val permissibleAppointees: AppointmentScope,
-    val exerciseRequirements: Indexed<String>
-)
-
-enum class AppointmentType {
-    GENERAL_POWER,
-    LIMITED_POWER,
-    SPECIAL_POWER,
-    TESTAMENTARY_POWER
-}
-
-enum class AppointmentScope {
-    ANYONE,
-    FAMILY_ONLY,
-    CHARITIES_ONLY,
-    SPECIFIC_INDIVIDUALS
-}
-
-/**
- * Trust document
- */
-@Serializable
-data class TrustDocument(
-    val executionDate: Instant,
-    val amendmentDates: Indexed<Instant>?,
-    val purpose: TrustPurpose,
-    val term: TrustTerm,
-    val distributionProvisions: DistributionProvisions,
-    val investmentProvisions: InvestmentProvisions,
-    val administrativeProvisions: AdministrativeProvisions,
-    val terminationProvisions: TerminationProvisions,
-    val spendthriftProvisions: SpendthriftProvisions?
-)
-
-@Serializable
-data class TrustPurpose(
-    val primaryPurpose: String,
-    val specificObjectives: Indexed<String>,
-    val charitablePurpose: String?
-)
-
-sealed interface TrustTerm {
-    data object Perpetual : TrustTerm
-    data class FixedTerm(val years: Int) : TrustTerm
-    data class LifetimeTerm(val measuring_lives: Indexed<StakeholderId>) : TrustTerm
-    data class EventBased(val terminatingEvent: String) : TrustTerm
-}
-
-@Serializable
-data class DistributionProvisions(
-    val incomeDistribution: IncomeDistributionRule,
-    val principalDistribution: PrincipalDistributionRule,
-    val mandatoryDistributions: Indexed<MandatoryDistribution>?,
-    val distributionFrequency: DistributionFrequency
-) {
-    fun allowsDistribution(amount: Price, beneficiary: TrustBeneficiary): Boolean {
-        return when (beneficiary.distributionStandard) {
-            DistributionStandard.MANDATORY -> true
-            DistributionStandard.DISCRETIONARY -> true
-            else -> amount.value <= 100000.0 // Placeholder logic
-        }
-    }
-}
-
-enum class IncomeDistributionRule {
-    DISTRIBUTE_ALL,
-    ACCUMULATE_ALL,
-    TRUSTEE_DISCRETION,
-    PERCENTAGE_DISTRIBUTION
-}
-
-enum class PrincipalDistributionRule {
-    NO_DISTRIBUTIONS,
-    TRUSTEE_DISCRETION,
-    SPECIFIC_PURPOSES,
-    AGE_DISTRIBUTIONS
-}
-
-@Serializable
-data class MandatoryDistribution(
-    val beneficiaryId: BeneficiaryId,
-    val amount: Price?,
-    val percentage: Decimal?,
-    val trigger: DistributionTrigger
-)
-
-enum class DistributionTrigger {
-    AGE_ATTAINMENT,
-    GRADUATION,
-    MARRIAGE,
-    ANNUAL_DATE,
-    INCOME_THRESHOLD
-}
-
-enum class DistributionFrequency {
-    MONTHLY,
-    QUARTERLY,
-    ANNUALLY,
-    UPON_REQUEST,
-    AT_DISCRETION
-}
-
-@Serializable
-data class InvestmentProvisions(
-    val investmentObjective: InvestmentObjective,
-    val allowedInvestments: Indexed<String>,
-    val prohibitedInvestments: Indexed<String>?,
-    val riskTolerance: InvestmentRiskLevel,
-    val socialInvestingGuidelines: String?
-)
-
-enum class InvestmentObjective {
-    PRESERVE_CAPITAL,
-    GENERATE_INCOME,
-    GROWTH,
-    BALANCED,
-    AGGRESSIVE_GROWTH
-}
-
-@Serializable
-data class AdministrativeProvisions(
-    val accountingStandard: AccountingStandard,
-    val reportingRequirements: ReportingRequirements,
-    val recordKeepingRequirements: String,
-    val professionalServicesAuthorization: Boolean
-)
-
-enum class AccountingStandard {
-    CASH_BASIS,
-    ACCRUAL_BASIS,
-    TRUST_ACCOUNTING_INCOME,
-    TAX_BASIS
-}
-
-@Serializable
-data class ReportingRequirements(
-    val beneficiaryReports: Boolean,
-    val frequency: ReportingFrequency,
-    val courtReportsRequired: Boolean
-)
-
-@Serializable
-data class TerminationProvisions(
-    val terminationEvents: Indexed<TerminationEvent>,
-    val distributionUponTermination: TerminationDistribution
-) {
-    fun canTerminate(trust: Trust): Boolean {
-        return terminationEvents.play.any { event ->
-            when (event.eventType) {
-                TerminationEventType.ASSETS_EXHAUSTED -> trust.computeNetWorth().value <= 1000.0
-                TerminationEventType.PURPOSE_FULFILLED -> true // Would check specific purpose
-                TerminationEventType.FIXED_DATE -> kotlinx.datetime.Clock.System.now() > event.date!!
-                else -> false
-            }
-        }
-    }
-}
-
-@Serializable
-data class TerminationEvent(
-    val eventType: TerminationEventType,
-    val description: String,
-    val date: Instant?
-)
-
-enum class TerminationEventType {
-    FIXED_DATE,
-    BENEFICIARY_DEATH,
-    PURPOSE_FULFILLED,
-    ASSETS_EXHAUSTED,
-    CONSENT_OF_PARTIES,
-    COURT_ORDER
-}
-
-@Serializable
-data class TerminationDistribution(
-    val distributionMethod: TerminationDistributionMethod,
-    val remainderBeneficiaries: Indexed<Join<BeneficiaryId, Decimal>>,
-    val charitableBeneficiary: String?
-)
-
-enum class TerminationDistributionMethod {
-    PRO_RATA,
-    SPECIFIC_SHARES,
-    CHARITABLE_DISTRIBUTION,
-    COURT_DETERMINATION
-}
-
-@Serializable
-data class SpendthriftProvisions(
-    val spendthriftProtection: Boolean,
-    val creditorExceptions: Indexed<String>?,
-    val selfSettledTrustProtection: Boolean
-)
-
-/**
- * Trust assets
- */
-@Serializable
-data class TrustAsset(
-    val id: String,
-    val description: String,
-    val assetType: TrustAssetType,
-    val acquisitionDate: Instant,
-    val acquisitionValue: Price,
-    val currentValue: Price,
-    val income: TrustAssetIncome?,
-    val restrictions: Indexed<AssetRestriction>?
-)
-
-enum class TrustAssetType {
-    CASH,
-    REAL_ESTATE,
-    MARKETABLE_SECURITIES,
-    BUSINESS_INTERESTS,
-    LIFE_INSURANCE,
-    PERSONAL_PROPERTY,
-    INTELLECTUAL_PROPERTY,
-    NATURAL_RESOURCES,
-    COLLECTIBLES
-}
-
-@Serializable
-data class TrustAssetIncome(
-    val incomeType: IncomeType,
-    val annualIncome: Price,
