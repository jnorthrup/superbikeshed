-)
-
-enum class IncomeType {
-    DIVIDENDS,
-    INTEREST,
-    RENT,
-    ROYALTIES,
-    CAPITAL_GAINS,
-    BUSINESS_INCOME
-}
-
-enum class IncomeDistributionStatus {
-    DISTRIBUTED,
-    ACCUMULATED,
-    REINVESTED
-}
-
-sealed interface AssetRestriction {
-    data object CannotSell : AssetRestriction
