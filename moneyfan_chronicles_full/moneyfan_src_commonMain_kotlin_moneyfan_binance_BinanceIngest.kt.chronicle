--- Commit: 2869bf0c70c963a5abace6690b551c36d43dcd26 | 2025-06-23 19:15:00 -0400 ---
diff --git a/moneyfan/src/commonMain/kotlin/moneyfan/binance/BinanceIngest.kt b/moneyfan/src/commonMain/kotlin/moneyfan/binance/BinanceIngest.kt
