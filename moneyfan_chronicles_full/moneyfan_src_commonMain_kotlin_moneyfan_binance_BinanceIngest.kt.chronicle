-package moneyfan.binance
-
-import moneyfan.core.*
-import moneyfan.attention.*
-import borg.trikeshed.lib.*
-import kotlinx.coroutines.*
-import kotlinx.coroutines.flow.*
-import kotlinx.datetime.Instant
-
-/**
- * Binance data ingest for attention-based trading using Acapulco patterns
- * Real-time market data feeding variable time gauge attention system
- */
-
-// Binance-specific data types using TrikeShed patterns
-@JvmInline
-value class BinanceSymbol(val value: String) {
-    fun toSymbol(): Symbol = Symbol(value)
-}
-
-@JvmInline
-value class OrderBookDepth(val value: Int)
-
-@JvmInline
-value class TickerInterval(val value: String) // 1s, 5s, 1m, 5m, 15m, 1h, etc.
-
-// Binance market data structures
-data class BinanceTicker(
-    val symbol: BinanceSymbol,
-    val price: Price,
-    val volume: Volume,
-    val priceChange: Price,
-    val priceChangePercent: Decimal,
-    val timestamp: Instant
-)
-
-data class BinanceOrderBook(
-    val symbol: BinanceSymbol,
-    val bids: Indexed<Join<Price, Volume>>, // price j volume pairs
-    val asks: Indexed<Join<Price, Volume>>,
-    val timestamp: Instant
-)
-
-data class BinanceTrade(
-    val symbol: BinanceSymbol,
-    val price: Price,
-    val volume: Volume,
-    val timestamp: Instant,
-    val isBuyerMaker: Boolean
-)
-
-typealias BinanceTickerStream = Flow<BinanceTicker>
-typealias BinanceTradeStream = Flow<BinanceTrade>
-typealias BinanceOrderBookStream = Flow<BinanceOrderBook>
-
-/**
- * Binance WebSocket data ingest with attention integration
- */
-class BinanceAttentionIngest {
-    private val scope = CoroutineScope(Dispatchers.Default + SupervisorJob())
-    private val ticker = AttentionBasedTicker()
-    
-    // Acapulco-style data processing patterns
-    private val symbolFilters = mutableSetOf<BinanceSymbol>()
-    private val attentionThresholds = mutableMapOf<BinanceSymbol, Decimal>()
-    
-    // Real-time data feeds
-    private val tickerUpdates = MutableSharedFlow<BinanceTicker>()
-    private val tradeUpdates = MutableSharedFlow<BinanceTrade>()
-    private val orderBookUpdates = MutableSharedFlow<BinanceOrderBook>()
-    
-    fun addSymbolForAttention(symbol: String, threshold: Decimal = 0.01) {
-        val binanceSymbol = BinanceSymbol(symbol)
-        symbolFilters.add(binanceSymbol)
-        attentionThresholds[binanceSymbol] = threshold
-        
-        // Add to attention tracker
-        ticker.addPairToWatch(Symbol(symbol))
-        
-        println("🎯 Added $symbol to Binance attention ingest (threshold: ${threshold*100}%)")
-    }
-    
-    /**
-     * Start ingesting Binance data with attention-based filtering
-     */
-    fun startIngest(): BinanceTickerStream = flow {
-        println("🚀 Starting Binance attention ingest...")
-        
-        // Simulate real Binance WebSocket feeds
-        scope.launch { simulateBinanceTickerFeed() }
-        scope.launch { simulateBinanceTradeFeed() }
-        scope.launch { simulateOrderBookFeed() }
-        
-        // Process ticker updates with attention filtering
-        tickerUpdates.collect { ticker ->
-            processTickerForAttention(ticker)
-            emit(ticker)
-        }
-    }.flowOn(Dispatchers.IO)
-    
-    private suspend fun simulateBinanceTickerFeed() {
-        val symbols = listOf("BTCUSDT", "ETHUSDT", "ADAUSDT", "SOLUSDT", "DOTUSDT")
-        
-        while (scope.isActive) {
-            symbols.forEach { symbolStr ->
-                val symbol = BinanceSymbol(symbolStr)
-                if (symbol in symbolFilters) {
-                    
-                    // Generate realistic price movements
-                    val basePrice = when (symbolStr) {
-                        "BTCUSDT" -> 45000.0
-                        "ETHUSDT" -> 3000.0
-                        "ADAUSDT" -> 0.45
-                        "SOLUSDT" -> 95.0
-                        "DOTUSDT" -> 7.5
-                        else -> 100.0
-                    }
-                    
-                    val priceChange = (kotlin.random.Random.nextDouble() - 0.5) * basePrice * 0.02
-                    val currentPrice = Price(basePrice + priceChange)
-                    val volume = Volume(kotlin.random.Random.nextDouble() * 10000.0 + 1000.0)
-                    val changePercent = (priceChange / basePrice) * 100.0
-                    
-                    val ticker = BinanceTicker(
-                        symbol = symbol,
-                        price = currentPrice,
-                        volume = volume,
-                        priceChange = Price(priceChange),
-                        priceChangePercent = changePercent,
-                        timestamp = kotlinx.datetime.Clock.System.now()
-                    )
-                    
-                    tickerUpdates.emit(ticker)
-                }
-            }
-            
-            delay(250) // 4 updates per second per symbol
-        }
-    }
-    
-    private suspend fun simulateBinanceTradeFeed() {
-        while (scope.isActive) {
-            symbolFilters.forEach { symbol ->
-                val basePrice = when (symbol.value) {
-                    "BTCUSDT" -> 45000.0
-                    "ETHUSDT" -> 3000.0
-                    else -> 100.0
-                }
-                
-                val trade = BinanceTrade(
-                    symbol = symbol,
-                    price = Price(basePrice + (kotlin.random.Random.nextDouble() - 0.5) * 100),
-                    volume = Volume(kotlin.random.Random.nextDouble() * 5.0),
-                    timestamp = kotlinx.datetime.Clock.System.now(),
-                    isBuyerMaker = kotlin.random.Random.nextBoolean()
-                )
-                
-                tradeUpdates.emit(trade)
-            }
-            
-            delay(100) // 10 trades per second
-        }
-    }
-    
-    private suspend fun simulateOrderBookFeed() {
-        while (scope.isActive) {
-            symbolFilters.forEach { symbol ->
-                val basePrice = when (symbol.value) {
-                    "BTCUSDT" -> 45000.0
-                    "ETHUSDT" -> 3000.0
-                    else -> 100.0
-                }
-                
-                // Generate order book with 10 levels
-                val bids = mutableListOf<Join<Price, Volume>>()
-                val asks = mutableListOf<Join<Price, Volume>>()
-                
-                for (i in 1..10) {
-                    val bidPrice = Price(basePrice - i * 0.1)
-                    val askPrice = Price(basePrice + i * 0.1)
-                    val bidVolume = Volume(kotlin.random.Random.nextDouble() * 10.0)
-                    val askVolume = Volume(kotlin.random.Random.nextDouble() * 10.0)
-                    
-                    bids.add(bidPrice j bidVolume)
-                    asks.add(askPrice j askVolume)
-                }
-                
-                val orderBook = BinanceOrderBook(
-                    symbol = symbol,
-                    bids = Indexed.of(bids.size) { bids[it] },
-                    asks = Indexed.of(asks.size) { asks[it] },
-                    timestamp = kotlinx.datetime.Clock.System.now()
-                )
-                
-                orderBookUpdates.emit(orderBook)
-            }
-            
-            delay(500) // 2 updates per second
-        }
-    }
-    
-    private fun processTickerForAttention(ticker: BinanceTicker) {
-        val threshold = attentionThresholds[ticker.symbol] ?: 0.01
-        val changeAbs = kotlin.math.abs(ticker.priceChangePercent)
-        
-        if (changeAbs > threshold * 100) {
-            // High volatility - increase attention
-            val volatilityGauge = VolatilityGauge(changeAbs / 100.0)
-            val volumeGauge = VolumeGauge(ticker.volume.value)
-            
-            println("⚡ ${ticker.symbol.value}: ${ticker.priceChangePercent.format(2)}% " +
-                   "price=${ticker.price.value.format(2)} " +
-                   "vol=${ticker.volume.value.format(0)} " +
-                   "ATTENTION TRIGGERED")
-        }
-    }
-    
-    /**
-     * Get attention-filtered trade stream
-     */
-    fun getTradeStream(): BinanceTradeStream = tradeUpdates.asSharedFlow()
-    
-    /**
-     * Get order book updates
-     */
-    fun getOrderBookStream(): BinanceOrderBookStream = orderBookUpdates.asSharedFlow()
-    
-    /**
-     * Integration with attention ticker
-     */
-    fun getAttentionTicker(): AttentionBasedTicker = ticker
-    
-    fun stop() {
-        scope.cancel()
-    }
-}
-
-/**
- * Acapulco-style data aggregation for attention system
- */
-class AcapulcoAttentionAggregator {
-    
-    fun aggregateTickersForAttention(tickers: Flow<BinanceTicker>): Flow<AttentionWindow> = flow {
-        tickers.collect { ticker ->
-            // Convert Binance ticker to attention window
-            val attentionWindow = AttentionWindow(
-                symbol = ticker.symbol.toSymbol(),
-                startTime = ticker.timestamp,
-                endTime = ticker.timestamp,
-                tickCount = 1,
-                volatility = kotlin.math.abs(ticker.priceChangePercent) / 100.0,
-                volume = ticker.volume,
-                priceChange = ticker.priceChange,
-                attentionScore = PairWeight(kotlin.math.abs(ticker.priceChangePercent) * ticker.volume.value / 1000.0),
-                gaugeReading = VolatilityGauge(kotlin.math.abs(ticker.priceChangePercent) / 100.0) j VolumeGauge(ticker.volume.value),
-                dynamicSpan = AttentionSpan(1000) // 1 second base span
-            )
-            
-            emit(attentionWindow)
-        }
-    }
-    
-    fun calculateMarketAttention(windows: Indexed<AttentionWindow>): Decimal {
-        val totalAttention = windows.play.sumOf { it.attentionScore.value }
-        val avgVolatility = windows.play.map { it.volatility }.average()
-        
-        return totalAttention * avgVolatility
-    }
-}
-
-private fun Decimal.format(decimals: Int): String = "%.${decimals}f".format(this)
\ No newline at end of file
