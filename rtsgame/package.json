{
  "name": "rtsgame",
  "version": "0.1.0",
  "description": "Real-Time Strategy game with TrikeShed architecture and Computronium mechanics",
  "main": "js/app.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "preprocess:models": "node scripts/preprocess-models.js",
    "migrate:ts": "node scripts/migrate-to-ts.js",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "gl-matrix": "^3.4.3",
    "immer": "^10.0.3",
    "three": "^0.162.0",
    "trikeshed-ts": "file:../trikeshed-core/src/jsMain/kotlin/trikeshed/index.js"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@types/node": "^20.11.24",
    "@types/three": "^0.162.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "babel-loader": "^10.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "copy-webpack-plugin": "^13.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "html-webpack-plugin": "^5.6.3",
    "prettier": "^3.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "tsc-files --noEmit"
