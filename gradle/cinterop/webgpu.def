package = platform.WebGPU
headers = webgpu/webgpu.h
headerFilter = webgpu/**

compilerOpts.linux = -I/usr/local/include/webgpu
compilerOpts.mingw = -I$WEBGPU_SDK/include

linkerOpts.linux = -L/usr/local/lib -lwebgpu -lpthread -ldl
linkerOpts.mingw = -L$WEBGPU_SDK/lib -lwebgpu

---

// WebGPU - Modern GPU API for the web and native
// Simplified API compared to Vulkan/Metal
// Cross-platform compute and graphics