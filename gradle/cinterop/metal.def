package = platform.Metal
headers = Metal/Metal.h MetalKit/MetalKit.h MetalPerformanceShaders/MetalPerformanceShaders.h
headerFilter = Metal/** MetalKit/** MetalPerformanceShaders/**

compilerOpts = -framework Metal -framework MetalKit -framework MetalPerformanceShaders
linkerOpts = -framework Metal -framework MetalKit -framework MetalPerformanceShaders -framework Foundation -framework CoreGraphics

---

