package = platform.MLX
headers = mlx/mlx.h
headerFilter = mlx/**

compilerOpts = -I/usr/local/include -I/opt/homebrew/include
linkerOpts = -L/usr/local/lib -L/opt/homebrew/lib -lmlx -lc++ -framework Accelerate -framework Metal -framework Foundation

---

// MLX - Apple's ML framework optimized for Apple Silicon
// Provides unified memory model and lazy evaluation
// Integrates with Metal for GPU acceleration