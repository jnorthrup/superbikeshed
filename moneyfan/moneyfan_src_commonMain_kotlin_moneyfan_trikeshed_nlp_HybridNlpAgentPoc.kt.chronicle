diff --git a/moneyfan/src/commonMain/kotlin/moneyfan/trikeshed/nlp/HybridNlpAgentPoc.kt b/moneyfan/src/commonMain/kotlin/moneyfan/trikeshed/nlp/HybridNlpAgentPoc.kt
