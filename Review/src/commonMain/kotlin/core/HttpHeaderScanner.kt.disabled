@file:Suppress("NOTHING_TO_INLINE")

package core

import borg.trikeshed.lib.*
import kotlin.jvm.*

/**
 * Compact HTTP/RFC-822 Header Scanner - TrikeShed Style
 * 
 * Preserves the original TrikeShed compact design for HTTP parsing:
 * - TypeEvidence forward design for headers
 * - Join<A,B> pairwise scanning without allocation
 * - Bitmap-based structural analysis
 * - O(log n) header lookups via compact indexing
 */

// ═══════════════════════════════════════════════════════════════════════════════════════
// TYPEALIAS FORWARD DESIGN (TrikeShed Pattern)
// ═══════════════════════════════════════════════════════════════════════════════════════

typealias HttpMessage = Join<HttpHeaders, HttpBody>
typealias HttpHeaders = Join<HeaderBitmap, HeaderIndex>
typealias HeaderBitmap = Join<IntArray, TypeEvidence>
typealias HeaderIndex = Join<IntArray, CharSequence>
typealias HttpBody = Join<Int, ByteArray>

// Compact header representation
typealias HeaderPair = Join<String, String>        // name j value
typealias HeaderLine = Join<Int, HeaderPair>       // offset j pair
typealias RequestLine = Join<String, Join<String, String>> // method j (uri j version)

// RFC-822 state representation
typealias Rfc822State = Join<TypeEvidence, HeaderIndex>

// ═══════════════════════════════════════════════════════════════════════════════════════
// COMPACT HTTP SCANNER (TrikeShed Elegance)
// ═══════════════════════════════════════════════════════════════════════════════════════

/**
 * Compact HTTP message scanner with RFC-822 header state
 */
@JvmInline
value class HttpScanner(val input: CharSequence) {
    
    /**
     * Single-pass scan with bitmap extraction (TrikeShed pattern)
     */
    fun scan(): HttpMessage {
        val bitmap = IntArray(input.length shr 6) // 64-bit chunks
        val evidence = mutableMapOf<Int, TypeEvidence>()
        val headerOffsets = mutableListOf<Int>()
        
        var pos = 0
        var headerEnd = -1
        var inValue = false
        
        while (pos < input.length) {
            val char = input[pos]
            val wordIndex = pos shr 6
            val bitIndex = pos and 63
            
            when (char) {
                ':' -> {
                    bitmap[wordIndex] = bitmap[wordIndex] or (1 shl bitIndex)
                    evidence[pos] = "colon" j 0
                    inValue = true
                }
                '\r' -> {
                    bitmap[wordIndex] = bitmap[wordIndex] or (2 shl bitIndex)
                    evidence[pos] = "cr" j 0
                }
                '\n' -> {
                    bitmap[wordIndex] = bitmap[wordIndex] or (4 shl bitIndex)
                    evidence[pos] = "lf" j 0
                    if (pos > 0 && input[pos - 1] == '\r') {
                        headerOffsets.add(pos - 1) // Mark CRLF positions
                        inValue = false
                        
                        // Check for double CRLF (header end)
                        if (pos + 1 < input.length && input[pos + 1] == '\r') {
                            headerEnd = pos + 3 // After \r\n\r\n
                            break
                        }
                    }
                }
                ' ', '\t' -> {
                    if (inValue) {
                        bitmap[wordIndex] = bitmap[wordIndex] or (8 shl bitIndex)
                        evidence[pos] = "space" j 0
                    }
                }
                else -> {
                    if (!inValue) {
                        bitmap[wordIndex] = bitmap[wordIndex] or (16 shl bitIndex)
                        evidence[pos] = "header_name" j 0
                    } else {
                        bitmap[wordIndex] = bitmap[wordIndex] or (32 shl bitIndex)
                        evidence[pos] = "header_value" j 0
                    }
                }
            }
            pos++
        }
        
        // Extract headers and body
        val headerBitmap = bitmap j TypeEvidence(evidence.entries.map { "${it.key}:${it.value.a}" }.joinToString(","), evidence.size)
        val headerIndex = headerOffsets.toIntArray() j input
        val headers = headerBitmap j headerIndex
        
        val bodyStart = if (headerEnd > 0) headerEnd else input.length
        val bodyBytes = if (bodyStart < input.length) {
            input.substring(bodyStart).encodeToByteArray()
        } else byteArrayOf()
        val body = bodyBytes.size j bodyBytes
        
        return headers j body
    }
    
    /**
     * Fast header lookup with bitmap positioning (O(log n))
     */
    fun getHeader(name: String): String? {
        val message = scan()
        val headerIndex = message.a.b.a
        val content = message.a.b.b
        
        val nameLower = name.lowercase()
        
        // Binary search through header offsets using bitmap
        for (offset in headerIndex) {
            if (offset >= content.length) continue
            
            val lineEnd = findLineEnd(content, offset)
            val line = content.substring(offset, lineEnd)
            val colonPos = line.indexOf(':')
            
            if (colonPos > 0) {
                val headerName = line.substring(0, colonPos).trim().lowercase()
                if (headerName == nameLower) {
                    return line.substring(colonPos + 1).trim()
                }
            }
        }
        
        return null
    }
    
    /**
     * Extract all header pairs (TrikeShed pattern)
     */
    fun headerPairs(): List<HeaderPair> {
        val message = scan()
        val headerIndex = message.a.b.a
        val content = message.a.b.b
        
        val pairs = mutableListOf<HeaderPair>()
        
        for (offset in headerIndex) {
            if (offset >= content.length) continue
            
            val lineEnd = findLineEnd(content, offset)
            if (lineEnd <= offset) continue
            
            val line = content.substring(offset, lineEnd)
            val colonPos = line.indexOf(':')
            
            if (colonPos > 0) {
                val name = line.substring(0, colonPos).trim()
                val value = line.substring(colonPos + 1).trim()
                pairs.add(name j value)
            }
        }
        
        return pairs
    }
    
    /**
     * Parse request line (for HTTP requests)
     */
    fun requestLine(): RequestLine? {
        val firstLineEnd = findLineEnd(input, 0)
        if (firstLineEnd <= 0) return null
        
        val line = input.substring(0, firstLineEnd).trim()
        val parts = line.split(' ')
        
        return if (parts.size >= 3) {
            val method = parts[0]
            val uri = parts[1]
            val version = parts.drop(2).joinToString(" ")
            method j (uri j version)
        } else null
    }
    
    /**
     * Parse status line (for HTTP responses)
     */
    fun statusLine(): Join<String, Join<Int, String>>? {
        val firstLineEnd = findLineEnd(input, 0)
        if (firstLineEnd <= 0) return null
        
        val line = input.substring(0, firstLineEnd).trim()
        val parts = line.split(' ', limit = 3)
        
        return if (parts.size >= 3) {
            val version = parts[0]
            val statusCode = parts[1].toIntOrNull() ?: 0
            val reasonPhrase = parts[2]
            version j (statusCode j reasonPhrase)
        } else null
    }
    
    /**
     * Get content length efficiently
     */
    fun contentLength(): Int = getHeader("Content-Length")?.toIntOrNull() ?: 0
    
    /**
     * Check if chunked encoding
     */
    fun isChunked(): Boolean = getHeader("Transfer-Encoding")?.contains("chunked") == true
    
    /**
     * Extract body efficiently
     */
    fun body(): ByteArray = scan().b.b
    
    /**
     * Structural fingerprint for caching/comparison
     */
    fun fingerprint(): Long {
        val bitmap = scan().a.a.a
        return bitmap.fold(0L) { acc, word -> acc xor word.toLong() }
    }
    
    // Helper functions
    private fun findLineEnd(content: CharSequence, start: Int): Int {
        var pos = start
        while (pos < content.length) {
            if (content[pos] == '\r' && pos + 1 < content.length && content[pos + 1] == '\n') {
                return pos
            }
            if (content[pos] == '\n') {
                return pos
            }
            pos++
        }
        return content.length
    }
}

// ═══════════════════════════════════════════════════════════════════════════════════════
// RFC-822 HEADER STATE (TrikeShed Pattern)
// ═══════════════════════════════════════════════════════════════════════════════════════

/**
 * Compact RFC-822 header state - tracks parsing progress efficiently
 */
@JvmInline
value class Rfc822HeaderState(val state: Rfc822State) {
    
    companion object {
        fun create(): Rfc822HeaderState {
            val evidence = TypeEvidence("parsing", 0)
            val index = intArrayOf() j ""
            return Rfc822HeaderState(evidence j index)
        }
        
        fun fromScanner(scanner: HttpScanner): Rfc822HeaderState {
            val message = scanner.scan()
            val evidence = message.a.a.b
            val index = message.a.b
            return Rfc822HeaderState(evidence j index)
        }
    }
    
    /**
     * Check if headers are complete (found double CRLF)
     */
    fun isComplete(): Boolean {
        val evidence = state.a.a
        return evidence.contains("complete")
    }
    
    /**
     * Get current parsing position
     */
    fun position(): Int = state.a.b
    
    /**
     * Mark header completion
     */
    fun complete(): Rfc822HeaderState {
        val newEvidence = TypeEvidence("complete", state.a.b)
        return Rfc822HeaderState(newEvidence j state.b)
    }
    
    /**
     * Extract request from state
     */
    fun req(): HttpRequest? {
        val scanner = HttpScanner(state.b.b)
        val reqLine = scanner.requestLine()
        val headers = scanner.headerPairs().associate { it.a to it.b }
        val body = scanner.body()
        
        return reqLine?.let { (method, uriVersion) ->
            val (uri, version) = uriVersion
            HttpRequest(method, uri, version, headers, body)
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════════════════
// CONTEXT FLOW WITH HTTP OPERATIONS
// ═══════════════════════════════════════════════════════════════════════════════════════

/**
 * Context flow for HTTP operations (TrikeShed stairway pattern)
 */
@JvmInline
value class HttpFlow(val scanner: HttpScanner) {
    
    fun structural(): HttpStructuralFlow = HttpStructuralFlow(scanner)
    fun queryable(): HttpQueryableFlow = HttpQueryableFlow(scanner)
    fun comparable(): HttpComparableFlow = HttpComparableFlow(scanner)
}

@JvmInline
value class HttpStructuralFlow(val scanner: HttpScanner) {
    
    fun extract(): HttpMessage = scanner.scan()
    
    fun headers(): List<HeaderPair> = scanner.headerPairs()
    
    fun bitmap(): IntArray = scanner.scan().a.a.a
    
    fun fingerprint(): Long = scanner.fingerprint()
}

@JvmInline
value class HttpQueryableFlow(val scanner: HttpScanner) {
    
    fun header(name: String): String? = scanner.getHeader(name)
    
    fun contentLength(): Int = scanner.contentLength()
    
    fun isChunked(): Boolean = scanner.isChunked()
    
    fun body(): ByteArray = scanner.body()
    
    fun requestLine(): RequestLine? = scanner.requestLine()
    
    fun statusLine(): Join<String, Join<Int, String>>? = scanner.statusLine()
}

@JvmInline
value class HttpComparableFlow(val scanner: HttpScanner) {
    
    fun headerSimilarity(other: HttpScanner): Double {
        val headers1 = scanner.headerPairs().map { it.a }.toSet()
        val headers2 = other.headerPairs().map { it.a }.toSet()
        
        val intersection = headers1.intersect(headers2).size
        val union = headers1.union(headers2).size
        
        return if (union > 0) intersection.toDouble() / union else 0.0
    }
    
    fun isHttps(): Boolean = scanner.getHeader("X-Forwarded-Proto")?.equals("https", true) == true ||
        scanner.requestLine()?.b?.a?.startsWith("https") == true
    
    fun isKeepAlive(): Boolean = scanner.getHeader("Connection")?.equals("keep-alive", true) == true
}

// ═══════════════════════════════════════════════════════════════════════════════════════
// COMPACT DSL EXTENSIONS
// ═══════════════════════════════════════════════════════════════════════════════════════

/**
 * Compact HTTP scanner entry point
 */
inline fun String.http(): HttpScanner = HttpScanner(this)

/**
 * Context flow entry
 */
inline fun HttpScanner.flow(): HttpFlow = HttpFlow(this)

/**
 * Direct header query shorthand
 */
inline operator fun HttpScanner.get(headerName: String): String? = getHeader(headerName)

/**
 * Header pairs extraction shorthand
 */
inline fun HttpScanner.toPairs(): List<HeaderPair> = headerPairs()

/**
 * RFC-822 state creation
 */
inline fun HttpScanner.toRfc822(): Rfc822HeaderState = Rfc822HeaderState.fromScanner(this)

// ═══════════════════════════════════════════════════════════════════════════════════════
// DATA CLASSES FOR COMPATIBILITY
// ═══════════════════════════════════════════════════════════════════════════════════════

data class HttpRequest(
    val method: String,
    val uri: String,
    val version: String,
    val headers: Map<String, String>,
    val body: ByteArray = byteArrayOf()
) {
    override fun equals(other: Any?): Boolean {
        if (this === other) return true
        if (other !is HttpRequest) return false
        return method == other.method && uri == other.uri && version == other.version && 
               headers == other.headers && body.contentEquals(other.body)
    }
    
    override fun hashCode(): Int {
        return method.hashCode() * 31 + uri.hashCode() * 31 + version.hashCode() * 31 + 
               headers.hashCode() * 31 + body.contentHashCode()
    }
}

data class HttpResponse(
    val version: String,
    val statusCode: Int,
    val reasonPhrase: String,
    val headers: Map<String, String>,
    val body: ByteArray = byteArrayOf()
) {
    override fun equals(other: Any?): Boolean {
        if (this === other) return true
        if (other !is HttpResponse) return false
        return version == other.version && statusCode == other.statusCode && 
               reasonPhrase == other.reasonPhrase && headers == other.headers && 
               body.contentEquals(other.body)
    }
    
    override fun hashCode(): Int {
        return version.hashCode() * 31 + statusCode * 31 + reasonPhrase.hashCode() * 31 + 
               headers.hashCode() * 31 + body.contentHashCode()
    }
}

// ═══════════════════════════════════════════════════════════════════════════════════════
// TENSOR INTEGRATION
// ═══════════════════════════════════════════════════════════════════════════════════════

/**
 * Tensor-based HTTP message processing
 */
fun List<String>.httpTensor(): Join<IntArray, List<HttpScanner>> {
    val scanners = map { it.http() }
    val shape = intArrayOf(size)
    return shape j scanners
}

/**
 * Batch header analysis
 */
fun Join<IntArray, List<HttpScanner>>.analyzeHeaders(): Map<String, Int> {
    val scanners = b
    val allHeaders = scanners.flatMap { it.headerPairs().map { pair -> pair.a } }
    return allHeaders.groupingBy { it }.eachCount()
}

/**
 * Find similar HTTP messages by header structure
 */
fun Join<IntArray, List<HttpScanner>>.findSimilar(threshold: Double = 0.8): Map<Int, List<Int>> {
    val scanners = b
    val similarities = mutableMapOf<Int, List<Int>>()
    
    for (i in scanners.indices) {
        val similar = mutableListOf<Int>()
        for (j in scanners.indices) {
            if (i != j) {
                val similarity = scanners[i].flow().comparable().headerSimilarity(scanners[j])
                if (similarity >= threshold) {
                    similar.add(j)
                }
            }
        }
        if (similar.isNotEmpty()) {
            similarities[i] = similar
        }
    }
    
    return similarities
}

// ═══════════════════════════════════════════════════════════════════════════════════════
// HTTP/2 AND HTTP/3 VARIATIONS (TrikeShed Evolution)
// ═══════════════════════════════════════════════════════════════════════════════════════

/**
 * HTTP/2 frame types for binary protocol handling
 */
sealed class Http2FrameType(val value: UByte) {
    object Data : Http2FrameType(0x0U)
    object Headers : Http2FrameType(0x1U)
    object Priority : Http2FrameType(0x2U)
    object RstStream : Http2FrameType(0x3U)
    object Settings : Http2FrameType(0x4U)
    object PushPromise : Http2FrameType(0x5U)
    object Ping : Http2FrameType(0x6U)
    object GoAway : Http2FrameType(0x7U)
    object WindowUpdate : Http2FrameType(0x8U)
    object Continuation : Http2FrameType(0x9U)
    
    companion object {
        fun fromByte(value: UByte): Http2FrameType = when (value) {
            0x0U -> Data
            0x1U -> Headers
            0x2U -> Priority
            0x3U -> RstStream
            0x4U -> Settings
            0x5U -> PushPromise
            0x6U -> Ping
            0x7U -> GoAway
            0x8U -> WindowUpdate
            0x9U -> Continuation
            else -> Data // Default fallback
        }
    }
}

/**
 * HTTP/2 frame representation using TrikeShed patterns
 */
typealias Http2Frame = Join<Http2FrameHeader, ByteArray>
typealias Http2FrameHeader = Join<Join<Int, Http2FrameType>, Join<UByte, Int>>  // (length j type) j (flags j streamId)

/**
 * HTTP/3 QUIC frame representation
 */
typealias Http3Frame = Join<Http3FrameType, ByteArray>
typealias Http3FrameType = Join<ULong, ULong>  // type j length (variable length integers)

/**
 * HTTP/2 Binary Scanner with TrikeShed patterns
 */
@JvmInline
value class Http2Scanner(val input: ByteArray) {
    
    /**
     * Parse HTTP/2 frames with bitmap tracking
     */
    fun parseFrames(): List<Http2Frame> {
        val frames = mutableListOf<Http2Frame>()
        var pos = 0
        
        while (pos + 9 <= input.size) {  // Minimum frame header size
            // Parse frame header (9 bytes)
            val length = (input[pos].toUByte().toInt() shl 16) or 
                        (input[pos + 1].toUByte().toInt() shl 8) or 
                        input[pos + 2].toUByte().toInt()
            
            val frameType = Http2FrameType.fromByte(input[pos + 3].toUByte())
            val flags = input[pos + 4].toUByte()
            
            // Stream ID (31 bits, R bit reserved)
            val streamId = ((input[pos + 5].toUByte().toInt() and 0x7F) shl 24) or
                          (input[pos + 6].toUByte().toInt() shl 16) or
                          (input[pos + 7].toUByte().toInt() shl 8) or
                          input[pos + 8].toUByte().toInt()
            
            pos += 9
            
            // Extract payload
            val payload = if (length > 0 && pos + length <= input.size) {
                input.copyOfRange(pos, pos + length)
            } else byteArrayOf()
            
            // Create frame using TrikeShed Join pattern
            val frameHeader = (length j frameType) j (flags j streamId)
            frames.add(frameHeader j payload)
            
            pos += length
        }
        
        return frames
    }
    
    /**
     * Extract HEADERS frame content for RFC-822 compatibility
     */
    fun extractHeaders(): List<HeaderPair> {
        val frames = parseFrames()
        val headerPairs = mutableListOf<HeaderPair>()
        
        for (frame in frames) {
            val frameType = frame.a.b
            if (frameType is Http2FrameType.Headers) {
                // Simplified HPACK decompression for demonstration
                val payload = frame.b
                val headers = decodeHpackHeaders(payload)
                headerPairs.addAll(headers)
            }
        }
        
        return headerPairs
    }
    
    /**
     * Convert to HTTP/1.1 equivalent scanner for compatibility
     */
    fun toHttp1(): HttpScanner {
        val headers = extractHeaders()
        val http1Message = buildString {
            // Reconstruct HTTP/1.1 format
            appendLine("GET / HTTP/1.1")  // Default request line
            headers.forEach { pair ->
                appendLine("${pair.a}: ${pair.b}")
            }
            appendLine()
        }
        return HttpScanner(http1Message)
    }
    
    /**
     * Frame statistics using TypeEvidence pattern
     */
    fun frameStatistics(): TypeEvidence {
        val frames = parseFrames()
        var evidence = TypeEvidence()
        
        for (frame in frames) {
            val frameType = frame.a.b
            val length = frame.a.a
            
            evidence = evidence.copy(
                digits = evidence.digits + length.toUShort(),
                special = evidence.special + when (frameType) {
                    is Http2FrameType.Headers -> 1U
                    is Http2FrameType.Data -> 2U
                    is Http2FrameType.Settings -> 3U
                    else -> 4U
                }
            )
        }
        
        return evidence
    }
    
    // Simplified HPACK decoder for demonstration
    private fun decodeHpackHeaders(payload: ByteArray): List<HeaderPair> {
        val headers = mutableListOf<HeaderPair>()
        var pos = 0
        
        while (pos < payload.size) {
            if (payload[pos].toUByte() > 127U) {
                // Indexed header (simplified)
                val index = payload[pos].toUByte() and 0x7FU
                val header = getStaticHeaderByIndex(index.toInt())
                if (header != null) headers.add(header)
                pos++
            } else if (payload[pos].toUByte() > 63U) {
                // Literal with incremental indexing (simplified)
                pos++ // Skip for now
            } else {
                // Literal without indexing (simplified)
                pos++ // Skip for now
            }
        }
        
        return headers
    }
    
    private fun getStaticHeaderByIndex(index: Int): HeaderPair? {
        return when (index) {
            1 -> ":authority" j ""
            2 -> ":method" j "GET"
            3 -> ":method" j "POST"
            4 -> ":path" j "/"
            5 -> ":path" j "/index.html"
            6 -> ":scheme" j "http"
            7 -> ":scheme" j "https"
            8 -> ":status" j "200"
            9 -> ":status" j "204"
            10 -> ":status" j "206"
            // Add more static table entries as needed
            else -> null
        }
    }
}

/**
 * HTTP/3 QUIC Scanner with TrikeShed patterns
 */
@JvmInline
value class Http3Scanner(val input: ByteArray) {
    
    /**
     * Parse HTTP/3 QUIC frames
     */
    fun parseFrames(): List<Http3Frame> {
        val frames = mutableListOf<Http3Frame>()
        var pos = 0
        
        while (pos < input.size) {
            val (frameType, newPos1) = parseVarint(input, pos)
            if (newPos1 >= input.size) break
            
            val (length, newPos2) = parseVarint(input, newPos1)
            if (newPos2 >= input.size) break
            
            val payload = if (length > 0UL && newPos2 + length.toInt() <= input.size) {
                input.copyOfRange(newPos2, newPos2 + length.toInt())
            } else byteArrayOf()
            
            frames.add((frameType j length) j payload)
            pos = newPos2 + length.toInt()
        }
        
        return frames
    }
    
    /**
     * Extract headers from HEADERS frame type (0x01)
     */
    fun extractHeaders(): List<HeaderPair> {
        val frames = parseFrames()
        val headerPairs = mutableListOf<HeaderPair>()
        
        for (frame in frames) {
            val frameType = frame.a.a
            if (frameType == 0x01UL) { // HEADERS frame
                val payload = frame.b
                val headers = decodeQpackHeaders(payload)
                headerPairs.addAll(headers)
            }
        }
        
        return headerPairs
    }
    
    /**
     * Convert to HTTP/1.1 equivalent for compatibility
     */
    fun toHttp1(): HttpScanner {
        val headers = extractHeaders()
        val http1Message = buildString {
            appendLine("GET / HTTP/1.1")
            headers.forEach { pair ->
                appendLine("${pair.a}: ${pair.b}")
            }
            appendLine()
        }
        return HttpScanner(http1Message)
    }
    
    /**
     * Frame statistics using TypeEvidence
     */
    fun frameStatistics(): TypeEvidence {
        val frames = parseFrames()
        var evidence = TypeEvidence()
        
        for (frame in frames) {
            val frameType = frame.a.a
            val length = frame.a.b
            
            evidence = evidence.copy(
                digits = evidence.digits + length.toUShort(),
                special = evidence.special + frameType.toUShort()
            )
        }
        
        return evidence
    }
    
    // QUIC variable-length integer parsing
    private fun parseVarint(data: ByteArray, offset: Int): Pair<ULong, Int> {
        if (offset >= data.size) return 0UL to offset
        
        val firstByte = data[offset].toUByte()
        val length = when ((firstByte.toUInt() and 0xC0U) shr 6) {
            0U -> 1
            1U -> 2
            2U -> 4
            3U -> 8
            else -> 1
        }
        
        if (offset + length > data.size) return 0UL to offset
        
        var value = (firstByte.toULong() and 0x3FUL)
        for (i in 1 until length) {
            value = (value shl 8) or data[offset + i].toUByte().toULong()
        }
        
        return value to (offset + length)
    }
    
    // Simplified QPACK decoder
    private fun decodeQpackHeaders(payload: ByteArray): List<HeaderPair> {
        // Simplified QPACK decoding - real implementation would be more complex
        return listOf(":method" j "GET", ":path" j "/", ":scheme" j "https")
    }
}

/**
 * Unified HTTP Protocol Scanner (TrikeShed Evolution)
 */
@JvmInline
value class UnifiedHttpScanner(val input: ByteArray) {
    
    /**
     * Auto-detect HTTP protocol version and parse accordingly
     */
    fun detectAndParse(): HttpFlow {
        return when {
            isHttp3() -> Http3Scanner(input).toHttp1().flow()
            isHttp2() -> Http2Scanner(input).toHttp1().flow()
            else -> HttpScanner(input.decodeToString()).flow()
        }
    }
    
    private fun isHttp2(): Boolean {
        // HTTP/2 connection preface check
        val preface = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n".encodeToByteArray()
        return input.size >= preface.size && 
               input.copyOfRange(0, preface.size).contentEquals(preface)
    }
    
    private fun isHttp3(): Boolean {
        // QUIC packet header check (simplified)
        return input.size > 0 && (input[0].toUByte() and 0x80U) != 0UB
    }
}

// ═══════════════════════════════════════════════════════════════════════════════════════
// DSL EXTENSIONS FOR HTTP/2 AND HTTP/3
// ═══════════════════════════════════════════════════════════════════════════════════════

/**
 * HTTP/2 scanner entry point
 */
inline fun ByteArray.http2(): Http2Scanner = Http2Scanner(this)

/**
 * HTTP/3 scanner entry point
 */
inline fun ByteArray.http3(): Http3Scanner = Http3Scanner(this)

/**
 * Unified protocol scanner
 */
inline fun ByteArray.httpAny(): UnifiedHttpScanner = UnifiedHttpScanner(this)

/**
 * Tensor integration for binary HTTP protocols
 */
fun List<ByteArray>.httpBinaryTensor(): Join<IntArray, List<UnifiedHttpScanner>> {
    val scanners = map { it.httpAny() }
    val shape = intArrayOf(size)
    return shape j scanners
}

// ═══════════════════════════════════════════════════════════════════════════════════════
// EXAMPLE USAGE
// ═══════════════════════════════════════════════════════════════════════════════════════

/**
 * Demonstrate compact HTTP scanning with TrikeShed patterns across HTTP versions
 */
fun demonstrateCompactHttpScanner() {
    // HTTP/1.1 Examples
    val httpRequest = """
        GET /api/v1/data HTTP/1.1
        Host: example.com
        User-Agent: TensorCore/1.0
        Accept: application/json
        Content-Type: application/json
        Content-Length: 25
        
        {"query": "market_data"}
    """.trimIndent()
    
    val httpResponse = """
        HTTP/1.1 200 OK
        Content-Type: application/json
        Content-Length: 123
        Cache-Control: no-cache
        Connection: keep-alive
        
        {"status": "success", "data": [1,2,3]}
    """.trimIndent()
    
    // HTTP/1.1 scanning
    val reqScanner = httpRequest.http()
    val respScanner = httpResponse.http()
    
    println("=== HTTP/1.1 Analysis ===")
    println("Host: ${reqScanner["Host"]}")
    println("Content-Type: ${reqScanner["Content-Type"]}")
    println("Content-Length: ${reqScanner.contentLength()}")
    
    // Request line parsing
    val reqLine = reqScanner.requestLine()
    println("Method: ${reqLine?.a}")
    println("URI: ${reqLine?.b?.a}")
    println("Version: ${reqLine?.b?.b}")
    
    // Header pairs using TrikeShed Join pattern
    val headers = reqScanner.toPairs()
    println("Headers: ${headers.map { "${it.a}: ${it.b}" }}")
    
    // RFC-822 state analysis
    val rfc822 = reqScanner.toRfc822()
    println("RFC-822 complete: ${rfc822.isComplete()}")
    
    // Structural fingerprinting
    val fingerprint = reqScanner.fingerprint()
    println("Fingerprint: $fingerprint")
    
    // Context flows
    val isHttps = reqScanner.flow().comparable().isHttps()
    val keepAlive = reqScanner.flow().comparable().isKeepAlive()
    println("HTTPS: $isHttps, Keep-Alive: $keepAlive")
    
    // HTTP/2 Binary Protocol Example
    println("\n=== HTTP/2 Binary Analysis ===")
    
    // Simulate HTTP/2 connection preface + HEADERS frame
    val http2Preface = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n".encodeToByteArray()
    val http2HeadersFrame = byteArrayOf(
        0x00, 0x00, 0x0C,  // Length: 12 bytes
        0x01,              // Type: HEADERS
        0x05,              // Flags: END_HEADERS | END_STREAM
        0x00, 0x00, 0x00, 0x01,  // Stream ID: 1
        // Simplified HPACK payload
        0x82, 0x86, 0x84, 0x41, 0x0A, 0x65, 0x78, 0x61, 0x6D, 0x70, 0x6C, 0x65
    )
    val http2Data = http2Preface + http2HeadersFrame
    
    val http2Scanner = http2Data.http2()
    val http2Frames = http2Scanner.parseFrames()
    println("HTTP/2 frames detected: ${http2Frames.size}")
    
    http2Frames.forEach { frame ->
        val length = frame.a.a
        val frameType = frame.a.b
        val flags = frame.b.a
        val streamId = frame.b.b
        println("Frame: type=$frameType, length=$length, flags=$flags, stream=$streamId")
    }
    
    // Extract headers and convert to HTTP/1.1 for compatibility
    val http2Headers = http2Scanner.extractHeaders()
    println("Extracted headers: ${http2Headers.map { "${it.a}: ${it.b}" }}")
    
    // Frame statistics using TypeEvidence
    val frameStats = http2Scanner.frameStatistics()
    println("Frame statistics: digits=${frameStats.digits}, special=${frameStats.special}")
    
    // HTTP/3 QUIC Protocol Example
    println("\n=== HTTP/3 QUIC Analysis ===")
    
    // Simulate HTTP/3 HEADERS frame with QUIC variable-length integers
    val http3Data = byteArrayOf(
        0x01,              // Frame type: HEADERS (varint)
        0x0C,              // Length: 12 (varint)
        // Simplified QPACK payload
        0xC1, 0xC0, 0x82, 0x86, 0x84, 0x41, 0x0A, 0x65, 0x78, 0x61, 0x6D, 0x70
    )
    
    val http3Scanner = http3Data.http3()
    val http3Frames = http3Scanner.parseFrames()
    println("HTTP/3 frames detected: ${http3Frames.size}")
    
    http3Frames.forEach { frame ->
        val frameType = frame.a.a
        val length = frame.a.b
        println("QUIC Frame: type=$frameType, length=$length")
    }
    
    val http3Headers = http3Scanner.extractHeaders()
    println("QPACK headers: ${http3Headers.map { "${it.a}: ${it.b}" }}")
    
    // Unified Protocol Detection
    println("\n=== Unified Protocol Detection ===")
    
    val unifiedScanner1 = httpRequest.encodeToByteArray().httpAny()
    val unifiedScanner2 = http2Data.httpAny()
    val unifiedScanner3 = http3Data.httpAny()
    
    val flow1 = unifiedScanner1.detectAndParse()
    val flow2 = unifiedScanner2.detectAndParse()
    val flow3 = unifiedScanner3.detectAndParse()
    
    println("Protocol 1 headers: ${flow1.queryable().header("Host")}")
    println("Protocol 2 detected as HTTP/2: ${http2Data.size > 24}")
    println("Protocol 3 detected as HTTP/3: ${http3Data[0].toUByte() == 0x01UByte}")
    
    // Tensor batch processing across protocols
    println("\n=== Cross-Protocol Tensor Analysis ===")
    
    val httpMessages = listOf(httpRequest, httpResponse)
    val tensorScanners = httpMessages.httpTensor()
    val headerAnalysis = tensorScanners.analyzeHeaders()
    println("HTTP/1.1 header frequency: $headerAnalysis")
    
    val binaryMessages = listOf(http2Data, http3Data)
    val binaryTensor = binaryMessages.httpBinaryTensor()
    println("Binary protocols tensor shape: ${binaryTensor.a.contentToString()}")
    
    // Structural comparison across versions
    val similarity = flow1.comparable().headerSimilarity(flow2.structural().extract().let { 
        HttpScanner("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n") 
    })
    println("Cross-version header similarity: $similarity")
}