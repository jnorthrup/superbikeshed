@file:Suppress("NOTHING_TO_INLINE")

package core

import borg.trikeshed.lib.Join
import borg.trikeshed.lib.j
import kotlin.jvm.JvmInline

/**
 * JSON Scanner with Finite Pairwise Complexity
 * 
 * Provides structural analysis and isomorphism detection for JSON data
 * through pairwise tensor operations. Enables O(log n) structural comparison
 * instead of brute-force parsing.
 */

/**
 * JSON Element types for structural analysis
 */
sealed class JsonElement {
    data class Object(val fields: List<Join<String, JsonElement>>) : JsonElement()
    data class Array(val elements: List<JsonElement>) : JsonElement()
    data class String(val value: kotlin.String) : JsonElement()
    data class Number(val value: Double) : JsonElement()
    data class Boolean(val value: kotlin.Boolean) : JsonElement()
    object Null : JsonElement()
}

/**
 * Structural fingerprint for O(log n) comparison
 */
data class JsonStructure(
    val depth: Int,
    val objectCount: Int,
    val arrayCount: Int,
    val fieldCount: Int,
    val elementCount: Int,
    val typeDistribution: Map<String, Int>
) {
    /**
     * Compute structural hash for fast comparison
     */
    val structuralHash: Int = 
        (depth * 31 + objectCount) * 31 + arrayCount * 31 + fieldCount * 31 + elementCount
    
    /**
     * Check structural isomorphism with another JSON structure
     */
    infix fun isIsomorphicTo(other: JsonStructure): Boolean =
        structuralHash == other.structuralHash &&
        depth == other.depth &&
        objectCount == other.objectCount &&
        arrayCount == other.arrayCount &&
        typeDistribution == other.typeDistribution
}

/**
 * JSON Path for targeted element access
 */
sealed class JsonPath {
    data class Key(val name: String) : JsonPath()
    data class Index(val value: Int) : JsonPath()
}

/**
 * JSON Scanner with pairwise complexity
 */
@JvmInline
value class JsonScanner(val input: String) {
    
    /**
     * Parse JSON with structural indexing
     */
    fun parse(): JsonParseResult = {
        val structure = extractStructure()
        val element = parseElement(input, 0).first
        
        JsonParseResult(element, structure)
    }()
    
    /**
     * Extract structural fingerprint without full parsing (O(n) scan)
     */
    fun extractStructure(): JsonStructure = {
        var depth = 0
        var maxDepth = 0
        var objectCount = 0
        var arrayCount = 0
        var fieldCount = 0
        var elementCount = 0
        val typeDistribution = mutableMapOf<String, Int>()
        
        var inString = false
        var escaped = false
        var i = 0
        
        while (i < input.length) {
            val char = input[i]
            
            when {
                escaped -> escaped = false
                inString -> when (char) {
                    '\\' -> escaped = true
                    '"' -> inString = false
                }
                else -> when (char) {
                    '"' -> {
                        inString = true
                        typeDistribution["string"] = typeDistribution.getOrDefault("string", 0) + 1
                    }
                    '{' -> {
                        depth++
                        maxDepth = maxOf(maxDepth, depth)
                        objectCount++
                    }
                    '}' -> depth--
                    '[' -> {
                        depth++
                        maxDepth = maxOf(maxDepth, depth)
                        arrayCount++
                    }
                    ']' -> depth--
                    ':' -> fieldCount++
                    ',' -> elementCount++
                    't', 'f' -> if (input.substring(i).startsWith("true") || input.substring(i).startsWith("false")) {
                        typeDistribution["boolean"] = typeDistribution.getOrDefault("boolean", 0) + 1
                    }
                    'n' -> if (input.substring(i).startsWith("null")) {
                        typeDistribution["null"] = typeDistribution.getOrDefault("null", 0) + 1
                    }
                    in '0'..'9', '-' -> {
                        typeDistribution["number"] = typeDistribution.getOrDefault("number", 0) + 1
                        // Skip number
                        while (i < input.length && (input[i].isDigit() || input[i] in ".-eE+")) i++
                        i-- // Adjust for loop increment
                    }
                }
            }
            i++
        }
        
        JsonStructure(maxDepth, objectCount, arrayCount, fieldCount, elementCount, typeDistribution)
    }()
    
    /**
     * Compare structural similarity with another JSON
     */
    infix fun compareStructure(other: JsonScanner): StructuralComparison = {
        val thisStructure = extractStructure()
        val otherStructure = other.extractStructure()
        
        val isIsomorphic = thisStructure isIsomorphicTo otherStructure
        val similarity = computeSimilarity(thisStructure, otherStructure)
        
        StructuralComparison(isIsomorphic, similarity, thisStructure, otherStructure)
    }()
    
    /**
     * Query JSON using path (JSONPath-like)
     */
    fun query(path: List<JsonPath>): JsonQueryResult = {
        val parseResult = parse()
        val result = navigatePath(parseResult.element, path)
        
        JsonQueryResult(result, path)
    }()
    
    /**
     * Context Flow entry point
     */
    fun contextFlow(): JsonScannerFlow = JsonScannerFlow(this)
    
    /**
     * Recursive element parsing
     */
    private fun parseElement(input: String, startIndex: Int): Pair<JsonElement, Int> {
        var i = startIndex
        
        // Skip whitespace
        while (i < input.length && input[i].isWhitespace()) i++
        
        if (i >= input.length) throw IllegalArgumentException("Unexpected end of input")
        
        return when (input[i]) {
            '{' -> parseObject(input, i)
            '[' -> parseArray(input, i)
            '"' -> parseString(input, i)
            't', 'f' -> parseBoolean(input, i)
            'n' -> parseNull(input, i)
            else -> parseNumber(input, i)
        }
    }
    
    private fun parseObject(input: String, startIndex: Int): Pair<JsonElement.Object, Int> {
        var i = startIndex + 1 // Skip '{'
        val fields = mutableListOf<Join<String, JsonElement>>()
        
        // Skip whitespace
        while (i < input.length && input[i].isWhitespace()) i++
        
        if (i < input.length && input[i] == '}') {
            return JsonElement.Object(fields) to i + 1
        }
        
        while (i < input.length) {
            // Parse key
            val (keyElement, nextI) = parseString(input, i)
            val key = (keyElement as JsonElement.String).value
            i = nextI
            
            // Skip whitespace and colon
            while (i < input.length && (input[i].isWhitespace() || input[i] == ':')) i++
            
            // Parse value
            val (value, newI) = parseElement(input, i)
            fields.add(key j value)
            i = newI
            
            // Skip whitespace
            while (i < input.length && input[i].isWhitespace()) i++
            
            if (i < input.length && input[i] == '}') {
                return JsonElement.Object(fields) to i + 1
            } else if (i < input.length && input[i] == ',') {
                i++
                while (i < input.length && input[i].isWhitespace()) i++
            }
        }
        
        throw IllegalArgumentException("Unterminated object")
    }
    
    private fun parseArray(input: String, startIndex: Int): Pair<JsonElement.Array, Int> {
        var i = startIndex + 1 // Skip '['
        val elements = mutableListOf<JsonElement>()
        
        // Skip whitespace
        while (i < input.length && input[i].isWhitespace()) i++
        
        if (i < input.length && input[i] == ']') {
            return JsonElement.Array(elements) to i + 1
        }
        
        while (i < input.length) {
            val (element, nextI) = parseElement(input, i)
            elements.add(element)
            i = nextI
            
            // Skip whitespace
            while (i < input.length && input[i].isWhitespace()) i++
            
            if (i < input.length && input[i] == ']') {
                return JsonElement.Array(elements) to i + 1
            } else if (i < input.length && input[i] == ',') {
                i++
                while (i < input.length && input[i].isWhitespace()) i++
            }
        }
        
        throw IllegalArgumentException("Unterminated array")
    }
    
    private fun parseString(input: String, startIndex: Int): Pair<JsonElement.String, Int> {
        var i = startIndex + 1 // Skip opening quote
        val sb = StringBuilder()
        
        while (i < input.length) {
            when (input[i]) {
                '"' -> return JsonElement.String(sb.toString()) to i + 1
                '\\' -> {
                    i++
                    if (i < input.length) {
                        when (input[i]) {
                            '"', '\\', '/' -> sb.append(input[i])
                            'b' -> sb.append('\b')
                            'f' -> sb.append('\u000C')
                            'n' -> sb.append('\n')
                            'r' -> sb.append('\r')
                            't' -> sb.append('\t')
                            'u' -> {
                                // Unicode escape
                                if (i + 4 < input.length) {
                                    val hex = input.substring(i + 1, i + 5)
                                    sb.append(hex.toInt(16).toChar())
                                    i += 4
                                }
                            }
                            else -> sb.append(input[i])
                        }
                    }
                }
                else -> sb.append(input[i])
            }
            i++
        }
        
        throw IllegalArgumentException("Unterminated string")
    }
    
    private fun parseNumber(input: String, startIndex: Int): Pair<JsonElement.Number, Int> {
        var i = startIndex
        val sb = StringBuilder()
        
        while (i < input.length && (input[i].isDigit() || input[i] in ".-eE+")) {
            sb.append(input[i])
            i++
        }
        
        val value = sb.toString().toDoubleOrNull() ?: 0.0
        return JsonElement.Number(value) to i
    }
    
    private fun parseBoolean(input: String, startIndex: Int): Pair<JsonElement.Boolean, Int> {
        return when {
            input.substring(startIndex).startsWith("true") -> 
                JsonElement.Boolean(true) to startIndex + 4
            input.substring(startIndex).startsWith("false") -> 
                JsonElement.Boolean(false) to startIndex + 5
            else -> throw IllegalArgumentException("Invalid boolean")
        }
    }
    
    private fun parseNull(input: String, startIndex: Int): Pair<JsonElement.Null, Int> {
        return if (input.substring(startIndex).startsWith("null")) {
            JsonElement.Null to startIndex + 4
        } else {
            throw IllegalArgumentException("Invalid null")
        }
    }
    
    private fun navigatePath(element: JsonElement, path: List<JsonPath>): JsonElement? {
        if (path.isEmpty()) return element
        
        val head = path.first()
        val tail = path.drop(1)
        
        return when (element) {
            is JsonElement.Object -> when (head) {
                is JsonPath.Key -> {
                    val field = element.fields.find { it.a == head.name }
                    field?.b?.let { navigatePath(it, tail) }
                }
                else -> null
            }
            is JsonElement.Array -> when (head) {
                is JsonPath.Index -> {
                    if (head.value < element.elements.size) {
                        navigatePath(element.elements[head.value], tail)
                    } else null
                }
                else -> null
            }
            else -> null
        }
    }
    
    private fun computeSimilarity(s1: JsonStructure, s2: JsonStructure): Double {
        val depthSim = 1.0 - kotlin.math.abs(s1.depth - s2.depth) / kotlin.math.max(s1.depth, s2.depth).toDouble()
        val objectSim = 1.0 - kotlin.math.abs(s1.objectCount - s2.objectCount) / kotlin.math.max(s1.objectCount, s2.objectCount).toDouble()
        val arraySim = 1.0 - kotlin.math.abs(s1.arrayCount - s2.arrayCount) / kotlin.math.max(s1.arrayCount, s2.arrayCount).toDouble()
        
        return (depthSim + objectSim + arraySim) / 3.0
    }
}

/**
 * Context Flow for JSON operations
 */
@JvmInline
value class JsonScannerFlow(val scanner: JsonScanner) {
    
    /**
     * Structural analysis operations
     */
    fun structural(): JsonStructuralFlow = JsonStructuralFlow(scanner)
    
    /**
     * Query operations
     */
    fun query(): JsonQueryFlow = JsonQueryFlow(scanner)
    
    /**
     * Comparison operations
     */
    fun comparison(): JsonComparisonFlow = JsonComparisonFlow(scanner)
}

/**
 * Structural analysis flow
 */
@JvmInline
value class JsonStructuralFlow(val scanner: JsonScanner) {
    
    /**
     * Extract type schema
     */
    fun extractSchema(): JsonSchema = {
        val structure = scanner.extractStructure()
        val parseResult = scanner.parse()
        
        JsonSchema(
            structure = structure,
            rootType = parseResult.element::class.simpleName ?: "Unknown"
        )
    }()
    
    /**
     * Identify patterns
     */
    fun identifyPatterns(): List<JsonPattern> = {
        val structure = scanner.extractStructure()
        val patterns = mutableListOf<JsonPattern>()
        
        if (structure.arrayCount > structure.objectCount) {
            patterns.add(JsonPattern.ARRAY_DOMINANT)
        } else if (structure.objectCount > structure.arrayCount) {
            patterns.add(JsonPattern.OBJECT_DOMINANT)
        }
        
        if (structure.depth > 5) {
            patterns.add(JsonPattern.DEEPLY_NESTED)
        }
        
        patterns
    }()
}

/**
 * Query operations flow
 */
@JvmInline
value class JsonQueryFlow(val scanner: JsonScanner) {
    
    /**
     * Build query path
     */
    fun path(vararg segments: Any): JsonQueryResult = {
        val path = segments.map { segment ->
            when (segment) {
                is String -> JsonPath.Key(segment)
                is Int -> JsonPath.Index(segment)
                else -> throw IllegalArgumentException("Path segment must be String or Int")
            }
        }
        
        scanner.query(path)
    }()
}

/**
 * Comparison operations flow
 */
@JvmInline
value class JsonComparisonFlow(val scanner: JsonScanner) {
    
    /**
     * Find structural isomorphisms
     */
    fun findIsomorphisms(candidates: List<JsonScanner>): List<JsonScanner> =
        candidates.filter { candidate ->
            val comparison = scanner compareStructure candidate
            comparison.isIsomorphic
        }
    
    /**
     * Compute similarity scores
     */
    fun computeSimilarities(candidates: List<JsonScanner>): List<Pair<JsonScanner, Double>> =
        candidates.map { candidate ->
            val comparison = scanner compareStructure candidate
            candidate to comparison.similarity
        }.sortedByDescending { it.second }
}

/**
 * Supporting data types
 */
data class JsonParseResult(
    val element: JsonElement,
    val structure: JsonStructure
)

data class StructuralComparison(
    val isIsomorphic: Boolean,
    val similarity: Double,
    val structure1: JsonStructure,
    val structure2: JsonStructure
)

data class JsonQueryResult(
    val result: JsonElement?,
    val path: List<JsonPath>
)

data class JsonSchema(
    val structure: JsonStructure,
    val rootType: String
)

enum class JsonPattern {
    ARRAY_DOMINANT,
    OBJECT_DOMINANT,
    DEEPLY_NESTED,
    FLAT_STRUCTURE,
    MIXED_TYPES
}

/**
 * Extension functions for tensor integration
 */
fun Tensor<String>.parseJson(): List<JsonParseResult> =
    (0 until totalSize).map { i ->
        JsonScanner(flatGet(i)).parse()
    }

fun List<String>.findJsonIsomorphisms(): Map<JsonStructure, List<String>> =
    map { JsonScanner(it) }
        .groupBy { it.extractStructure() }
        .mapValues { (_, scanners) -> scanners.map { it.input } }

private fun <T> Tensor<T>.flatGet(index: Int): T {
    val coords = IntArray(rank)
    var remaining = index
    for (i in rank - 1 downTo 0) {
        coords[i] = remaining % shape[i]
        remaining /= shape[i]
    }
    return this[coords]
}