Trikeshed/src/commonMain/kotlin/borg/trikeshed/lib/Series.kt
```kotlin
package borg.trikeshed.lib

typealias Series<T> = Join<Int, (Int) -> T>

val <T> Series<T>.size: Int get() = a
operator fun <T> Series<T>.get(index: Int): T = b(index)

fun Series<Byte>.toByteArray(): ByteArray {
    return ByteArray(size) { i -> this[i] }
}

fun ByteArray.toSeries(): Series<Byte> = size j { this[it] }

fun <T> Series.Companion.of(size: Int, initializer: (Int) -> T): Series<T> = size j initializer

fun <T> emptySeries(): Series<T> = 0 j { throw IndexOutOfBoundsException("Empty series accessed") }

// Placeholder for CharSeries and its methods, as it's used in JsonParser
// In a real project, this would be a proper implementation or a different approach to char sequences.
class CharSeries(private val series: Series<Char>, var pos: Int = 0, var lim: Int = series.size) {
    constructor(s: String) : this(s.length j { s[it] })
    constructor(s: Series<Char>) : this(s, 0, s.size)

    val rem: Int get() = lim - pos
    val hasRemaining: Boolean get() = rem > 0

    fun get(index: Int): Char = series[pos + index]
    fun asString(): String = (pos until lim).joinToString("") { series[it].toString() }

    fun trim(): CharSeries {
        var start = pos
        while (start < lim && series[start].isWhitespace()) start++
        var end = lim - 1
        while (end >= start && series[end].isWhitespace()) end--
        return CharSeries(series, start, end + 1)
    }

    fun clone(): CharSeries = CharSeries(series, pos, lim)
    fun lim(newLim: Int): CharSeries {
        lim = newLim
        return this
    }
    fun pos(newPos: Int): CharSeries {
        pos = newPos
        return this
    }
    fun seekTo(char: Char): Boolean {
        val index = (pos until lim).find { series[it] == char }
        if (index != null) {
            pos = index + 1
            return true
        }
        return false
    }
    val slice: CharSeries get() = CharSeries(series, pos, lim)

    companion object {
        fun unquote(cs: CharSeries) {
            if (cs.hasRemaining && cs.get(0) == '"') {
                cs.pos++
            }
            if (cs.hasRemaining && cs.get(cs.rem - 1) == '"') {
                cs.lim--
            }
        }
        fun unbrace(cs: CharSeries): Boolean {
            if (cs.hasRemaining && cs.get(0) == '{') {
                cs.pos++
            }
            if (cs.hasRemaining && cs.get(cs.rem - 1) == '}') {
                cs.lim--
            }
            return true // Assuming it always succeeds for now
        }
    }
}

// Placeholder for combine function used in JsonParser
fun <T> combine(vararg series: Series<T>): Series<T> {
    val totalSize = series.sumOf { it.size }
    val elements = mutableListOf<T>()
    series.forEach { s ->
        (0 until s.size).forEach { i -> elements.add(s[i]) }
    }
    return elements.size j { elements[it] }
}

// Placeholder for s_ used in JsonParser
val s_ = " \t\r\n".toSeries()
```

