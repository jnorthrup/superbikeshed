```kotlin
package borg.trikeshed.reactor.http

import borg.trikeshed.lib.j
import borg.trikeshed.reactor.*
import kotlinx.coroutines.*
import kotlinx.coroutines.flow.*
import borg.trikeshed.lib.toSeries
import borg.trikeshed.platform.ByteBuffer

class HttpMotdReaction(
    private val reactor: Reactor,
    private val motd: String
) : UnaryAsyncReaction {
    override suspend fun invoke(reactorKey: SelectionKey): AsyncReaction? {
        val serverChannel = reactorKey.channel as ServerChannel
        val clientChannel = serverChannel.accept() ?: return OP_ACCEPT(this::invoke)

        clientChannel.configureBlocking(false)

        return OP_READ {
            object : UnaryAsyncReaction {
                override suspend fun invoke(key: SelectionKey): AsyncReaction? {
                    val clientChannel = key.channel as ClientChannel
                    val buffer = ByteBuffer.allocateDirect(2048) // Assuming ByteBuffer is available
                    val bytesRead = clientChannel.read(buffer)

                    if (bytesRead == -1) {
                        clientChannel.close()
                        return null
                    }

                    // Simplified: just write the MOTD and close.
                    val response = "HTTP/1.1 200 OK\r\nContent-Length: ${motd.length}\r\n\r\n$motd"
                    val responseBuffer = ByteBuffer.wrap(response.encodeToByteArray()) // Assuming ByteBuffer.wrap
                    
                    return OP_WRITE { writeKey ->
                        val written = (writeKey.channel as ClientChannel).write(responseBuffer)
                        if (!responseBuffer.hasRemaining()) {
                            writeKey.channel.close()
                            null
                        } else {
                            OP_WRITE(this::invoke)
                        }
                    }
                }
            }.invoke(clientChannel.register(reactorKey.selector, OP_READ(this::invoke).interest, null))
        }
    }
}
