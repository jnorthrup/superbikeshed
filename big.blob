=== rtsgame/archive/experiments/src/commonMain/kotlin/rtsgame/core/TrikeShedEntityManager.kt ===
================================================================================================
package rtsgame.core

import borg.trikeshed.lib.*

/**
 * TrikeShed-based Entity Manager using Series architecture for deterministic state management
 * Replaces array-based EntityManager with proper TrikeShed immutable data structures
 * 
 * Ported from JavaScript implementation with full Kotlin type safety
 */
class TrikeShedEntityManager {
    
    // Entity Series using proper TrikeShed types
    private var unitSeries: Series<Unit> = 0 j { throw IndexOutOfBoundsException("Empty unit series") }
    private var buildingSeries: Series<Building> = 0 j { throw IndexOutOfBoundsException("Empty building series") }
    private var projectileSeries: Series<Projectile> = 0 j { throw IndexOutOfBoundsException("Empty projectile series") }
    private var effectSeries: Series<Effect> = 0 j { throw IndexOutOfBoundsException("Empty effect series") }
    private var captionSeries: Series<Caption> = 0 j { throw IndexOutOfBoundsException("Empty caption series") }
    
    // ID counters for deterministic entity creation
    private var nextUnitId = 0
    private var nextBuildingId = 0
    private var nextProjectileId = 0
    private var nextEffectId = 0
    private var nextCaptionId = 0
    
    // Active entity counts for performance tracking
    val activeUnitCount: Int get() = unitSeries.size
    val activeBuildingCount: Int get() = buildingSeries.size
    val activeProjectileCount: Int get() = projectileSeries.size
    val activeEffectCount: Int get() = effectSeries.size
    val activeCaptionCount: Int get() = captionSeries.size
    
    /**
     * Convert a List to a TrikeShed Series
     */
    private fun <T> List<T>.toSeries(): Series<T> {
        if (isEmpty()) return 0 j { throw IndexOutOfBoundsException("Empty series") }
        return size j { index -> this[index] }
    }
    
    /**
     * Add a unit to the entity manager
     */
    fun addUnit(unit: Unit): Int {
        val unitId = nextUnitId++
        val units = unitSeries.toList().toMutableList()
        units.add(unit.copy(id = unitId))
        unitSeries = units.toSeries()
        return unitId
    }
    
    /**
     * Add a building to the entity manager
     */
    fun addBuilding(building: Building): Int {
        val buildingId = nextBuildingId++
        val buildings = buildingSeries.toList().toMutableList()
        buildings.add(building.copy(id = buildingId))
        buildingSeries = buildings.toSeries()
        return buildingId
    }
    
    /**
     * Add a projectile to the entity manager
     */
    fun addProjectile(projectile: Projectile): Int {
        val projectileId = nextProjectileId++
        val projectiles = projectileSeries.toList().toMutableList()
        projectiles.add(projectile.copy(id = projectileId))
        projectileSeries = projectiles.toSeries()
        return projectileId
    }
    
    /**
     * Get all units as Series
     */
    fun getUnits(): Series<Unit> = unitSeries
    
    /**
     * Get all buildings as Series
     */
    fun getBuildings(): Series<Building> = buildingSeries
    
    /**
     * Get all projectiles as Series
     */
    fun getProjectiles(): Series<Projectile> = projectileSeries
    
    /**
     * Update unit at specific position using Series transformation
     */
    fun updateUnit(index: Int, updater: (Unit) -> Unit): TrikeShedEntityManager {
        if (index >= unitSeries.size) return this
        
        val units = unitSeries.toList().toMutableList()
        units[index] = updater(units[index])
        return TrikeShedEntityManager().apply {
            unitSeries = units.toSeries()
            buildingSeries = this@TrikeShedEntityManager.buildingSeries
            projectileSeries = this@TrikeShedEntityManager.projectileSeries
            effectSeries = this@TrikeShedEntityManager.effectSeries
            captionSeries = this@TrikeShedEntityManager.captionSeries
        }
    }
    
    /**
     * Remove entity by filtering Series
     */
    fun removeUnit(unitId: Int): TrikeShedEntityManager {
        val units = unitSeries.toList().filter { it.id != unitId }
        return TrikeShedEntityManager().apply {
            unitSeries = units.toSeries()
            buildingSeries = this@TrikeShedEntityManager.buildingSeries
            projectileSeries = this@TrikeShedEntityManager.projectileSeries
            effectSeries = this@TrikeShedEntityManager.effectSeries
            captionSeries = this@TrikeShedEntityManager.captionSeries
        }
    }
    
    /**
     * Convert Series to List for compatibility
     */
    private fun <T> Series<T>.toList(): List<T> {
        return (0 until size).map { this[it] }
    }
}

// Entity data classes using TrikeShed patterns
data class Unit(
    val id: Int = 0,
    val type: String = "",
    val position: Join<Float, Float> = 0f j 0f,
    val health: Join<Float, Float> = 100f j 100f, // current j max
    val team: String = "",
    val authority: Float = 1.0f,
    val veterancy: Int = 0,
    val computroniumCores: Int = 0
)

data class Building(
    val id: Int = 0,
    val type: String = "",
    val position: Join<Float, Float> = 0f j 0f,
    val health: Join<Float, Float> = 100f j 100f,
    val team: String = "",
    val constructionProgress: Float = 1.0f
)

data class Projectile(
    val id: Int = 0,
    val position: Join<Float, Float> = 0f j 0f,
    val velocity: Join<Float, Float> = 0f j 0f,
    val damage: Float = 10f,
    val remainingTime: Float = 1.0f
)

data class Effect(
    val id: Int = 0,
    val position: Join<Float, Float> = 0f j 0f,
    val type: String = "",
    val remainingTime: Float = 1.0f
)

data class Caption(
    val id: Int = 0,
    val position: Join<Float, Float> = 0f j 0f,
    val text: String = "",
    val remainingTime: Float = 3.0f
)
