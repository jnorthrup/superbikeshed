package rtsgame.tools

import rtsgame.core.*
import rtsgame.config.SimulationConfig
import borg.trikeshed.lib.*
import kotlinx.coroutines.*

/**
 * Battle Simulator - Advanced scenario testing and AI evaluation
 * Ported from JavaScript implementation with comprehensive TrikeShed integration
 */
class BattleSimulator {
    
    private val simulationManager = SimulationManager()
    private val scenarioLibrary = mutableMapOf<String, BattleScenario>()
    
    init {
        loadBuiltInScenarios()
    }
    
    /**
     * Run a comprehensive battle analysis
     */
    suspend fun runBattleAnalysis(
        scenario: BattleScenario,
        iterations: Int = 10
    ): BattleAnalysis {
        
        val results = mutableListOf<SimulationResult>()
        val strategies = mutableMapOf<String, StrategyStats>()
        
        // Run multiple iterations for statistical analysis
        repeat(iterations) { iteration ->
            val result = simulationManager.runSimulation(
                duration = scenario.duration,
                seed = scenario.baseSeed + iteration,
                headless = true
            )
            results.add(result)
            
            // Track strategy effectiveness
            result.winner?.let { winner ->
                val stats = strategies.getOrPut(winner) { StrategyStats() }
                stats.wins++
                stats.totalFrames += result.frameCount
                stats.avgDuration = (stats.avgDuration * (stats.wins - 1) + result.duration) / stats.wins
            }
        }
        
        return BattleAnalysis(
            scenario = scenario,
            iterations = iterations,
            results = results,
            strategyStats = strategies,
            overallStats = calculateOverallStats(results),
            determinismCheck = checkDeterminism(results),
            performanceMetrics = calculatePerformanceMetrics(results)
        )
    }
    
    /**
     * Compare multiple AI strategies
     */
    suspend fun compareStrategies(
        strategies: List<AIStrategy>,
        scenario: BattleScenario,
        matchesPerPair: Int = 5
    ): StrategyComparison {
        
        val matchResults = mutableListOf<StrategyMatch>()
        
        // Run round-robin tournament
        for (i in strategies.indices) {
            for (j in i + 1 until strategies.size) {
                val strategyA = strategies[i]
                val strategyB = strategies[j]
                
                val matches = runStrategyMatches(strategyA, strategyB, scenario, matchesPerPair)
                matchResults.addAll(matches)
            }
        }
        
        return StrategyComparison(
            strategies = strategies,
            scenario = scenario,
            matches = matchResults,
            rankings = calculateStrategyRankings(strategies, matchResults),
            statistics = calculateStrategyStatistics(matchResults)
        )
    }
    
    /**
     * Run performance benchmarks
     */
    suspend fun runPerformanceBenchmark(
        scenarios: List<BattleScenario> = getDefaultBenchmarkScenarios()
    ): PerformanceBenchmark {
        
        val benchmarkResults = mutableListOf<BenchmarkResult>()
        
        for (scenario in scenarios) {
            val startTime = System.currentTimeMillis()
            
            // Run scenario multiple times for stable measurements
            val results = (1..3).map { iteration ->
                simulationManager.runSimulation(
                    duration = scenario.duration,
                    seed = scenario.baseSeed + iteration,
                    headless = true
                )
            }
            
            val endTime = System.currentTimeMillis()
            val totalTime = endTime - startTime
            
            val benchmarkResult = BenchmarkResult(
                scenario = scenario,
                totalTime = totalTime,
                avgFrameRate = results.map { it.frameCount.toDouble() / it.duration }.average(),
                avgMemoryUsage = 0.0, // Placeholder - would need memory profiling
                stability = results.all { it.success },
                frameRateVariance = calculateVariance(results.map { it.frameCount.toDouble() / it.duration })
            )
            
            benchmarkResults.add(benchmarkResult)
        }
        
        return PerformanceBenchmark(
            results = benchmarkResults,
            systemInfo = getSystemInfo(),
            timestamp = System.currentTimeMillis()
        )
    }
    
    /**
     * Test simulation determinism
     */
    suspend fun testDeterminism(
        seed: Long = 12345L,
        iterations: Int = 5,
        duration: Int = 10
    ): DeterminismTest {
        
        val comparisonResult = simulationManager.runComparisonTest(seed, iterations)
        
        // Additional determinism checks
        val frameCountVariance = calculateVariance(comparisonResult.results.map { it.frameCount.toDouble() })
        val durationVariance = calculateVariance(comparisonResult.results.map { it.duration })
        
        return DeterminismTest(
            seed = seed,
            iterations = iterations,
            isDeterministic = comparisonResult.isDeterministic,
            frameCountVariance = frameCountVariance,
            durationVariance = durationVariance,
            results = comparisonResult.results,
            analysis = analyzeDeterminismFailures(comparisonResult.results)
        )
    }
    
    /**
     * Generate simulation report
     */
    fun generateReport(
        battleAnalysis: BattleAnalysis,
        strategyComparison: StrategyComparison? = null,
        performanceBenchmark: PerformanceBenchmark? = null
    ): SimulationReport {
        
        return SimulationReport(
            battleAnalysis = battleAnalysis,
            strategyComparison = strategyComparison,
            performanceBenchmark = performanceBenchmark,
            generatedAt = System.currentTimeMillis(),
            summary = generateReportSummary(battleAnalysis, strategyComparison, performanceBenchmark)
        )
    }
    
    // Private helper methods
    
    private fun loadBuiltInScenarios() {
        scenarioLibrary["basic_combat"] = BattleScenario(
            name = "Basic Combat",
            description = "Simple 5v5 unit engagement",
            duration = 30,
            baseSeed = 12345L,
            initialSetup = BasicCombatSetup()
        )
        
        scenarioLibrary["resource_rush"] = BattleScenario(
            name = "Resource Rush",
            description = "Early game resource competition",
            duration = 60,
            baseSeed = 54321L,
            initialSetup = ResourceRushSetup()
        )
        
        scenarioLibrary["late_game"] = BattleScenario(
            name = "Late Game",
            description = "High-tech unit compositions",
            duration = 120,
            baseSeed = 98765L,
            initialSetup = LateGameSetup()
        )
    }
    
    private suspend fun runStrategyMatches(
        strategyA: AIStrategy,
        strategyB: AIStrategy,
        scenario: BattleScenario,
        matches: Int
    ): List<StrategyMatch> {
        
        return (1..matches).map { matchNumber ->
            val result = simulationManager.runSimulation(
                duration = scenario.duration,
                seed = scenario.baseSeed + matchNumber,
                headless = true
            )
            
            StrategyMatch(
                strategyA = strategyA,
                strategyB = strategyB,
                result = result,
                winner = result.winner,
                matchNumber = matchNumber
            )
        }
    }
    
    private fun calculateOverallStats(results: List<SimulationResult>): OverallStats {
        val successfulResults = results.filter { it.success }
        
        return OverallStats(
            totalBattles = results.size,
            successfulBattles = successfulResults.size,
            avgDuration = successfulResults.map { it.duration }.average(),
            avgFrameCount = successfulResults.map { it.frameCount }.average(),
            winRates = calculateWinRates(successfulResults)
        )
    }
    
    private fun checkDeterminism(results: List<SimulationResult>): DeterminismCheck {
        if (results.size < 2) return DeterminismCheck(true, emptyList())
        
        val firstResult = results.first()
        val differences = results.drop(1).mapIndexed { index, result ->
            if (result.frameCount != firstResult.frameCount) {
                "Result ${index + 1}: frame count ${result.frameCount} vs ${firstResult.frameCount}"
            } else null
        }.filterNotNull()
        
        return DeterminismCheck(differences.isEmpty(), differences)
    }
    
    private fun calculatePerformanceMetrics(results: List<SimulationResult>): PerformanceMetrics {
        val frameRates = results.map { it.frameCount.toDouble() / it.duration }
        
        return PerformanceMetrics(
            avgFrameRate = frameRates.average(),
            minFrameRate = frameRates.minOrNull() ?: 0.0,
            maxFrameRate = frameRates.maxOrNull() ?: 0.0,
            frameRateStdDev = calculateStandardDeviation(frameRates)
        )
    }
    
    private fun calculateVariance(values: List<Double>): Double {
        if (values.isEmpty()) return 0.0
        val mean = values.average()
        return values.map { (it - mean) * (it - mean) }.average()
    }
    
    private fun calculateStandardDeviation(values: List<Double>): Double {
        return kotlin.math.sqrt(calculateVariance(values))
    }
    
    private fun calculateWinRates(results: List<SimulationResult>): Map<String, Double> {
        val totalGames = results.size.toDouble()
        return results.groupBy { it.winner ?: "draw" }
            .mapValues { (_, wins) -> wins.size / totalGames }
    }
    
    private fun calculateStrategyRankings(
        strategies: List<AIStrategy>,
        matches: List<StrategyMatch>
    ): List<StrategyRanking> {
        return strategies.map { strategy ->
            val wins = matches.count { it.winner == strategy.name }
            val totalMatches = matches.count { 
                it.strategyA.name == strategy.name || it.strategyB.name == strategy.name 
            }
            val winRate = if (totalMatches > 0) wins.toDouble() / totalMatches else 0.0
            
            StrategyRanking(strategy, wins, totalMatches, winRate)
        }.sortedByDescending { it.winRate }
    }
    
    private fun calculateStrategyStatistics(matches: List<StrategyMatch>): StrategyStatistics {
        return StrategyStatistics(
            totalMatches = matches.size,
            avgMatchDuration = matches.map { it.result.duration }.average(),
            mostEffectiveStrategy = matches.groupBy { it.winner }
                .maxByOrNull { it.value.size }?.key ?: "Unknown"
        )
    }
    
    private fun getDefaultBenchmarkScenarios(): List<BattleScenario> {
        return listOf(
            scenarioLibrary["basic_combat"]!!,
            scenarioLibrary["resource_rush"]!!,
            scenarioLibrary["late_game"]!!
        )
    }
    
    private fun getSystemInfo(): SystemInfo {
        return SystemInfo(
            platform = "Kotlin Multiplatform",
            runtime = "JVM", // Would be platform-specific
            processors = Runtime.getRuntime().availableProcessors(),
            maxMemory = Runtime.getRuntime().maxMemory()
        )
    }
    
    private fun analyzeDeterminismFailures(results: List<SimulationResult>): DeterminismAnalysis {
        // Analyze why determinism might have failed
        return DeterminismAnalysis(
            hasRandomSeedIssues = false, // Would implement actual analysis
            hasTimingIssues = false,
            hasStateInconsistencies = false,
            recommendations = listOf("Check random number generator", "Verify state updates")
        )
    }
    
    private fun generateReportSummary(
        battleAnalysis: BattleAnalysis,
        strategyComparison: StrategyComparison?,
        performanceBenchmark: PerformanceBenchmark?
    ): String {
        return buildString {
            appendLine("Simulation Report Summary")
            appendLine("========================")
            appendLine("Battle Analysis: ${battleAnalysis.iterations} iterations of ${battleAnalysis.scenario.name}")
            appendLine("Success Rate: ${battleAnalysis.overallStats.successfulBattles}/${battleAnalysis.overallStats.totalBattles}")
            
            strategyComparison?.let {
                appendLine("Strategy Comparison: ${it.strategies.size} strategies, ${it.matches.size} matches")
            }
            
            performanceBenchmark?.let {
                val avgFrameRate = it.results.map { r -> r.avgFrameRate }.average()
                appendLine("Performance: Avg ${String.format("%.1f", avgFrameRate)} FPS")
            }
        }
    }
}

// Data classes for battle simulation

data class BattleScenario(
    val name: String,
    val description: String,
    val duration: Int,
    val baseSeed: Long,
    val initialSetup: ScenarioSetup
)

interface ScenarioSetup
class BasicCombatSetup : ScenarioSetup
class ResourceRushSetup : ScenarioSetup  
class LateGameSetup : ScenarioSetup

data class AIStrategy(
    val name: String,
    val description: String,
    val aggressiveness: Float = 0.5f,
    val economicFocus: Float = 0.5f,
    val techFocus: Float = 0.5f
)

data class BattleAnalysis(
    val scenario: BattleScenario,
    val iterations: Int,
    val results: List<SimulationResult>,
    val strategyStats: Map<String, StrategyStats>,
    val overallStats: OverallStats,
    val determinismCheck: DeterminismCheck,
    val performanceMetrics: PerformanceMetrics
)

data class StrategyStats(
    var wins: Int = 0,
    var totalFrames: Long = 0,
    var avgDuration: Double = 0.0
)

data class OverallStats(
    val totalBattles: Int,
    val successfulBattles: Int,
    val avgDuration: Double,
    val avgFrameCount: Double,
    val winRates: Map<String, Double>
)

data class DeterminismCheck(
    val isPassed: Boolean,
    val differences: List<String>
)

data class PerformanceMetrics(
    val avgFrameRate: Double,
    val minFrameRate: Double,
    val maxFrameRate: Double,
    val frameRateStdDev: Double
)

data class StrategyComparison(
    val strategies: List<AIStrategy>,
    val scenario: BattleScenario,
    val matches: List<StrategyMatch>,
    val rankings: List<StrategyRanking>,
    val statistics: StrategyStatistics
)

data class StrategyMatch(
    val strategyA: AIStrategy,
    val strategyB: AIStrategy,
    val result: SimulationResult,
    val winner: String?,
    val matchNumber: Int
)

data class StrategyRanking(
    val strategy: AIStrategy,
    val wins: Int,
    val totalMatches: Int,
    val winRate: Double
)

data class StrategyStatistics(
    val totalMatches: Int,
    val avgMatchDuration: Double,
    val mostEffectiveStrategy: String
)

data class PerformanceBenchmark(
    val results: List<BenchmarkResult>,
    val systemInfo: SystemInfo,
    val timestamp: Long
)

data class BenchmarkResult(
    val scenario: BattleScenario,
    val totalTime: Long,
    val avgFrameRate: Double,
    val avgMemoryUsage: Double,
    val stability: Boolean,
    val frameRateVariance: Double
)

data class SystemInfo(
    val platform: String,
    val runtime: String,
    val processors: Int,
    val maxMemory: Long
)

data class DeterminismTest(
    val seed: Long,
    val iterations: Int,
    val isDeterministic: Boolean,
    val frameCountVariance: Double,
    val durationVariance: Double,
    val results: List<SimulationResult>,
    val analysis: DeterminismAnalysis
)

data class DeterminismAnalysis(
    val hasRandomSeedIssues: Boolean,
    val hasTimingIssues: Boolean,
    val hasStateInconsistencies: Boolean,
    val recommendations: List<String>
)

data class SimulationReport(
    val battleAnalysis: BattleAnalysis,
    val strategyComparison: StrategyComparison?,
    val performanceBenchmark: PerformanceBenchmark?,
    val generatedAt: Long,
    val summary: String
)
