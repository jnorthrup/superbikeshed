#### +    // Note: sqrt is not standard in Java's BigDecimal. This requires a custom implementation or a library.  
#### +    // For simplicity, we'll use a double-based calculation which may lose precision.  
#### +    actual fun BigDecimal.sqrt(scale: Int, roundingMode: RoundingMode): BigDecimal {  
#### +        val mc = MathContext(scale, roundingMode.toJavaRoundingMode())  
#### +        return BigDecimal(this.delegate.sqrt(mc))  
#### +    }  
#### +  
#### +    actual fun BigDecimal.compareTo(other: BigDecimal): Int =  
#### +        this.delegate.compareTo(other.delegate)  
#### +  
#### +    actual val BigDecimal.isZero: Boolean get() = this.delegate.compareTo(JavaBigDecimal.ZERO) == 0  
#### +    actual val BigDecimal.isPositive: Boolean get() = this.delegate.compareTo(JavaBigDecimal.ZERO) > 0  
#### +    actual val BigDecimal.isNegative: Boolean get() = this.delegate.compareTo(JavaBigDecimal.ZERO) < 0  
#### +  
#### +    actual fun BigDecimal.abs(): BigDecimal = BigDecimal(this.delegate.abs())  
#### +    actual fun BigDecimal.negate(): BigDecimal = BigDecimal(this.delegate.negate())  
