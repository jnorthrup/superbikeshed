```kotlin
package borg.trikeshed.services

import borg.trikeshed.lib.Join
import borg.trikeshed.lib.Series
import borg.trikeshed.lib.collections.Either
import borg.trikeshed.lib.toSeries
import borg.trikeshed.parse.json.JsonParser
import borg.trikeshed.qol.left
import borg.trikeshed.qol.right
import borg.trikeshed.qol.tuple

interface RequestFactoryService {
    suspend fun process(payload: Series<Byte>): Series<Byte>
    fun registerServiceLocator(serviceClass: String, locator: () -> Any)
    fun registerMethodValidator(methodName: String, validator: (Join<Int, (Int) -> Any?>) -> Boolean)
    suspend fun <T : Any> createDocument(doc: T, id: String? = null): Either<String, Pair<String, String>>
    suspend fun <T : Any> getDocument(id: String): Either<String, T>
    suspend fun <T : Any> updateDocument(id: String, rev: String, doc: T): Either<String, String>
    suspend fun deleteDocument(id: String, rev: String): Either<String, Boolean>
    suspend fun <T : Any> bulkDocs(docs: List<T>): Either<String, List<Pair<String, String>>>
}

class RequestFactoryServiceImpl : RequestFactoryService by CouchRequestFactoryService()
