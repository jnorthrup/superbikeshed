# Superbikeshed MCP Server

Simple MCP server for Kotlin/GWT compilation. Compose-first, gradual evolution.

## Quick Start

```bash
docker-compose up
```

Endpoints:
- `ws://localhost:8090/mcp` - MCP WebSocket
- `http://localhost:8091` - Compose UI

## Architecture

```
MCP Server (Kotlin/Compose)
    ├── Kotlin Compiler Service
    ├── GWT/J2CL Bridge (to Viola)
    └── Compose Web UI
```

## Evolution Path

1. **Now**: Proxy to viola.colinalworth.com
2. **Next**: Add Kotlin compilation 
3. **Later**: Replace pieces as needed

Keep it simple. Less is more.
===============================================================================================
=== superbikeshed-mcp-server/server/src/jvmMain/kotlin/com/superbikeshed/mcp/server/Main.kt ===
===============================================================================================
package com.superbikeshed.mcp.server

import io.ktor.server.application.*
import io.ktor.server.engine.*
import io.ktor.server.netty.*
import io.ktor.server.routing.*
import io.ktor.server.websocket.*
import io.ktor.websocket.*
import kotlinx.coroutines.channels.consumeEach
import kotlinx.serialization.json.Json
import com.superbikeshed.mcp.protocol.*
import kotlinx.serialization.json.*
import io.ktor.serialization.kotlinx.*
import io.ktor.server.plugins.contentnegotiation.*
import io.ktor.serialization.kotlinx.json.*
import io.ktor.server.plugins.cors.routing.*
import io.ktor.http.*
import io.ktor.server.response.*
import io.ktor.server.http.content.*
import kotlinx.serialization.Serializable
import java.time.Duration

fun main() {
    val port = System.getenv("MCP_PORT")?.toIntOrNull() ?: 8090
    embeddedServer(Netty, port = port) {
        configureServer()
    }.start(wait = true)
}

fun Application.configureServer() {
    install(ContentNegotiation) {
        json(Json {
            prettyPrint = true
            isLenient = true
            ignoreUnknownKeys = true
        })
    }
    
    install(CORS) {
        allowMethod(HttpMethod.Options)
        allowMethod(HttpMethod.Get)
        allowMethod(HttpMethod.Post)
        allowHeader(HttpHeaders.Authorization)
        allowHeader(HttpHeaders.ContentType)
        anyHost()
    }
    
    install(WebSockets) {
        pingPeriod = Duration.ofSeconds(15)
        timeout = Duration.ofSeconds(15)
        maxFrameSize = Long.MAX_VALUE
        masking = false
    }
    
    val mcpServer = McpServer()
    
    routing {
        get("/") {
            call.respondText(
                """
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Superbikeshed MCP Server</title>
                    <style>
                        body {
                            font-family: Arial, sans-serif;
                            margin: 40px;
                            text-align: center;
                        }
                        .duck {
                            font-size: 72px;
                            margin: 20px;
                        }
                        .info {
                            background: #f0f0f0;
                            padding: 20px;
                            border-radius: 10px;
                            display: inline-block;
                            margin: 20px;
                        }
                    </style>
                </head>
                <body>
                    <h1>🦆 Duck! 🦆</h1>
                    <div class="duck">DUCK</div>
                    <div class="info">
                        <h2>Superbikeshed MCP Server</h2>
                        <p>WebSocket endpoint: <code>ws://localhost:8090/mcp</code></p>
                        <p>Health check: <a href="/health">/health</a></p>
                    </div>
                </body>
                </html>
                """.trimIndent(),
                ContentType.Text.Html
            )
        }
        
        get("/health") {
            call.respondText("{\"status\":\"healthy\"}", ContentType.Application.Json)
        }
        
        webSocket("/mcp") {
            mcpServer.handleSession(this)
        }
    }
}

class McpServer {
    private val json = Json {
        prettyPrint = true
        isLenient = true
        ignoreUnknownKeys = true
    }
    
    suspend fun handleSession(session: DefaultWebSocketServerSession) {
        session.incoming.consumeEach { frame ->
            when (frame) {
                is Frame.Text -> {
                    val text = frame.readText()
                    handleMessage(session, text)
                }
                else -> {}
            }
        }
    }
    
    private suspend fun handleMessage(session: DefaultWebSocketServerSession, message: String) {
        try {
            val request = json.decodeFromString<McpRequest>(message)
            
            when (request.method) {
                "initialize" -> handleInitialize(session, request)
                "tools/list" -> handleToolsList(session, request)
                "tools/call" -> handleToolCall(session, request)
                "resources/list" -> handleResourcesList(session, request)
                "prompts/list" -> handlePromptsList(session, request)
                else -> sendError(session, request.id, -32601, "Method not found")
            }
        } catch (e: Exception) {
            sendError(session, "null", -32700, "Parse error: ${e.message}")
        }
    }
    
    private suspend fun handleInitialize(session: DefaultWebSocketServerSession, request: McpRequest) {
        val result = InitializeResult(
            protocolVersion = "1.0.0",
            capabilities = ServerCapabilities(
                tools = ToolsCapability(listChanged = true),
                resources = ResourcesCapability(subscribe = true, listChanged = true),
                prompts = PromptsCapability(listChanged = true),
                logging = LoggingCapability(enabled = true)
            ),
            serverInfo = ServerInfo(
                name = "Superbikeshed MCP Server",
                version = "1.0.0"
            )
        )
        
        val response = McpResponse(
            id = request.id,
            result = json.encodeToJsonElement(result)
        )
        
        session.send(Frame.Text(json.encodeToString(McpResponse.serializer(), response)))
    }
    
    private suspend fun handleToolsList(session: DefaultWebSocketServerSession, request: McpRequest) {
        val tools = listOf(
            Tool(
                name = "echo",
                description = "Echo test tool",
                inputSchema = buildJsonObject {
                    put("type", "object")
                    put("properties", buildJsonObject {
                        put("message", buildJsonObject {
                            put("type", "string")
                        })
                    })
                }
            )
        )
        
        val response = McpResponse(
            id = request.id,
            result = json.encodeToJsonElement(ToolsListResult(tools = tools))
        )
        session.send(Frame.Text(json.encodeToString(McpResponse.serializer(), response)))
    }
    
    private suspend fun handleToolCall(session: DefaultWebSocketServerSession, request: McpRequest) {
        try {
            val params = request.params?.let { json.decodeFromJsonElement<ToolCallParams>(it) }
                ?: throw IllegalArgumentException("Missing tool call parameters")
            
            val result = when (params.name) {
                "echo" -> {
                    val message = params.arguments?.jsonObject?.get("message")?.jsonPrimitive?.content ?: "No message"
                    buildJsonObject { put("result", message) }
                }
                else -> throw IllegalArgumentException("Unknown tool: ${params.name}")
            }
            
            val response = McpResponse(
                id = request.id,
                result = json.encodeToJsonElement(ToolCallResult(
                    content = listOf(ToolContent(
                        type = "text",
                        text = result.toString()
                    ))
                ))
            )
            session.send(Frame.Text(json.encodeToString(McpResponse.serializer(), response)))
        } catch (e: Exception) {
            sendError(session, request.id, -32603, "Tool execution failed: ${e.message}")
        }
    }
    
    private suspend fun handleResourcesList(session: DefaultWebSocketServerSession, request: McpRequest) {
        val response = McpResponse(
            id = request.id,
            result = json.encodeToJsonElement(ResourcesListResult(resources = emptyList()))
        )
        session.send(Frame.Text(json.encodeToString(McpResponse.serializer(), response)))
    }
    
    private suspend fun handlePromptsList(session: DefaultWebSocketServerSession, request: McpRequest) {
        val response = McpResponse(
            id = request.id,
            result = json.encodeToJsonElement(PromptsListResult(prompts = emptyList()))
        )
        session.send(Frame.Text(json.encodeToString(McpResponse.serializer(), response)))
    }
    
    private suspend fun sendError(session: DefaultWebSocketServerSession, id: String, code: Int, message: String) {
        val response = McpResponse(
            id = id,
            error = McpError(code, message)
        )
        session.send(Frame.Text(json.encodeToString(McpResponse.serializer(), response)))
    }
}

@Serializable
data class InitializeResult(
    val protocolVersion: String,
    val capabilities: ServerCapabilities,
    val serverInfo: ServerInfo
)

@Serializable
data class ServerInfo(
    val name: String,
    val version: String? = null
)

@Serializable
data class ToolsListResult(
    val tools: List<Tool>
)

@Serializable
data class Tool(
    val name: String,
    val description: String? = null,
    val inputSchema: JsonElement
)

@Serializable
data class ResourcesListResult(
    val resources: List<Resource>
)

@Serializable
data class Resource(
    val uri: String,
    val name: String,
    val description: String? = null,
    val mimeType: String? = null
)

@Serializable
data class PromptsListResult(
    val prompts: List<Prompt>
)

@Serializable
data class Prompt(
    val name: String,
    val description: String? = null,
    val arguments: List<PromptArgument>? = null
)

@Serializable
data class PromptArgument(
    val name: String,
    val description: String? = null,
    val required: Boolean? = null
)

@Serializable
data class ToolCallParams(
    val name: String,
    val arguments: JsonElement? = null
)

@Serializable
data class ToolCallResult(
    val content: List<ToolContent>
)

@Serializable
data class ToolContent(
    val type: String,
    val text: String
)
