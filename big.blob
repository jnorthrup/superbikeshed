package rtsgame.core

import rtsgame.config.SimulationConfig
import borg.trikeshed.lib.*
import kotlinx.coroutines.*

/**
 * Simulation Manager - Orchestrates multiple simulation engines and scenarios
 * Ported from JavaScript implementation with Kotlin coroutines and TrikeShed integration
 */
class SimulationManager {
    
    private val gameEngines = mutableListOf<GameEngine>()
    private val simulationResults = mutableListOf<SimulationResult>()
    private var currentSimulation: GameEngine? = null
    private var simulationScope = CoroutineScope(Dispatchers.Default + SupervisorJob())
    
    /**
     * Create a new simulation engine instance
     */
    suspend fun createSimulation(): GameEngine {
        val engine = GameEngine()
        engine.initialize()
        gameEngines.add(engine)
        return engine
    }
    
    /**
     * Run a single simulation scenario
     */
    suspend fun runSimulation(
        duration: Int = SimulationConfig.SIMULATION_DURATION_SECONDS,
        seed: Long = SimulationConfig.GAME_SEED,
        headless: Boolean = SimulationConfig.HEADLESS_MODE
    ): SimulationResult {
        
        val engine = createSimulation()
        currentSimulation = engine
        
        val startTime = System.currentTimeMillis()
        
        try {
            // Start simulation
            engine.startSimulation()
            
            // Run for specified duration
            delay(duration * 1000L)
            
            // Stop simulation
            engine.stopSimulation()
            
            val endTime = System.currentTimeMillis()
            val actualDuration = (endTime - startTime) / 1000.0
            
            val result = SimulationResult(
                duration = actualDuration,
                seed = seed,
                headless = headless,
                success = true,
                startTime = startTime,
                endTime = endTime,
                frameCount = engine.gameState.currentFrame,
                events = engine.battleJournal.getEvents()
            )
            
            simulationResults.add(result)
            return result
            
        } catch (e: Exception) {
            val endTime = System.currentTimeMillis()
            val result = SimulationResult(
                duration = (endTime - startTime) / 1000.0,
                seed = seed,
                headless = headless,
                success = false,
                startTime = startTime,
                endTime = endTime,
                frameCount = 0,
                events = emptyList(),
                error = e.message
            )
            
            simulationResults.add(result)
            return result
        }
    }
    
    /**
     * Run multiple simulation scenarios in parallel
     */
    suspend fun runBatchSimulations(
        scenarios: List<SimulationScenario>
    ): List<SimulationResult> {
        
        val results = scenarios.map { scenario ->
            simulationScope.async {
                runSimulation(
                    duration = scenario.duration,
                    seed = scenario.seed,
                    headless = scenario.headless
                )
            }
        }
        
        return results.awaitAll()
    }
    
    /**
     * Run deterministic comparison simulations
     */
    suspend fun runComparisonTest(
        seed: Long,
        iterations: Int = 5
    ): ComparisonResult {
        
        val scenarios = (1..iterations).map { i ->
            SimulationScenario(
                name = "Deterministic Test $i",
                seed = seed, // Same seed for all iterations
                duration = 10,
                headless = true
            )
        }
        
        val results = runBatchSimulations(scenarios)
        
        // Analyze determinism
        val isDeterministic = results.all { result ->
            result.success && result.frameCount == results.first().frameCount
        }
        
        return ComparisonResult(
            seed = seed,
            iterations = iterations,
            isDeterministic = isDeterministic,
            results = results,
            avgFrameCount = results.map { it.frameCount }.average(),
            avgDuration = results.map { it.duration }.average()
        )
    }
    
    /**
     * Export simulation data for analysis
     */
    fun exportSimulationData(): SimulationExport {
        return SimulationExport(
            results = simulationResults.toList(),
            totalSimulations = simulationResults.size,
            successfulSimulations = simulationResults.count { it.success },
            avgDuration = simulationResults.map { it.duration }.average(),
            exportTime = System.currentTimeMillis()
        )
    }
    
    /**
     * Get performance statistics
     */
    fun getPerformanceStats(): PerformanceStats {
        val successfulResults = simulationResults.filter { it.success }
        
        return PerformanceStats(
            totalSimulations = simulationResults.size,
            successfulSimulations = successfulResults.size,
            failedSimulations = simulationResults.size - successfulResults.size,
            avgFrameRate = successfulResults.map { 
                it.frameCount / it.duration 
            }.average(),
            avgSimulationTime = successfulResults.map { it.duration }.average(),
            totalFramesProcessed = successfulResults.sumOf { it.frameCount }
        )
    }
    
    /**
     * Stop all running simulations
     */
    fun stopAllSimulations() {
        gameEngines.forEach { it.stopSimulation() }
        simulationScope.cancel()
        simulationScope = CoroutineScope(Dispatchers.Default + SupervisorJob())
    }
    
    /**
     * Clear simulation history
     */
    fun clearHistory() {
        simulationResults.clear()
        gameEngines.clear()
    }
}

/**
 * Simulation scenario configuration
 */
data class SimulationScenario(
    val name: String,
    val seed: Long = System.currentTimeMillis(),
    val duration: Int = 10,
    val headless: Boolean = true,
    val initialBlueUnits: Int = 5,
    val initialRedUnits: Int = 5,
    val mapSize: Int = 2000,
    val enableAI: Boolean = true
)

/**
 * Simulation result data
 */
data class SimulationResult(
    val duration: Double,
    val seed: Long,
    val headless: Boolean,
    val success: Boolean,
    val startTime: Long,
    val endTime: Long,
    val frameCount: Long,
    val events: List<BattleEvent>,
    val error: String? = null,
    val winner: String? = null,
    val finalUnitCounts: Map<String, Int> = emptyMap()
)

/**
 * Comparison test result
 */
data class ComparisonResult(
    val seed: Long,
    val iterations: Int,
    val isDeterministic: Boolean,
    val results: List<SimulationResult>,
    val avgFrameCount: Double,
    val avgDuration: Double
)

/**
 * Simulation data export
 */
data class SimulationExport(
    val results: List<SimulationResult>,
    val totalSimulations: Int,
    val successfulSimulations: Int,
    val avgDuration: Double,
    val exportTime: Long
)

/**
 * Performance statistics
 */
data class PerformanceStats(
    val totalSimulations: Int,
    val successfulSimulations: Int,
    val failedSimulations: Int,
    val avgFrameRate: Double,
    val avgSimulationTime: Double,
    val totalFramesProcessed: Long
)
