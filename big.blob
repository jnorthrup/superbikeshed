package rtsgame.core

import rtsgame.config.GameConstants
import rtsgame.config.SimulationConfig
import borg.trikeshed.lib.*
import kotlinx.coroutines.*

/**
 * High Performance Game Engine - Optimized for cache locality and minimal allocations
 * Integrates spatial indexing and batch processing for maximum performance
 * 
 * Ported from JavaScript implementation with Kotlin coroutines and TrikeShed integration
 */
class GameEngine {
    
    private val gameState = GameState()
    private val entityManager = TrikeShedEntityManager()
    private val battleJournal = BattleJournal()
    private val performanceMonitor = PerformanceMonitor()
    private val battleLogger = BattleLogger()
    
    private var simulationSpeed = 1.0
    private var isRunning = false
    private var isPaused = false
    private var simulationJob: Job? = null
    
    // Spatial indexing for cache-friendly entity processing
    private val spatialGrid = SpatialGrid(GameConstants.SPATIAL_GRID_SIZE)
    
    /**
     * Initialize the game engine
     */
    suspend fun initialize() {
        battleLogger.log("GameEngine initializing...")
        initializeGame()
        battleLogger.log("GameEngine initialized successfully")
    }
    
    /**
     * Start the simulation loop
     */
    suspend fun startSimulation() {
        if (isRunning) return
        
        isRunning = true
        isPaused = false
        battleLogger.log("Starting simulation with speed: $simulationSpeed")
        
        simulationJob = CoroutineScope(Dispatchers.Default).launch {
            gameLoop()
        }
    }
    
    /**
     * Pause/resume simulation
     */
    fun togglePause() {
        isPaused = !isPaused
        battleLogger.log("Simulation ${if (isPaused) "paused" else "resumed"}")
    }
    
    /**
     * Reset simulation to initial state
     */
    suspend fun resetSimulation() {
        stopSimulation()
        initializeGame()
        battleLogger.log("Simulation reset")
    }
    
    /**
     * Stop simulation
     */
    fun stopSimulation() {
        isRunning = false
        simulationJob?.cancel()
        battleLogger.log("Simulation stopped")
    }
    
    /**
     * Main game loop using Kotlin coroutines
     */
    private suspend fun gameLoop() {
        var lastTime = System.currentTimeMillis()
        
        while (isRunning) {
            val currentTime = System.currentTimeMillis()
            val deltaTime = (currentTime - lastTime) * simulationSpeed / 1000.0
            lastTime = currentTime
            
            if (!isPaused) {
                performanceMonitor.startFrame()
                
                // Update simulation in batches for cache optimization
                updateSimulation(deltaTime.toFloat())
                
                // Process AI decisions periodically
                if (currentTime % SimulationConfig.AI_DECISION_RECORDING_PERIOD == 0L) {
                    processAIDecisions()
                }
                
                performanceMonitor.endFrame()
                
                // Journal important events
                if (SimulationConfig.RECORD_AI_DECISIONS) {
                    battleJournal.recordFrame(gameState.currentFrame, deltaTime.toFloat())
                }
            }
            
            // Sleep to maintain target framerate (60 FPS)
            delay(16)
            gameState.currentFrame++
        }
    }
    
    /**
     * Update simulation with batch processing for cache optimization
     */
    private fun updateSimulation(deltaTime: Float) {
        // Update units in batches for L1 cache efficiency
        val units = entityManager.getUnits()
        val batchSize = GameConstants.BATCH_SIZE
        
        for (batchStart in 0 until units.size step batchSize) {
            val batchEnd = minOf(batchStart + batchSize, units.size)
            updateUnitBatch(batchStart, batchEnd, deltaTime)
        }
        
        // Update other entity types
        updateProjectiles(deltaTime)
        updateEffects(deltaTime)
        updateBuildings(deltaTime)
        
        // Update spatial indexing
        spatialGrid.update(entityManager)
    }
    
    /**
     * Update a batch of units for cache optimization
     */
    private fun updateUnitBatch(startIndex: Int, endIndex: Int, deltaTime: Float) {
        val units = entityManager.getUnits()
        
        for (i in startIndex until endIndex) {
            val unit = units[i]
            
            // Update unit AI and movement
            val updatedUnit = updateUnitAI(unit, deltaTime)
            
            // Update health and status effects
            val finalUnit = updateUnitStatus(updatedUnit, deltaTime)
            
            // Apply updates using immutable Series transformation
            if (finalUnit != unit) {
                entityManager.updateUnit(i) { finalUnit }
            }
        }
    }
    
    /**
     * Update individual unit AI and behavior
     */
    private fun updateUnitAI(unit: Unit, deltaTime: Float): Unit {
        // Apply movement, combat decisions, resource gathering, etc.
        // This would integrate with command hierarchy and strategic AI
        
        return unit // Placeholder - full AI implementation would go here
    }
    
    /**
     * Update unit status (health, veterancy, etc.)
     */
    private fun updateUnitStatus(unit: Unit, deltaTime: Float): Unit {
        // Apply damage over time, healing, veterancy updates, etc.
        
        return unit // Placeholder - full status update implementation would go here
    }
    
    /**
     * Update projectiles
     */
    private fun updateProjectiles(deltaTime: Float) {
        val projectiles = entityManager.getProjectiles()
        // Process projectile movement, collision detection, etc.
        // Remove expired projectiles using Series filtering
    }
    
    /**
     * Update visual effects
     */
    private fun updateEffects(deltaTime: Float) {
        // Update particle effects, explosions, etc.
        // Remove expired effects
    }
    
    /**
     * Update buildings
     */
    private fun updateBuildings(deltaTime: Float) {
        val buildings = entityManager.getBuildings()
        // Process building production, construction progress, etc.
    }
    
    /**
     * Process AI strategic decisions
     */
    private fun processAIDecisions() {
        // Integrate with strategic AI system
        // Record decisions in battle journal
        battleJournal.recordAIDecision("Strategic decision placeholder", gameState.currentFrame)
    }
    
    /**
     * Initialize game with starting units and buildings
     */
    private fun initializeGame() {
        gameState.reset()
        
        // Create initial units for both teams
        createInitialUnits()
        createInitialBuildings()
        
        battleLogger.log("Game initialized with initial units and buildings")
    }
    
    /**
     * Create initial units for both teams
     */
    private fun createInitialUnits() {
        // Blue team commander
        val blueCommander = Unit(
            type = "commander",
            position = 100f j 100f,
            health = 200f j 200f,
            team = "blue",
            authority = 10.0f,
            veterancy = 5,
            computroniumCores = 3
        )
        entityManager.addUnit(blueCommander)
        
        // Red team commander  
        val redCommander = Unit(
            type = "commander",
            position = 1900f j 1900f,
            health = 200f j 200f,
            team = "red",
            authority = 10.0f,
            veterancy = 5,
            computroniumCores = 3
        )
        entityManager.addUnit(redCommander)
        
        battleLogger.log("Created initial commanders for both teams")
    }
    
    /**
     * Create initial buildings
     */
    private fun createInitialBuildings() {
        // Blue team mass extractor
        val blueMassExtractor = Building(
            type = "massExtractor",
            position = 150f j 150f,
            health = 100f j 100f,
            team = "blue"
        )
        entityManager.addBuilding(blueMassExtractor)
        
        // Red team mass extractor
        val redMassExtractor = Building(
            type = "massExtractor", 
            position = 1850f j 1850f,
            health = 100f j 100f,
            team = "red"
        )
        entityManager.addBuilding(redMassExtractor)
        
        battleLogger.log("Created initial resource extractors")
    }
}

/**
 * Game state management
 */
data class GameState(
    var currentFrame: Long = 0,
    var gameTime: Float = 0f,
    var isGameOver: Boolean = false,
    var winner: String? = null
) {
    fun reset() {
        currentFrame = 0
        gameTime = 0f
        isGameOver = false
        winner = null
    }
}

/**
 * Spatial grid for cache-friendly entity queries
 */
class SpatialGrid(private val gridSize: Int) {
    private val cellSize = GameConstants.WORLD_SIZE / gridSize
    private val grid = Array(gridSize) { Array(gridSize) { mutableListOf<Int>() } }
    
    fun update(entityManager: TrikeShedEntityManager) {
        // Clear grid
        grid.forEach { row -> row.forEach { it.clear() } }
        
        // Add units to spatial grid
        val units = entityManager.getUnits()
        for (i in 0 until units.size) {
            val unit = units[i]
            val gridX = (unit.position.a / cellSize).toInt().coerceIn(0, gridSize - 1)
            val gridY = (unit.position.b / cellSize).toInt().coerceIn(0, gridSize - 1)
            grid[gridX][gridY].add(i)
        }
    }
    
    fun getEntitiesInRadius(x: Float, y: Float, radius: Float): List<Int> {
        val result = mutableListOf<Int>()
        val gridRadius = (radius / cellSize).toInt() + 1
        val centerX = (x / cellSize).toInt()
        val centerY = (y / cellSize).toInt()
        
        for (gx in (centerX - gridRadius)..(centerX + gridRadius)) {
            for (gy in (centerY - gridRadius)..(centerY + gridRadius)) {
                if (gx in 0 until gridSize && gy in 0 until gridSize) {
                    result.addAll(grid[gx][gy])
                }
            }
        }
        
        return result
    }
}

/**
 * Performance monitoring
 */
class PerformanceMonitor {
    private var frameStartTime = 0L
    private var frameCount = 0
    private var totalFrameTime = 0L
    
    fun startFrame() {
        frameStartTime = System.currentTimeMillis()
    }
    
    fun endFrame() {
        val frameTime = System.currentTimeMillis() - frameStartTime
        totalFrameTime += frameTime
        frameCount++
        
        if (frameCount % 60 == 0) {
            val avgFrameTime = totalFrameTime.toDouble() / frameCount
            println("Average frame time: ${avgFrameTime}ms")
        }
    }
}

/**
 * Battle journal for replay and analysis
 */
class BattleJournal {
    private val events = mutableListOf<BattleEvent>()
    
    fun recordFrame(frame: Long, deltaTime: Float) {
        events.add(BattleEvent.FrameUpdate(frame, deltaTime))
    }
    
    fun recordAIDecision(decision: String, frame: Long) {
        events.add(BattleEvent.AIDecision(decision, frame))
    }
    
    fun getEvents(): List<BattleEvent> = events.toList()
}

/**
 * Battle event types for journaling
 */
sealed class BattleEvent {
    data class FrameUpdate(val frame: Long, val deltaTime: Float) : BattleEvent()
    data class AIDecision(val decision: String, val frame: Long) : BattleEvent()
    data class UnitCreated(val unitId: Int, val type: String, val frame: Long) : BattleEvent()
    data class UnitDestroyed(val unitId: Int, val frame: Long) : BattleEvent()
}

/**
 * Battle logging
 */
class BattleLogger {
    fun log(message: String) {
        if (SimulationConfig.LOG_SIMULATION_EVENTS) {
            println("[GameEngine] $message")
        }
    }
}
