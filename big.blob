```kotlin
package borg.trikeshed.qol

import borg.trikeshed.lib.j
import kotlin.experimental.ExperimentalUnsignedTypes

@OptIn(kotlin.ExperimentalUnsignedTypes::class)
object QualityOfLife {
    /**
     * Zero/Non-Zero scanning utilities - fundamental boolean checks
     */
    object ZeroScan {
        /**
         * Extension property for zero check
         */
        val Int.z: Boolean get() = this == 0

        /**
         * Extension property for non-zero check
         */
        val Int.nz: Boolean get() = this != 0
    }

    /**
     * Null/Non-Null scanning utilities - fundamental boolean checks
     */
    object NullScan {
        /**
         * Extension property for null check
         */
        val Any?.n: Boolean get() = this == null

        /**
         * Extension property for non-null check
         */
        val Any?.nn: Boolean get() = this != null
    }

    /**
     * Boolean logic utilities
     */
    object BooleanLogic {
        /**
         * Extension property for logical OR
         */
        infix fun Boolean.or(other: Boolean): Boolean = this || other

        /**
         * Extension property for logical AND
         */
        infix fun Boolean.and(other: Boolean): Boolean = this && other

        /**
         * Extension property for logical XOR
         */
        infix fun Boolean.xor(other: Boolean): Boolean = this != other
    }

    /**
     * Type checking utilities
     */
    object TypeCheck {
        /**
         * Extension property for type check
         */
        inline fun <reified T> Any?.isA(): Boolean = this is T
    }

    /**
     * Debugging utilities
     */
    object Debug {
        /**
         * Extension property for debug print
         */
        fun <T> T.d(message: String = ""): T {
            println("DEBUG: $message $this")
            return this
        }
    }

    /**
     * Mapping utilities
     */
    object MapUtils {
        /**
         * Extension property for map
         */
        fun <K, V, R> Map<K, V>.m(transform: (Map.Entry<K, V>) -> R): List<R> = this.map(transform)
    }

    /**
     * List utilities
     */
    object ListUtils {
        /**
         * Extension property for list
         */
        fun <T, R> List<T>.m(transform: (T) -> R): List<R> = this.map(transform)
    }

    /**
     * Tuple utilities
     */
    object TupleUtils {
        /**
         * Extension property for tuple
         */
        fun <A, B> Pair<A, B>.tuple(): Pair<A, B> = this
    }

    /**
     * String utilities
     */
    object StringUtils {
        /**
         * Extension property for string
         */
        fun String.toSeries(): borg.trikeshed.lib.Series<Char> = length j { this[it] }
    }
}
