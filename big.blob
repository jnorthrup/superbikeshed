import borg.trikeshed.platform.SelectionKey

interface UnaryAsyncReaction {
    fun onRead(key: SelectionKey): AsyncReaction? = null
    fun onWrite(key: SelectionKey): AsyncReaction? = null
    fun onConnect(key: SelectionKey): AsyncReaction? = null
