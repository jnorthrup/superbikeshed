package borg.trikeshed.ljson

import java.io.ByteArrayInputStream
import java.util.zip.Inflater

actual suspend fun zlibDecompressWithDictionary(
    compressedData: ByteArray,
    dictionary: ByteArray,
    bitOffset: Int,
    skipBytes: Long,
    readBytes: Long
): ByteArray {
    val inflater = Inflater(true) // true for raw deflate
    inflater.setInput(compressedData)
    inflater.setDictionary(dictionary)

    // Skip bytes by inflating and discarding
    var skipped = 0L
    val skipBuffer = ByteArray(4096)
    while (skipped < skipBytes) {
        val n = inflater.inflate(skipBuffer, 0, minOf(skipBuffer.size, (skipBytes - skipped).toInt()))
        if (n == 0) break // No more data or end of stream
        skipped += n
    }

    val outputStream = ByteArrayOutputStream()
    val buffer = ByteArray(4096)
    var totalRead = 0L

    while (totalRead < readBytes && !inflater.finished()) {
        val n = inflater.inflate(buffer, 0, minOf(buffer.size, (readBytes - totalRead).toInt()))
        if (n == 0) break
        outputStream.write(buffer, 0, n)
        totalRead += n
    }

    inflater.end()
    return outputStream.toByteArray()
}
