    fun accept(): SelectableChannel?
    fun bind(port: Int)
}

expect class SelectorInterface {
    fun select(timeout: Long = 0): Int
    fun selectedKeys(): Set<SelectionKey>
    fun close()

    companion object {
        fun create(): SelectorInterface
    }
}

