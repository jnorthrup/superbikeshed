#### +  
#### +actual object MathUtils {  
#### +    actual fun createBigDecimal(value: Double): BigDecimal = BigDecimal(JavaBigDecimal.valueOf(value))  
#### +    actual fun createBigDecimal(value: String): BigDecimal = BigDecimal(JavaBigDecimal(value))  
#### +    actual fun createBigDecimal(value: Int): BigDecimal = BigDecimal(JavaBigDecimal.valueOf(value.toLong()))  
#### +    actual fun createBigDecimal(value: Long): BigDecimal = BigDecimal(JavaBigDecimal.valueOf(value))  
#### +  
#### +    actual fun BigDecimal.scale(): Int = this.delegate.scale()  
#### +    actual fun BigDecimal.setScale(scale: Int, roundingMode: RoundingMode): BigDecimal =  
#### +        BigDecimal(this.delegate.setScale(scale, roundingMode.toJavaRoundingMode()))  
#### +  
#### +    actual fun BigDecimal.add(other: BigDecimal): BigDecimal =  
#### +        BigDecimal(this.delegate.add(other.delegate))  
#### +  
#### +    actual fun BigDecimal.subtract(other: BigDecimal): BigDecimal =  
#### +        BigDecimal(this.delegate.subtract(other.delegate))  
#### +  
#### +    actual fun BigDecimal.multiply(other: BigDecimal): BigDecimal =  
#### +        BigDecimal(this.delegate.multiply(other.delegate))  
#### +  
#### +    actual fun BigDecimal.divide(other: BigDecimal, scale: Int, roundingMode: RoundingMode): BigDecimal =  
#### +        BigDecimal(this.delegate.divide(other.delegate, scale, roundingMode.toJavaRoundingMode()))  
#### +  
#### +    actual fun BigDecimal.pow(n: Int): BigDecimal =  
#### +        BigDecimal(this.delegate.pow(n))  
#### +  
#### +    // Note: sqrt is not standard in Java's BigDecimal. This requires a custom implementation or a library.  
#### +    // For simplicity, we'll use a double-based calculation which may lose precision.  
#### +    actual fun BigDecimal.sqrt(scale: Int, roundingMode: RoundingMode): BigDecimal {  
#### +        val mc = MathContext(scale, roundingMode.toJavaRoundingMode())  
#### +        return BigDecimal(this.delegate.sqrt(mc))  
#### +    }  
#### +  
#### +    actual fun BigDecimal.compareTo(other: BigDecimal): Int =  
#### +        this.delegate.compareTo(other.delegate)  
#### +  
#### +    actual val BigDecimal.isZero: Boolean get() = this.delegate.compareTo(JavaBigDecimal.ZERO) == 0  
#### +    actual val BigDecimal.isPositive: Boolean get() = this.delegate.compareTo(JavaBigDecimal.ZERO) > 0  
#### +    actual val BigDecimal.isNegative: Boolean get() = this.delegate.compareTo(JavaBigDecimal.ZERO) < 0  
#### +  
#### +    actual fun BigDecimal.abs(): BigDecimal = BigDecimal(this.delegate.abs())  
#### +    actual fun BigDecimal.negate(): BigDecimal = BigDecimal(this.delegate.negate())  
#### +  
#### +    actual fun min(a: BigDecimal, b: BigDecimal): BigDecimal =  
#### +        BigDecimal(a.delegate.min(b.delegate))  
#### +  
#### +    actual fun max(a: BigDecimal, b: BigDecimal): BigDecimal =  
#### +        BigDecimal(a.delegate.max(b.delegate))  
#### +      
#### +    actual fun BigDecimal.toLong(): Long = this.delegate.toLong()  
#### +  
#### +    actual val ZERO: BigDecimal = BigDecimal(JavaBigDecimal.ZERO)  
#### +    actual val ONE: BigDecimal = BigDecimal(JavaBigDecimal.ONE)  
#### +    actual val TWO: BigDecimal = BigDecimal(JavaBigDecimal.valueOf(2))  
#### +    actual val TEN: BigDecimal = BigDecimal(JavaBigDecimal.TEN)  
#### +    actual val HUNDRED: BigDecimal = BigDecimal(JavaBigDecimal.valueOf(100))  
#### +}  
#### +  
#### +actual enum class RoundingMode {  
#### +    UP,  
#### +    DOWN,  
#### +    CEILING,  
#### +    FLOOR,  
#### +    HALF_UP,  
#### +    HALF_DOWN,  
#### +    HALF_EVEN,  
#### +    UNNECESSARY;  
#### +  
#### +    fun toJavaRoundingMode(): JavaRoundingMode = when (this) {  
#### +        UP -> JavaRoundingMode.UP  
#### +        DOWN -> JavaRoundingMode.DOWN  
#### +        CEILING -> JavaRoundingMode.CEILING  
#### +        FLOOR -> JavaRoundingMode.FLOOR  
#### +        HALF_UP -> JavaRoundingMode.HALF_UP  
#### +        HALF_DOWN -> JavaRoundingMode.HALF_DOWN  
#### +        HALF_EVEN -> JavaRoundingMode.HALF_EVEN  
#### +        UNNECESSARY -> JavaRoundingMode.UNNECESSARY  
#### +    }  
#### +}  
#### +  
#### +actual class BigDecimal(val delegate: JavaBigDecimal) {  
#### +    override fun toString(): String = delegate.toPlainString()  
#### +    override fun equals(other: Any?): Boolean = other is BigDecimal && delegate.compareTo(other.delegate) == 0  
#### +    override fun hashCode(): Int = delegate.hashCode()  
#### +}  
