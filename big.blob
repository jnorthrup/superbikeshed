package borg.trikeshed.services

import borg.trikeshed.lib.Join
import borg.trikeshed.lib.Series
import borg.trikeshed.lib.toByteArray
import borg.trikeshed.lib.toSeries
import borg.trikeshed.parse.json.JsonParser
import borg.trikeshed.qol.left
import borg.trikeshed.qol.right
import borg.trikeshed.qol.tuple

class CouchRequestFactoryService(
    // private val couchClient: CouchClient, // Stubbed out
    // private val dbName: DatabaseName // Stubbed out
) : RequestFactoryService {
    private val json = JsonParser // Assuming JsonParser is an object

    override suspend fun <T : Any> createDocument(doc: T, id: String?): Either<String, Pair<String, String>> {
        val response = couchClient.createDocument(dbName, doc, id)
        return handleCreateResponse(response)
    }

    private fun <T : Any> handleCreateResponse(response: Series<Byte>): Either<String, Pair<String, String>> {
        val responseString = response.play.toByteArray().decodeToString()
        val parsed = json.reify(responseString.toSeries()) as? Map<*, *>
        return if (parsed?.get("ok") == true) {
            (parsed["id"] as String to parsed["rev"] as String).right()
        } else {
            "Failed to create document".left()
        }
    }

    override suspend fun <T : Any> getDocument(id: String): Either<String, T> {
        val response = couchClient.getDocument(dbName, id)
        return handleGetResponse(response)
    }

    private fun <T : Any> handleGetResponse(response: Series<Byte>): Either<String, T> {
        val responseString = response.play.toByteArray().decodeToString()
        val parsed = json.reify(responseString.toSeries()) as? T // This cast is unsafe
        return parsed?.right() ?: "Failed to parse document".left()
    }

    override suspend fun <T : Any> updateDocument(id: String, rev: String, doc: T): Either<String, String> {
        val response = couchClient.updateDocument(dbName, id, rev, doc)
        return handleUpdateResponse(response)
    }

    private fun handleUpdateResponse(response: Series<Byte>): Either<String, String> {
        val responseString = response.play.toByteArray().decodeToString()
        val parsed = json.reify(responseString.toSeries()) as? Map<*, *>
        return if (parsed?.get("ok") == true) {
            (parsed["rev"] as String).right()
        } else {
            "Failed to update document".left()
        }
    }

    override suspend fun deleteDocument(id: String, rev: String): Either<String, Boolean> {
        val response = couchClient.deleteDocument(dbName, id, rev)
        return handleDeleteResponse(response)
    }

    private fun handleDeleteResponse(response: Series<Byte>): Either<String, Boolean> {
        val responseString = response.play.toByteArray().decodeToString()
        val parsed = json.reify(responseString.toSeries()) as? Map<*, *>
        return if (parsed?.get("ok") == true) {
            true.right()
        } else {
            "Failed to delete document".left()
        }
    }

    override suspend fun <T : Any> bulkDocs(docs: List<T>): Either<String, List<Pair<String, String>>> = TODO()

    override suspend fun process(payload: Series<Byte>): Series<Byte> = TODO()
    override fun registerServiceLocator(serviceClass: String, locator: () -> Any) = TODO()
    override fun registerMethodValidator(methodName: String, validator: (Join<Int, (Int) -> Any?>) -> Boolean) = TODO()
}

