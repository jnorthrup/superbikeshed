Kotlin wrapper class
```

class Wrapper{
    companion object {
        @JvmStatic
        fun main(args: Array<String>) {
            val script = Wrapper::class.java.classLoader.loadClass("Wrapper")
            script.getDeclaredConstructor().newInstance(args);
