#### +  
#### +/**  
#### + * Represents project coordinates that can be defined in a kscript file  
#### + * via the `@file:ProjectCoordinates(group="...", artifact="...", version="...")` annotation.  
#### + * All properties are optional.  
#### + */  
#### +data class ProjectCoordinates(  
#### +    val group: String?,  
#### +    val artifact: String?,  
#### +    val version: String?  
#### +) : ScriptAnnotation  
