package borg.trikeshed.parse.json

import borg.trikeshed.lib.Join
import borg.trikeshed.lib.Series
import borg.trikeshed.lib.Twin
import borg.trikeshed.lib.collections.Either
import borg.trikeshed.lib.j
import borg.trikeshed.qol.d
import borg.trikeshed.qol.nz
import borg.trikeshed.qol.or
import borg.trikeshed.qol.toSeries
import borg.trikeshed.qol.tuple
import borg.trikeshed.qol.z

typealias JsElement = borg.trikeshed.lib.Join<borg.trikeshed.lib.Twin<Int>, borg.trikeshed.lib.Series<Int>>
typealias JsIndex = borg.trikeshed.lib.Join<borg.trikeshed.lib.Twin<Int>, borg.trikeshed.lib.Series<Char>>
typealias JsContext = borg.trikeshed.lib.Join<JsElement, borg.trikeshed.lib.Series<Char>>

typealias JsPathElement = borg.trikeshed.lib.collections.Either<String, Int>
typealias JsPath = borg.trikeshed.lib.Join<Int, (Int) -> JsPathElement>

fun JsIndex.toSeries(): borg.trikeshed.lib.Series<Char> = b.slice(a.a..a.b)

val List<*>.toJsPath: JsPath
    get() = size j {
        when (val e = this[it!!]) {
            is String -> e.left()
            is Int -> e.right()
            else -> throw Exception("invalid path element")
        }
    }

val JsContext.segments: Iterable<JsIndex>
    get() = TODO("Implement segments logic")

private val `s_` = " \t\r\n".toSeries()

object JsonParser {
    private val `s_` = " \t\r\n".toSeries()

    fun parse(json: Series<Char>): JsContext {
        val (element, _) = parseValue(json)
        return element j json
    }

    fun reify(json: Series<Char>): Any? {
        val (element, _) = parseValue(json.trim())
        return reify(element j json)
    }
    fun reify(context: JsContext): Any? = TODO("Implement reify logic")

    private fun parseValue(json: Series<Char>): Pair<JsElement, Series<Char>> {
        return when (json[0]) {
            '{' -> parseObject(json)
            '[' -> parseArray(json)
            '"' -> TODO() //parseString(json)
            else -> parsePrimitive(json)
        }
    }

    private fun parseObject(json: Series<Char>): Pair<JsElement, Series<Char>> {
        var i = 1
        val commas = mutableListOf<Int>()
        while (i < json.size() && json[i] != '}') {
            i = json.seek(i) { it !in `s_` }
            val (key, afterKey) = TODO() //parseString(json.slice(i..json.size - 1))
            i += key.a.b + 1
            i = json.seek(i) { it !in `s_` }
            if (json[i] != ':') throw Exception("Expected ':'")
            i++ // This needs to be fixed
            i = json.seek(i) { it !in `s_` }
            val (value, afterValue) = parseValue(json.slice(i..json.size() - 1))
            i += value.a.b + 1
            i = json.seek(i) { it !in `s_` }
            if (json[i] == ',') {
                commas.add(json.size() - json.slice(i..json.size() - 1).size())
                i++
            }
        }
        return (0 j json.size() - json.slice(i..json.size() - 1).size()) j emptySeries<Int>() to json.slice(i..json.size() - 1)
    }

    private fun parseArray(json: Series<Char>): Pair<JsElement, Series<Char>> {
        var i = 1
        val commas = mutableListOf<Int>()
        while (i < json.size() && json[i] != ']') {
            i = json.seek(i) { it !in `s_` }
            val (value, afterValue) = parseValue(json.slice(i..json.size() - 1))
            i += value.a.b + 1
            i = json.seek(i) { it !in `s_` }
            if (json[i] == ',') {
                commas.add(json.size() - json.slice(i..json.size() - 1).size())
                i++
            }
        }
        return (0 j json.size() - json.slice(i..json.size() - 1).size()) j emptySeries<Int>() to json.slice(i..json.size() - 1)
    }

    private fun parsePrimitive(json: Series<Char>): Pair<JsElement, Series<Char>> {
        var i = 0
        while (i < json.size() && json[i] !in ",]} \t\r\n".toSeries()) {
            i++
        }
        return (0 j i - 1) j emptySeries<Int>() to json.slice(i..json.size() - 1)
    }

    fun Series<Char>.trim(): Series<Char> {
        var start = 0
        while (start < size() && this[start] in `s_`) start++
        var end = size - 1
        while (end >= start && this[end] in `s_`) end--
        return slice(start..end)
    }

    fun Series<Char>.seek(from: Int, predicate: (Char) -> Boolean): Int = TODO()

    fun Series<Char>.slice(range: IntRange): Series<Char> =
        (range.last - range.first + 1) j { this[range.first + it] }

}

fun <T> emptySeries(): Series<T> = 0 j { throw IndexOutOfBoundsException() }

fun JsContext.query(path: JsPath): JsContext? = TODO()

fun Series<Char>.size(): Int = this.a

private operator fun Series<Char>.contains(c: Char): Boolean {
    for (i in 0 until a) {
        if (b(i) == c) return true
    }
    return false
}
