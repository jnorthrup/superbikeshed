-export function calculateAssetScore(targetUnit) { // gameContext removed as helpers don't need it directly now
-    if (!targetUnit || typeof targetUnit.hp !== 'number' || targetUnit.hp <= 0) {
-        return 0; // Dead or invalid target
-    }
