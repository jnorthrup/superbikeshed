-        const distance = Math.sqrt((node.x - x) ** 2 + (node.y - y) ** 2);
-        return distance <= radius && !node.occupied;
-    }).sort((a, b) => {
-        const distA = Math.sqrt((a.x - x) ** 2 + (a.y - y) ** 2);
-        const distB = Math.sqrt((b.x - x) ** 2 + (b.y - y) ** 2);
-        return distA - distB;
