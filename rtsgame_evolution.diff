-            recordAIDecision(gameContext, team, 'BUILD_EXTRACTOR', { // Pass gameContext
-                type: buildingType.name,
-                position: { x: targetResource.x, y: targetResource.y },
-                resourcesAfter: gameContext.resources[team]
-            });
