-
-    equals(otherNode) {
-        return this.x === otherNode.x && this.y === otherNode.y;
-    }
-}
-
-function calculateHeuristic(nodeA, nodeB) {
-    // Manhattan distance
-    return Math.abs(nodeA.x - nodeB.x) + Math.abs(nodeA.y - nodeB.y);
