-export function calculateRelativeHealth(unit, maxHP) {
-    if (!unit || typeof unit.hp !== 'number' || maxHP <= 0) {
-        return 0; // Dead, invalid, or maxHP is zero/negative
-    }
-    return Math.max(0, Math.min(1, unit.hp / maxHP));
-}
