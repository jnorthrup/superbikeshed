#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf
# These are Windows script files and should use crlf
*.bat           text eol=crlf
# Binary files should be left untouched
*.jar           binary
superannuate/*.gz filter=lfs diff=lfs merge=lfs -text
superannuate/*.json filter=lfs diff=lfs merge=lfs -text
superannuate/*.fwf filter=lfs diff=lfs merge=lfs -text
superannuate/*.csv filter=lfs diff=lfs merge=lfs -text
superannuate/*.dat filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.pb filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.zst filter=lfs diff=lfs merge=lfs -text
